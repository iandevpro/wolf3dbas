'	ID_SD.c - Sound Manager for Wolfenstein 3D
'
' The original drove an AdLib card from a 700Hz timer interrupt (SDL_t0FastAsmService).
' In QB64:
' - the AdLib card is emulated by OPL2.BM, its output is queued with _SndRaw
' - ON TIMER calls SD_PumpAudio, which tops up the queue to SD_BUFFERSECS seconds.
'   Timer events fire between statements, so music keeps playing inside busy-wait loops
' - the 700Hz music clock is counted in generated samples, not wall clock time

$If INCLUDE_ID_SD_BM = UNDEFINED Then
    $Let INCLUDE_ID_SD_BM = 1

    '$INCLUDE: 'ID_SD.BI'
    '$INCLUDE: 'OPL2.BM'

    Sub SD_Startup ()
        If sdPipe <> 0 Then Exit Sub

        OPL2_Init
        ' SDL_DetectAdLib
        OPL2_Reset ' Zero all the registers
        OPL2_Write 1, &H20 ' Set WSE=1
        OPL2_Write 8, 0 ' Set CSM=0 & SEL=0
        ' SDL_StartAL
        OPL2_Write alEffects, 0

        sdRate = _SndRate
        sdOplStep = CLng(OPL2_RATE * 65536# / sdRate)
        sdImfAcc = 0
        sdOplAcc = 0
        sdPrevSample = 0
        sdCurSample = 0

        sdClockLast = Timer(.001)
        sdClockAcc = 0

        sdPipe = _SndOpenRaw
        sdTimer = _FreeTimer
        On Timer(sdTimer, SD_TIMERSECS) SD_PumpAudio
        Timer(sdTimer) On
    End Sub

    Sub SD_Shutdown ()
        If sdPipe = 0 Then Exit Sub

        Timer(sdTimer) Free
        SD_StopSound
        SD_MusicOff
        _SndClose sdPipe
        sdPipe = 0
    End Sub

    Sub SD_MusicOff ()
        Dim i As Integer

        sqActive = 0
        OPL2_Write alEffects, 0
        For i = 0 To sqMaxTracks - 1
            OPL2_Write alFreqH + i + 1, 0
        Next i
    End Sub

    ' QB64 can't assign _OFFSET to other types, read its bytes instead (64-bit build: 8 bytes)
    Function SDL_OffsetToLong& (value As _Offset)
        Dim m As _MEM
        m = _Mem(value)
        SDL_OffsetToLong& = _MemGet(m, m.OFFSET, _Integer64)
        _MemFree m
    End Function

    Sub SD_StartMusic (music As _MEM)
        Dim size As Long

        SD_MusicOff

        size = SDL_OffsetToLong&(music.SIZE)
        If size < 2 Then Exit Sub

        sqHackSeqLen = _MemGet(music, music.OFFSET, _Unsigned Integer)
        If sqHackSeqLen > size - 2 Then sqHackSeqLen = size - 2
        sqHackMem = music
        sqHackPtrOffset = 2 ' skip the length word
        sqHackLen = sqHackSeqLen
        sqHackTime = 0
        alTimeCount = 0
        ' SD_MusicOn
        If MusicMode = smm_AdLib Then sqActive = 1
    End Sub

    ' One 700Hz tick of the music sequencer (the music part of SDL_ALService / SDL_t0Service)
    Sub SDL_ServiceMusicTick ()
        Dim w As _Unsigned Integer

        Do While sqHackLen >= 4 And sqHackTime <= alTimeCount
            w = _MemGet(sqHackMem, sqHackMem.OFFSET + sqHackPtrOffset, _Unsigned Integer)
            sqHackTime = alTimeCount + _MemGet(sqHackMem, sqHackMem.OFFSET + sqHackPtrOffset + 2, _Unsigned Integer)
            ' low byte = register, high byte = data
            OPL2_Write w And &HFF, w \ 256
            sqHackPtrOffset = sqHackPtrOffset + 4
            sqHackLen = sqHackLen - 4
        Loop
        alTimeCount = alTimeCount + 1

        ' Loop music if we've reached the end
        If sqHackLen < 4 Then
            sqHackPtrOffset = 2
            sqHackLen = sqHackSeqLen
            alTimeCount = 0
            sqHackTime = 0
        End If
    End Sub

    ' TimeCount at 70Hz from the clock (the TIME macro of the original timer interrupt)
    Sub SDL_TimeCountService ()
        Dim now As Double

        now = Timer(.001)
        If now < sdClockLast Then sdClockLast = sdClockLast - 86400 ' past midnight
        sdClockAcc = sdClockAcc + (now - sdClockLast) * 70
        sdClockLast = now
        Do While sdClockAcc >= 1
            TimeCount = TimeCount + 1
            sdClockAcc = sdClockAcc - 1
        Loop
    End Sub

    ' Generates audio until SD_BUFFERSECS seconds are queued, called by ON TIMER
    Sub SD_PumpAudio ()
        Dim i As Long
        Dim s As Single

        If sdPipe <> 0 Then SDL_TimeCountService

        If sdPipe = 0 Or sdInPump <> 0 Or sdLock <> 0 Then Exit Sub
        sdInPump = -1

        Do While _SndRawLen(sdPipe) < SD_BUFFERSECS
            For i = 1 To 256
                sdImfAcc = sdImfAcc + IMF_RATE
                If sdImfAcc >= sdRate Then
                    sdImfAcc = sdImfAcc - sdRate
                    ' PC/AdLib effects every 5th tick (DOFX in SDL_t0FastAsmService)
                    sdCountFx = sdCountFx + 1
                    If sdCountFx >= 5 Then
                        sdCountFx = 0
                        SDL_ALSoundService
                    End If
                    If sqActive Then SDL_ServiceMusicTick
                End If

                ' Resample native OPL2 output to the sound card rate (linear interpolation)
                sdOplAcc = sdOplAcc + sdOplStep
                Do While sdOplAcc >= 65536
                    sdOplAcc = sdOplAcc - 65536
                    sdPrevSample = sdCurSample
                    sdCurSample = OPL2_Generate&
                Loop
                s = (sdPrevSample + (sdCurSample - sdPrevSample) * (sdOplAcc / 65536!)) * SD_MUSICGAIN / 32768!
                If s > 1 Then s = 1 Else If s < -1 Then s = -1
                _SndRaw s, s, sdPipe
            Next i
        Loop

        sdInPump = 0
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  Sound effects
    '//  Only the AdLib device is ported. PC speaker (sdm_PC) and digitized
    '//  sounds (DigiMap, SD_PlayDigitized) are TODO.
    '//
    '///////////////////////////////////////////////////////////////////////////

    ' #define SDL_SoundFinished() {SoundNumber = SoundPriority = 0;}
    Sub SDL_SoundFinished ()
        SoundNumber = 0
        SoundPriority = 0
    End Sub

    Sub SDL_ALStopSound ()
        alSoundOffset = 0
        OPL2_Write alFreqH + 0, 0
    End Sub

    ' Sets the instrument of channel 0 (modifiers[0] = 0, carriers[0] = 3)
    ' from the Instrument at offset inst of instMem
    Sub SDL_AlSetFXInst (instMem As _MEM, inst As Long)
        Dim m As Integer, c As Integer
        Dim i As _Offset

        m = 0
        c = 3
        i = instMem.OFFSET + inst
        OPL2_Write m + alChar, _MemGet(instMem, i + 0, _Unsigned _Byte) ' mChar
        OPL2_Write m + alScale, _MemGet(instMem, i + 2, _Unsigned _Byte) ' mScale
        OPL2_Write m + alAttack, _MemGet(instMem, i + 4, _Unsigned _Byte) ' mAttack
        OPL2_Write m + alSus, _MemGet(instMem, i + 6, _Unsigned _Byte) ' mSus
        OPL2_Write m + alWave, _MemGet(instMem, i + 8, _Unsigned _Byte) ' mWave
        OPL2_Write c + alChar, _MemGet(instMem, i + 1, _Unsigned _Byte) ' cChar
        OPL2_Write c + alScale, _MemGet(instMem, i + 3, _Unsigned _Byte) ' cScale
        OPL2_Write c + alAttack, _MemGet(instMem, i + 5, _Unsigned _Byte) ' cAttack
        OPL2_Write c + alSus, _MemGet(instMem, i + 7, _Unsigned _Byte) ' cSus
        OPL2_Write c + alWave, _MemGet(instMem, i + 9, _Unsigned _Byte) ' cWave

        ' Note: Switch commenting on these lines for old MUSE compatibility
        ' alOut(alFeedCon,inst->nConn);
        OPL2_Write alFeedCon, 0
    End Sub

    ' SDL_AlSetFXInst(&alZeroInst)
    Sub SDL_AlSetZeroInst ()
        Dim m As Integer, c As Integer

        m = 0
        c = 3
        OPL2_Write m + alChar, 0
        OPL2_Write m + alScale, 0
        OPL2_Write m + alAttack, 0
        OPL2_Write m + alSus, 0
        OPL2_Write m + alWave, 0
        OPL2_Write c + alChar, 0
        OPL2_Write c + alScale, 0
        OPL2_Write c + alAttack, 0
        OPL2_Write c + alSus, 0
        OPL2_Write c + alWave, 0
        OPL2_Write alFeedCon, 0
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  SDL_ALPlaySound() - Plays the specified sound on the AdLib card
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub SDL_ALPlaySound (snd As _MEM)
        SDL_ALStopSound

        sdLock = -1 ' asm cli

        alLengthLeft = _MemGet(snd, snd.OFFSET, Long)
        alBlock = ((_MemGet(snd, snd.OFFSET + SOUND_BLOCK, _Unsigned _Byte) And 7) * 4) Or &H20

        ' inst->mSus | inst->cSus
        If (_MemGet(snd, snd.OFFSET + SOUND_INST + 6, _Unsigned _Byte) Or _MemGet(snd, snd.OFFSET + SOUND_INST + 7, _Unsigned _Byte)) = 0 Then
            sdLock = 0
            Print "SDL_ALPlaySound() - Bad instrument"
            End
        End If

        SDL_AlSetZeroInst ' DEBUG
        SDL_AlSetFXInst snd, SOUND_INST

        alSoundMem = snd
        alSoundOffset = SOUND_DATA

        sdLock = 0 ' asm popf
    End Sub

    ' AdLib part of DOFX (ID_SD_A.ASM) - plays the next sample out through the AdLib card
    Sub SDL_ALSoundService ()
        Dim s As Long

        If alSoundOffset = 0 Then Exit Sub ' nil pointer - no AdLib effect going

        s = _MemGet(alSoundMem, alSoundMem.OFFSET + alSoundOffset, _Unsigned _Byte)
        If s = 0 Then
            OPL2_Write alFreqH + 0, 0
        Else
            OPL2_Write alFreqL + 0, s
            OPL2_Write alFreqH + 0, alBlock
        End If
        alSoundOffset = alSoundOffset + 1

        alLengthLeft = alLengthLeft - 1
        If alLengthLeft <= 0 Then
            alSoundOffset = 0 ' Zero the pointer
            SDL_SoundFinished ' Indicate no sound with no priority
            OPL2_Write alFreqH + 0, 0 ' Turn off the sound
        End If
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  SD_SetSoundMode() - Sets which sound hardware to use for sound effects
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function SD_SetSoundMode% (mode As Integer)
        Dim result As Integer

        SD_StopSound

        ' The emulated AdLib is always present
        Select Case mode
            Case sdm_Off
                result = TRUE
            Case sdm_PC
                ' TODO: PC speaker sounds (SDL_PCPlaySound), they stay silent for now
                SoundTableStart = STARTPCSOUNDS
                result = TRUE
            Case sdm_AdLib
                SoundTableStart = STARTADLIBSOUNDS
                result = TRUE
        End Select

        If result <> 0 And mode <> SoundMode Then
            ' SDL_ShutDevice
            If SoundMode = sdm_AdLib Then
                ' SDL_ShutAL
                OPL2_Write alEffects, 0
                OPL2_Write alFreqH + 0, 0
                SDL_AlSetZeroInst
            End If
            SoundMode = mode
            ' SDL_StartDevice
            If SoundMode = sdm_AdLib Then
                ' SDL_StartAL
                OPL2_Write alEffects, 0
                SDL_AlSetZeroInst
            End If
            SoundNumber = 0
            SoundPriority = 0
        End If

        SD_SetSoundMode% = result
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  SD_PlaySound() - plays the specified sound on the appropriate hardware
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function SD_PlaySound% (snd As Integer)
        Dim chunk As Integer
        Dim priority As Long

        SD_PlaySound% = FALSE
        ' TODO: positioned digitized sounds (nextsoundpos, LeftPosition, RightPosition)

        If snd = -1 Then Exit Function
        If SoundMode = sdm_Off Then Exit Function

        chunk = SoundTableStart + snd
        If audiosegs(chunk) = 0 Then
            Print "SD_PlaySound() - Uncached sound"
            End
        End If

        ' TODO: digitized sounds (DigiMode, DigiMap) are played here first when available

        If _MemGet(audiosegMem(chunk), audiosegMem(chunk).OFFSET, Long) = 0 Then
            Print "SD_PlaySound() - Zero length sound"
            End
        End If
        priority = _MemGet(audiosegMem(chunk), audiosegMem(chunk).OFFSET + SOUND_PRIORITY, _Unsigned Integer)
        If priority < SoundPriority Then Exit Function

        Select Case SoundMode
            Case sdm_PC
                ' TODO: SDL_PCPlaySound
            Case sdm_AdLib
                SDL_ALPlaySound audiosegMem(chunk)
        End Select

        SoundNumber = snd
        SoundPriority = priority
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  SD_SoundPlaying() - returns the sound number that's playing, or 0 if
    '//      no sound is playing
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function SD_SoundPlaying% ()
        Dim result As Integer

        Select Case SoundMode
            Case sdm_AdLib
                result = (alSoundOffset <> 0)
        End Select

        If result Then SD_SoundPlaying% = SoundNumber Else SD_SoundPlaying% = FALSE
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  SD_StopSound() - if a sound is playing, stops it
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub SD_StopSound ()
        Select Case SoundMode
            Case sdm_AdLib
                SDL_ALStopSound
        End Select

        SoundPositioned = FALSE

        SDL_SoundFinished
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  SD_SetMusicMode() - sets the device to use for background music
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function SD_SetMusicMode% (mode As Integer)
        Dim result As Integer

        ' SD_FadeOutMusic - DEBUG - quick hack to turn the music off (orig C)
        SD_MusicOff

        Select Case mode
            Case smm_Off
                result = TRUE
            Case smm_AdLib
                If AdLibPresent Then result = TRUE
        End Select

        If result Then MusicMode = mode
        SD_SetMusicMode% = result
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  SD_SetDigiDevice() - sets the digitized sound device
    '//  TODO: digitized sounds (VSWAP), only sds_Off is available
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub SD_SetDigiDevice (mode As Integer)
        If mode = sds_Off Then DigiMode = sds_Off
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  SD_WaitSoundDone() - waits until the current sound is done playing
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub SD_WaitSoundDone ()
        Do While SD_SoundPlaying%
            _Limit TickBase
        Loop
    End Sub

$EndIf
