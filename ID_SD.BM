'	ID_SD.c - Sound Manager for Wolfenstein 3D
'
' Per Cursor session
' ===================================================================
' ## Summary
'
' Implemented an IMF (id Music Format) music player for QB64. The original used AdLib/SoundBlaster hardware and assembler; this version provides a framework that can be extended.
'
' ### What was implemented:
'
' 1. **Music playback state variables** — Tracks sequencer state, position, timing, etc.
' 2. **`SD_StartMusic`** — Parses the IMF format from memory:
'    - Reads the MusicGroup structure (length + values array)
'    - Sets up sequencer state for playback
'    - Ready to process OPL2 register commands
' 3. **`SD_MusicOff`** — Stops music playback and resets state
' 4. **`SD_ServiceMusic`** — Processes IMF commands:
'    - Reads register/data pairs and delays from the IMF stream
'    - Advances time counter at 700Hz
'    - Loops music when it reaches the end
'    - Includes TODO markers for OPL2 emulation
'
' ### How to use:
'
' 1. Call `SD_StartMusic` with the music data pointer (already done in `StartCPMusic`)
' 2. Call `SD_ServiceMusic` regularly from your game loop (e.g., in `GameLoop` or main loop)
' 3. Call `SD_MusicOff` to stop music
'
' ### Next steps for full playback:
'
' To hear music, add OPL2 emulation. Options:
'
' 1. **OPL2 emulator library** — Integrate a library like Nuked OPL3 or similar that can be called from QB64
' 2. **Convert IMF to another format** — Pre-convert IMF files to WAV/MP3 and play with QB64's `_SNDPLAY`
' 3. **Software synthesis** — Implement a basic OPL2 emulator in QB64 (complex but authentic)
'
' The framework is in place; add the OPL2 emulation at the TODO markers in `SD_ServiceMusic` where it says `' TODO: Call OPL2 emulator here: OPL2_Write(reg, data)`.
'
' The implementation correctly parses the IMF format and processes commands at the right timing. You just need to add the audio output layer.
' ===================================================================

$If INCLUDE_ID_SD_BM = UNDEFINED Then
    $Let INCLUDE_ID_SD_BM = 1

    '$INCLUDE: 'ID_SD.BI'

    Sub SD_MusicOff
        ' Stop music playback
        sqActive = 0
        ' Note: sqHackMem.SIZE is read-only, we can't clear it directly
        ' We rely on sqActive flag and checking sqHackMem.SIZE = 0 to determine validity
        sqHackPtrOffset = 0
        sqHackLen = 0
        sqHackTime = 0
        alTimeCount = 0

        ' TODO: If using OPL2 emulator, reset all channels here
        ' For now, this stops the sequencer
    End Sub

    Sub SD_StartMusic (music As _Offset)
        Dim musicMem As _MEM
        Dim length As Integer

        ' Stop any currently playing music
        SD_MusicOff

        If music = 0 Then Exit Sub

        ' Get memory block for music data
        musicMem = _Mem(music)
        If musicMem.SIZE = 0 Then Exit Sub

        ' Read length (first word) - number of value words
        _MemGet musicMem, musicMem.OFFSET, length

        ' Store memory block and calculate relative offset to values array (skip length word)
        ' We store relative offsets (from the memory block's base) as Long values
        sqHackMem = musicMem
        sqHackBaseOffset = 2 ' Relative offset: skip the length word (2 bytes)
        sqHackPtrOffset = sqHackBaseOffset
        sqHackSeqLen = length * 2 ' Convert word count to byte count
        sqHackLen = sqHackSeqLen
        sqHackTime = 0
        alTimeCount = 0
        sqActive = 1

        lastMusicUpdateTime = Timer

        ' TODO: Initialize OPL2 emulator here if using one
        ' For now, the sequencer is set up and ready to process commands
    End Sub

    ' Service routine to process IMF music commands
    ' Should be called regularly from the game loop (e.g., in GameLoop or main loop)
    ' The original ran at 700Hz via timer interrupt, but calling from game loop works too
    Sub SD_ServiceMusic
        Dim cmdWord As Integer
        Dim delayWord As Integer
        Dim reg As _Unsigned _Byte
        Dim regData As _Unsigned _Byte
        Dim currentTime As Double
        Dim deltaTime As Double
        Dim ticksToProcess As Long

        If sqActive = 0 Then Exit Sub
        If sqHackMem.SIZE = 0 Then Exit Sub

        ' Calculate time delta since last update
        currentTime = Timer
        deltaTime = currentTime - lastMusicUpdateTime
        lastMusicUpdateTime = currentTime

        ' Convert time delta to 700Hz ticks (IMF playback rate: 700Hz)
        ' Process up to a reasonable number of ticks per call to avoid lag
        ticksToProcess = Int(deltaTime * IMF_RATE)
        If ticksToProcess > 10 Then ticksToProcess = 10 ' Limit to prevent lag spikes

        ' Advance time counter
        alTimeCount = alTimeCount + ticksToProcess

        ' Process commands that are due
        While sqHackLen >= 4 And sqHackTime <= alTimeCount
            ' Read command word: low byte = register, high byte = data
            ' sqHackPtrOffset is a relative offset (Long) from the memory block base
            ' _MemGet accepts numeric offsets which are added to mem.OFFSET automatically
            _MemGet sqHackMem, sqHackPtrOffset, cmdWord

            ' Extract register and data
            reg = cmdWord And &HFF
            regData = (cmdWord \ 256) And &HFF

            ' Read delay word (next word)
            _MemGet sqHackMem, sqHackPtrOffset + 2, delayWord

            ' Send to OPL2 emulator (or store for later processing)
            ' TODO: Call OPL2 emulator here: OPL2_Write(reg, regData)
            ' For now, we just track the commands
            ' You can add OPL2 emulation here or convert to another format

            ' Advance pointer and update state
            sqHackPtrOffset = sqHackPtrOffset + 4
            sqHackLen = sqHackLen - 4
            sqHackTime = alTimeCount + delayWord
        Wend

        ' Loop music if we've reached the end
        If sqHackLen = 0 Then
            sqHackPtrOffset = sqHackBaseOffset
            sqHackLen = sqHackSeqLen
            alTimeCount = 0
            sqHackTime = 0
        End If
    End Sub

$EndIf
