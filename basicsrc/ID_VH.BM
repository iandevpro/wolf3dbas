' ID_VH.H - #define VW_FadeOut()    VL_FadeOut(0,255,0,0,0,30);
$If INCLUDE_ID_VH_BM = UNDEFINED Then
    $Let INCLUDE_ID_VH_BM = 1

    Sub VW_FadeOut
        VL_FadeOut 0, 255, 0, 0, 0, 30
    End Sub

    ' #define VW_FadeIn()     VL_FadeIn(0,255,&gamepal,30);
    Sub VW_FadeIn
        VL_FadeIn 0, 255, gamepal(), 30
    End Sub

    ' VW_UpdateScreen copied the buffer page to the displayed page.
    ' Here everything is drawn to the Screen 13 page and shown with manual display (_Display),
    ' so half drawn frames never appear. The first call turns QB64's automatic display off
    Sub VW_UpdateScreen
        _Display
    End Sub

    '=================
    '=
    '= VWB_DrawPic
    '=
    '=================
    Sub VWB_DrawPic (x As Integer, y As Integer, chunknum As Integer)
        Dim picnum As Integer
        Dim width As Integer, height As Integer, drawx As Integer

        picnum = chunknum - STARTPICS
        drawx = x And Not 7
        width = pictable(picnum).width
        height = pictable(picnum).height
        If grsegs(chunknum) = 0 Then Exit Sub
        ' C: VW_MarkUpdateBlock (no update blocks in the port, see ID_HEADS.BI)
        VL_PlanarMemToScreen grsegsMem(chunknum), width, height, drawx, y
    End Sub

    '=================
    '=
    '= VWB_DrawTile8 (LatchDrawChar)
    '=
    '= Draws 8x8 tile number tile of the STARTTILE8 chunk (cached by LoadLatchMem):
    '= 64 bytes a tile, 4 planes of 8 rows of 2 bytes
    '=
    '=================
    Sub VWB_DrawTile8 (x As Integer, y As Integer, tile As Integer)
        Dim scr As _MEM
        Dim src As _Offset
        Dim plane As Long, r As Long, b As Long, sx As Long, sy As Long

        If grsegs(STARTTILE8) = 0 Then Exit Sub
        scr = _MemImage(0)
        src = grsegsMem(STARTTILE8).OFFSET + tile * 64
        For plane = 0 To 3
            For r = 0 To 7
                sy = y + r
                For b = 0 To 1
                    sx = x + b * 4 + plane
                    If sx >= 0 And sx < 320 And sy >= 0 And sy < 200 Then
                        _MemPut scr, scr.OFFSET + sy * 320 + sx, _MemGet(grsegsMem(STARTTILE8), src, _Unsigned _Byte) As _UNSIGNED _BYTE
                    End If
                    src = src + 1
                Next b
            Next r
        Next plane
        _MemFree scr
    End Sub

    ' #define SETFONTCOLOR(f,b) fontcolor=f;backcolor=b;
    Sub SETFONTCOLOR (f As Integer, b As Integer)
        fontcolor = f
        backcolor = b
    End Sub

    '=================
    '=
    '= VW_DrawPropString
    '=
    '= Draws a string with the current proportional font at px,py, advancing px
    '=
    '=================
    Sub VW_DrawPropString (s As String)
        Dim font As _MEM, scr As _MEM
        Dim i As Long, ch As Long, w As Long, height As Long, glyph As Long
        Dim c As Long, r As Long, sx As Long, sy As Long, startx As Long

        If grsegs(STARTFONT + fontnumber) = 0 Then Exit Sub
        font = grsegsMem(STARTFONT + fontnumber)
        height = _MemGet(font, font.OFFSET, Integer)
        bufferheight = height
        startx = px

        scr = _MemImage(0)
        For i = 1 To Len(s)
            ch = Asc(s, i)
            w = _MemGet(font, font.OFFSET + FONT_WIDTH + ch, _Unsigned _Byte)
            glyph = _MemGet(font, font.OFFSET + FONT_LOCATION + ch * 2, _Unsigned Integer)
            For c = 0 To w - 1
                sx = px
                For r = 0 To height - 1
                    If _MemGet(font, font.OFFSET + glyph + r * w + c, _Unsigned _Byte) <> 0 Then
                        sy = py + r
                        If sx >= 0 And sx < 320 And sy >= 0 And sy < 200 Then
                            _MemPut scr, scr.OFFSET + sy * 320 + sx, fontcolor As _UNSIGNED _BYTE
                        End If
                    End If
                Next r
                px = px + 1
            Next c
        Next i
        _MemFree scr

        bufferwidth = (px \ 4 - startx \ 4 + 1) * 4
    End Sub

    Sub VWB_DrawPropString (s As String)
        ' C: VW_MarkUpdateBlock (x, py, px - 1, py + bufferheight - 1) (no update blocks in the port, see ID_HEADS.BI)
        VW_DrawPropString s
    End Sub

    '=================
    '=
    '= VW_MeasurePropString
    '=
    '=================
    Sub VW_MeasurePropString (s As String, w As Integer, h As Integer)
        Dim font As _MEM
        Dim i As Long

        w = 0
        h = 0
        If grsegs(STARTFONT + fontnumber) = 0 Then Exit Sub
        font = grsegsMem(STARTFONT + fontnumber)
        h = _MemGet(font, font.OFFSET, Integer)
        For i = 1 To Len(s)
            w = w + _MemGet(font, font.OFFSET + FONT_WIDTH + Asc(s, i), _Unsigned _Byte) ' proportional width
        Next i
    End Sub

    '
    ' =============================================================================
    '                         WOLFENSTEIN STUFF
    ' =============================================================================
    '

    '=====================
    '=
    '= LatchDrawPic
    '=
    '= Latches were pictures copied into free video memory by LoadLatchMem, so they could
    '= be drawn quickly. Here they are the cached pictures; x is in 8 pixel units
    '=
    '=====================
    Sub LatchDrawPic (x As Integer, y As Integer, picnum As Integer)
        If grsegs(picnum) = 0 Then CA_CacheGrChunk picnum
        VWB_DrawPic x * 8, y, picnum
    End Sub

    '===================
    '=
    '= LoadLatchMem
    '=
    '= Caches the 8x8 tiles and the latch pictures and keeps them in memory
    '=
    '===================
    Sub LoadLatchMem ()
        Dim i As Integer

        '
        ' tile 8s
        '
        CA_CacheGrChunk STARTTILE8

        '
        ' pics
        '
        For i = LATCHPICS_LUMP_START To LATCHPICS_LUMP_END
            CA_CacheGrChunk i
        Next i
    End Sub

    ' Function to fill a rectangle with specified dimensions and color
    Sub VWB_Bar (x As Integer, y As Integer, width As Integer, height As Integer, color_bar As Integer)
        ' C: If VW_MarkUpdateBlock (x, y, x + width, y + height - 1) Then
        ' (no update blocks in the port, see ID_HEADS.BI)
        VW_Bar x, y, width, height, color_bar
    End Sub

    Sub VW_Bar (x As Integer, y As Integer, width As Integer, height As Integer, color_bar As Integer)
        ' TODO - research if it is possible to do - #define VW_Bar          VL_Bar'
        VL_Bar x, y, width, height, color_bar
    End Sub

    '=================
    '=
    '= VWB_Hlin
    '=
    '=================
    Sub VWB_Plot (x As Integer, y As Integer, color_bar As Integer)
        ' C: VW_MarkUpdateBlock (x, y, x, y) (no update blocks in the port, see ID_HEADS.BI)
        PSet (x, y), color_bar ' VL_Plot
    End Sub

    Sub VWB_Hlin (x1 As Integer, x2 As Integer, y As Integer, color_bar As Integer)
        ' C: If VW_MarkUpdateBlock (x1, y, x2, y) Then
        ' (no update blocks in the port, see ID_HEADS.BI)
        ' #define VW_Hlin(x,z,y,c)  VL_Hlin(x,y,(z)-(x)+1,c)
        VL_Hlin x1, y, x2 - x1 + 1, color_bar
    End Sub

    '=================
    '=
    '= VWB_Vlin
    '=
    '=================
    Sub VWB_Vlin (y1 As Integer, y2 As Integer, x As Integer, color_bar As Integer)
        ' C: VW_MarkUpdateBlock (x, y1, x, y2) (no update blocks in the port, see ID_HEADS.BI)
        ' #define VW_Vlin(y,z,x,c)  VL_Vlin(x,y,(z)-(y)+1,c)
        VL_Vlin x, y1, y2 - y1 + 1, color_bar
    End Sub
    '$INCLUDE:'ID_VL.BM'
$End If
