$If INCLUDE_WL_INTER_BM = UNDEFINED Then
    $Let INCLUDE_WL_INTER_BM = 1

    '=================
    '=
    '= ClearSplitVWB
    '=
    '=================
    Sub ClearSplitVWB ()
        ' memset (update,0,sizeof(update)) - no update blocks here
        WindowX = 0
        WindowY = 0
        WindowW = 320
        WindowH = 160
    End Sub
    '==========================================================================

    $If SPEAR = DEFINED Then
        $If SPEARDEMO = UNDEFINED Then
            '////////////////////////////////////////////////////////
            '//
            '// End of Spear of Destiny
            '//
            '////////////////////////////////////////////////////////

            ' A full screen picture, faded in with its own palette, until a key
            ' (C: palette, screen - QB64 keywords)
            Sub EndScreen (palchunk As Integer, screenpic As Integer)
                Dim pal(0 To 255) As Long

                CA_CacheScreen screenpic
                VW_UpdateScreen
                CA_CacheGrChunk palchunk
                VL_ChunkToPalette palchunk, pal()
                VL_FadeIn 0, 255, pal(), 30
                UNCACHEGRCHUNK palchunk
                IN_ClearKeysDown
                IN_Ack
                VW_FadeOut
            End Sub

            Sub EndSpear ()
                Dim pal(0 To 255) As Long

                EndScreen END1PALETTE, ENDSCREEN11PIC

                CA_CacheScreen ENDSCREEN3PIC
                VW_UpdateScreen
                CA_CacheGrChunk END3PALETTE
                VL_ChunkToPalette END3PALETTE, pal()
                VL_FadeIn 0, 255, pal(), 30
                UNCACHEGRCHUNK END3PALETTE
                fontnumber = 0
                fontcolor = &HD0
                WindowX = 0
                WindowW = 320
                PrintX = 0
                PrintY = 180
                US_CPrint STR_ENDGAME1 + Chr$(10)
                US_CPrint STR_ENDGAME2
                VW_UpdateScreen
                IN_StartAck
                TimeCount = 0
                Do While Not IN_CheckAck And TimeCount < 700
                    _Limit 70
                Loop

                PrintX = 0
                PrintY = 180
                VWB_Bar 0, 180, 320, 20, 0
                US_CPrint STR_ENDGAME3 + Chr$(10)
                US_CPrint STR_ENDGAME4
                VW_UpdateScreen
                IN_StartAck
                TimeCount = 0
                Do While Not IN_CheckAck And TimeCount < 700
                    _Limit 70
                Loop

                VW_FadeOut

                EndScreen END4PALETTE, ENDSCREEN4PIC
                EndScreen END5PALETTE, ENDSCREEN5PIC
                EndScreen END6PALETTE, ENDSCREEN6PIC
                EndScreen END7PALETTE, ENDSCREEN7PIC
                EndScreen END8PALETTE, ENDSCREEN8PIC
                EndScreen END9PALETTE, ENDSCREEN9PIC

                EndScreen END2PALETTE, ENDSCREEN12PIC

                MainMenu(mi_savegame).active = 0
            End Sub
        $End If
    $End If

    '==================
    '=
    '= Victory
    '=
    '==================
    Sub Victory ()
        $If SPEARDEMO = UNDEFINED Then
            Const RATIOX = 6
            Const RATIOY = 14
            Const TIMEX = 14
            Const TIMEY = 8
            Dim sec As Long
            Dim i As Integer, min As Integer, kr As Integer, sr As Integer, tr As Integer, x As Integer
            Dim tempstr As String

            $If SPEAR = DEFINED Then
                StartCPMusic XTHEEND_MUS

                CA_CacheGrChunk BJCOLLAPSE1PIC
                CA_CacheGrChunk BJCOLLAPSE2PIC
                CA_CacheGrChunk BJCOLLAPSE3PIC
                CA_CacheGrChunk BJCOLLAPSE4PIC

                VWB_Bar 0, 0, 320, 200, VIEWCOLOR
                VWB_DrawPic 124, 44, BJCOLLAPSE1PIC
                VW_UpdateScreen
                VW_FadeIn
                VL_WaitVBL 2 * 70
                VWB_DrawPic 124, 44, BJCOLLAPSE2PIC
                VW_UpdateScreen
                VL_WaitVBL 105
                VWB_DrawPic 124, 44, BJCOLLAPSE3PIC
                VW_UpdateScreen
                VL_WaitVBL 105
                VWB_DrawPic 124, 44, BJCOLLAPSE4PIC
                VW_UpdateScreen
                VL_WaitVBL 3 * 70

                UNCACHEGRCHUNK BJCOLLAPSE1PIC
                UNCACHEGRCHUNK BJCOLLAPSE2PIC
                UNCACHEGRCHUNK BJCOLLAPSE3PIC
                UNCACHEGRCHUNK BJCOLLAPSE4PIC
                VL_FadeOut 0, 255, 0, 17, 17, 5
            $End If

            StartCPMusic URAHERO_MUS
            ClearSplitVWB
            CacheLump LEVELEND_LUMP_START, LEVELEND_LUMP_END
            CA_CacheGrChunk STARTFONT

            $If SPEAR = UNDEFINED Then
                ' (not in the v1.0 data)
                $If APOGEE_1_0 = UNDEFINED Then
                    CA_CacheGrChunk C_TIMECODEPIC
                $End If
            $End If

            VWB_Bar 0, 0, 320, 200 - STATUSLINES, 127
            WritePic 18, 2, STR_YOUWIN

            WritePic TIMEX, TIMEY - 2, STR_TOTALTIME

            WritePic 12, RATIOY - 2, "averages"

            WritePic RATIOX + 8, RATIOY, STR_RATKILL
            WritePic RATIOX + 4, RATIOY + 2, STR_RATSECRET
            WritePic RATIOX, RATIOY + 4, STR_RATTREASURE

            VWB_DrawPic 8, 4, L_BJWINSPIC

            kr = 0: sr = 0: tr = 0: sec = 0
            For i = 0 To UBound(LevelRatios) ' 8 levels (Spear: 20)
                sec = sec + LevelRatios(i).time
                kr = kr + LevelRatios(i).kill
                sr = sr + LevelRatios(i).secret
                tr = tr + LevelRatios(i).treasure
            Next i

            $If SPEAR = UNDEFINED Then
                kr = kr \ 8
                sr = sr \ 8
                tr = tr \ 8
            $Else
                kr = kr \ 14
                sr = sr \ 14
                tr = tr \ 14
            $End If

            min = sec \ 60
            sec = sec Mod 60

            If min > 99 Then
                min = 99
                sec = 99
            End If

            i = TIMEX * 8 + 1
            VWB_DrawPic i, TIMEY * 8, L_NUM0PIC + (min \ 10)
            i = i + 2 * 8
            VWB_DrawPic i, TIMEY * 8, L_NUM0PIC + (min Mod 10)
            i = i + 2 * 8
            WritePic i \ 8, TIMEY, ":"
            i = i + 1 * 8
            VWB_DrawPic i, TIMEY * 8, L_NUM0PIC + (sec \ 10)
            i = i + 2 * 8
            VWB_DrawPic i, TIMEY * 8, L_NUM0PIC + (sec Mod 10)
            VW_UpdateScreen

            tempstr = ItoA$(kr)
            x = RATIOX + 24 - Len(tempstr) * 2
            WritePic x, RATIOY, tempstr

            tempstr = ItoA$(sr)
            x = RATIOX + 24 - Len(tempstr) * 2
            WritePic x, RATIOY + 2, tempstr

            tempstr = ItoA$(tr)
            x = RATIOX + 24 - Len(tempstr) * 2
            WritePic x, RATIOY + 4, tempstr

            $If SPANISH = UNDEFINED Then
                $If UPLOAD = UNDEFINED Then
                    $If SPEAR = UNDEFINED Then
                        '
                        ' TOTAL TIME VERIFICATION CODE
                        '
                        Dim c0 As Integer, c1 As Integer
                        If gamestate.difficulty >= gd_medium Then
                            VWB_DrawPic 30 * 8, TIMEY * 8, C_TIMECODEPIC
                            fontnumber = 0
                            fontcolor = READHCOLOR
                            PrintX = 30 * 8 - 3
                            PrintY = TIMEY * 8 + 8
                            PrintX = PrintX + 4
                            c0 = (((min \ 10) Xor (min Mod 10)) Xor &HA) + Asc("A")
                            c1 = (((sec \ 10) Xor (sec Mod 10)) Xor &HA) + Asc("A")
                            US_Print Chr$(c0) + Chr$(c1) + Chr$(((c0 Xor c1) + Asc("A")) And 255)
                        End If
                    $End If
                $End If
            $End If

            fontnumber = 1

            VW_UpdateScreen
            VW_FadeIn

            IN_Ack

            ' TODO: PicturePause (Keyboard[sc_P] with the "goobers" parameter)

            VW_FadeOut

            $If SPEAR = UNDEFINED Then
                $If APOGEE_1_0 = UNDEFINED Then
                    UNCACHEGRCHUNK C_TIMECODEPIC
                $End If
            $End If
            UnCacheLump LEVELEND_LUMP_START, LEVELEND_LUMP_END

            $If SPEAR = UNDEFINED Then
                EndText
            $Else
                EndSpear
            $End If
        $End If
    End Sub

    '==========================================================================

    ' C: Write (WRITE is a QB64 keyword)
    Sub WritePic (x As Integer, y As Integer, s As String)
        Dim i As Integer, ox As Integer, nx As Integer, ny As Integer
        Dim ch As Integer, c As Integer

        ox = x * 8
        nx = ox
        ny = y * 8
        For i = 1 To Len(s)
            c = Asc(s, i)
            If c = 10 Then ' '\n'
                nx = ox
                ny = ny + 16
            Else
                ch = c
                If ch >= Asc("a") Then ch = ch - (Asc("a") - Asc("A"))
                ch = ch - Asc("0")

                Select Case c
                    Case 33 ' '!'
                        VWB_DrawPic nx, ny, L_EXPOINTPIC
                        nx = nx + 8
                        _Continue

                    Case 39 ' '\''
                        ' (the v1.0 data has no L_APOSTROPHEPIC)
                        $If APOGEE_1_0 = UNDEFINED Then
                            VWB_DrawPic nx, ny, L_APOSTROPHEPIC
                        $End If
                        nx = nx + 8
                        _Continue

                    Case 32 ' ' '

                    Case &H3A ' ':'
                        VWB_DrawPic nx, ny, L_COLONPIC
                        nx = nx + 8
                        _Continue

                    Case 37 ' '%'
                        VWB_DrawPic nx, ny, L_PERCENTPIC

                    Case Else
                        ' (C read alpha[] out of range for other characters; none are used)
                        If ch >= 0 And ch <= 42 Then VWB_DrawPic nx, ny, writealpha(ch)
                End Select
                nx = nx + 16
            End If
        Next i
    End Sub

    '
    ' Breathe Mr. BJ!!!
    '
    Sub BJ_Breathe ()
        Static which As Integer, max As Integer, started As Integer

        If Not started Then max = 10: started = TRUE ' static int which=0,max=10

        If TimeCount > max Then
            which = which Xor 1
            If which Then
                VWB_DrawPic 0, 16, L_GUY2PIC
            Else
                VWB_DrawPic 0, 16, L_GUYPIC
            End If
            VW_UpdateScreen
            TimeCount = 0
            max = 35
        End If
        _Limit 1000 ' the callers spin on it (port: don't use a whole CPU core)
    End Sub

    ' while(SD_SoundPlaying()) BJ_Breathe();
    Sub BJ_BreatheWhileSound ()
        Do While SD_SoundPlaying
            BJ_Breathe
        Loop
    End Sub

    ' The number as itoa / ltoa writes it
    Function ItoA$ (n As Long)
        ItoA$ = LTrim$(Str$(n))
    End Function

    ' The end of a ratio count: the 100% bonus, the "no bonus" sound or the end sound
    Sub RatioEnd (ratio As Integer, bonus As Long)
        Dim played As Integer, x As Integer, tempstr As String

        If ratio = 100 Then
            VL_WaitVBL VBLWAIT ' VW_WaitVBL
            SD_StopSound
            bonus = bonus + PERCENT100AMT
            tempstr = ItoA$(bonus)
            x = (RATIOXX - 1) - Len(tempstr) * 2
            WritePic x, 7, tempstr
            VW_UpdateScreen
            played = SD_PlaySound(PERCENT100SND)
        ElseIf ratio = 0 Then
            VL_WaitVBL VBLWAIT ' VW_WaitVBL
            SD_StopSound
            played = SD_PlaySound(NOBONUSSND)
        Else
            played = SD_PlaySound(ENDBONUS2SND)
        End If

        VW_UpdateScreen
        BJ_BreatheWhileSound
    End Sub

    ' One ratio counting up from 0 at row y: TRUE when a key cut it short (C: goto done)
    Function RatioCount% (ratio As Integer, y As Integer, extrabreathe As Integer)
        Dim i As Integer, x As Integer, played As Integer, tempstr As String

        RatioCount% = FALSE
        For i = 0 To ratio
            tempstr = ItoA$(i)
            x = RATIOXX - Len(tempstr) * 2
            WritePic x, y, tempstr
            If i Mod 10 = 0 Then played = SD_PlaySound(ENDBONUS1SND)
            VW_UpdateScreen
            BJ_BreatheWhileSound
            If extrabreathe Then BJ_Breathe

            If IN_CheckAck Then
                RatioCount% = TRUE
                Exit Function
            End If
        Next i
    End Function

    '==================
    '=
    '= LevelCompleted
    '=
    '= Entered with the screen faded out
    '= Still in split screen mode with the status bar
    '=
    '= Exit with the screen faded out
    '=
    '==================
    Sub LevelCompleted ()
        Dim x As Integer, i As Integer, min As Integer, sec As Long, kr As Integer, sr As Integer, tr As Integer
        Dim tempstr As String, played As Integer
        Dim bonus As Long, timeleft As Long, par As Integer

        timeleft = 0

        CacheLump LEVELEND_LUMP_START, LEVELEND_LUMP_END
        ClearSplitVWB ' set up for double buffering in split screen
        VWB_Bar 0, 0, 320, 200 - STATUSLINES, 127
        StartCPMusic ENDLEVEL_MUS

        '
        ' do the intermission
        '
        IN_ClearKeysDown
        IN_StartAck

        VWB_DrawPic 0, 16, L_GUYPIC

        If LevelCompletedNormal Then
            $If SPANISH = DEFINED Then
                    WritePic 14, 2, "piso" + Chr$(10) + "completado"
            $Else
                WritePic 14, 2, "floor" + Chr$(10) + "completed"
            $End If

            WritePic 14, 7, STR_BONUS + "     0"
            WritePic 16, 10, STR_TIME
            WritePic 16, 12, STR_PAR

            $If SPANISH = DEFINED Then
                    WritePic 11, 14, STR_RAT2KILL
                    WritePic 11, 16, STR_RAT2SECRET
                    WritePic 11, 18, STR_RAT2TREASURE
            $Else
                WritePic 9, 14, STR_RAT2KILL
                WritePic 5, 16, STR_RAT2SECRET
                WritePic 1, 18, STR_RAT2TREASURE
            $End If

            WritePic 26, 2, ItoA$(gamestate.mapon + 1)

            par = gamestate.episode * 10 + mapon
            $If SPANISH = DEFINED Then
                    WritePic 30, 12, partimestr(par)
            $Else
                WritePic 26, 12, partimestr(par)
            $End If

            '
            ' PRINT TIME
            '
            sec = gamestate.TimeCount \ 70

            If sec > 99 * 60 Then sec = 99 * 60 ' 99 minutes max

            ' float math: the par times are multiples of 1/4 minute, so exact
            If gamestate.TimeCount < partime(par) * 4200 Then timeleft = Fix((partime(par) * 4200) / 70 - sec)

            min = sec \ 60
            sec = sec Mod 60

            $If SPANISH = DEFINED Then
                    i = 30 * 8
            $Else
                i = 26 * 8
            $End If
            VWB_DrawPic i, 10 * 8, L_NUM0PIC + (min \ 10)
            i = i + 2 * 8
            VWB_DrawPic i, 10 * 8, L_NUM0PIC + (min Mod 10)
            i = i + 2 * 8
            WritePic i \ 8, 10, ":"
            i = i + 1 * 8
            VWB_DrawPic i, 10 * 8, L_NUM0PIC + (sec \ 10)
            i = i + 2 * 8
            VWB_DrawPic i, 10 * 8, L_NUM0PIC + (sec Mod 10)

            VW_UpdateScreen
            VW_FadeIn

            '
            ' FIGURE RATIOS OUT BEFOREHAND
            '
            kr = 0: sr = 0: tr = 0
            If gamestate.killtotal Then kr = (gamestate.killcount * 100) \ gamestate.killtotal
            If gamestate.secrettotal Then sr = (gamestate.secretcount * 100) \ gamestate.secrettotal
            If gamestate.treasuretotal Then tr = (gamestate.treasurecount * 100) \ gamestate.treasuretotal

            Do ' (one pass; Exit Do = goto done)
                '
                ' PRINT TIME BONUS
                '
                bonus = timeleft * PAR_AMOUNT
                If bonus Then
                    For i = 0 To timeleft
                        tempstr = ItoA$(CLng(i) * PAR_AMOUNT)
                        x = 36 - Len(tempstr) * 2
                        WritePic x, 7, tempstr
                        If i Mod (PAR_AMOUNT \ 10) = 0 Then played = SD_PlaySound(ENDBONUS1SND)
                        VW_UpdateScreen
                        BJ_BreatheWhileSound
                        If IN_CheckAck Then Exit Do
                    Next i

                    VW_UpdateScreen
                    played = SD_PlaySound(ENDBONUS2SND)
                    BJ_BreatheWhileSound
                End If

                '
                ' KILL RATIO
                '
                If RatioCount(kr, 14, FALSE) Then Exit Do
                RatioEnd kr, bonus

                '
                ' SECRET RATIO
                '
                If RatioCount(sr, 16, TRUE) Then Exit Do
                RatioEnd sr, bonus

                '
                ' TREASURE RATIO
                '
                If RatioCount(tr, 18, FALSE) Then Exit Do
                RatioEnd tr, bonus
            Loop While FALSE

            '
            ' JUMP STRAIGHT HERE IF KEY PRESSED
            '
            ' done:

            tempstr = ItoA$(kr)
            x = RATIOXX - Len(tempstr) * 2
            WritePic x, 14, tempstr

            tempstr = ItoA$(sr)
            x = RATIOXX - Len(tempstr) * 2
            WritePic x, 16, tempstr

            tempstr = ItoA$(tr)
            x = RATIOXX - Len(tempstr) * 2
            WritePic x, 18, tempstr

            bonus = timeleft * PAR_AMOUNT - PERCENT100AMT * (kr = 100) - PERCENT100AMT * (sr = 100) - PERCENT100AMT * (tr = 100) ' (true is -1 here)

            GivePoints bonus
            tempstr = ItoA$(bonus)
            x = 36 - Len(tempstr) * 2
            WritePic x, 7, tempstr

            '
            ' SAVE RATIO INFORMATION FOR ENDGAME
            '
            LevelRatios(mapon).kill = kr
            LevelRatios(mapon).secret = sr
            LevelRatios(mapon).treasure = tr
            LevelRatios(mapon).time = min * 60 + sec
        Else
            LevelCompletedSecret

            WritePic 10, 16, "15000 bonus!"

            VW_UpdateScreen
            VW_FadeIn

            GivePoints 15000
        End If

        DrawScore
        VW_UpdateScreen

        TimeCount = 0
        IN_StartAck
        Do While Not IN_CheckAck
            BJ_Breathe
        Loop

        '
        ' done
        '
        $If SPEARDEMO = DEFINED Then
            If gamestate.mapon = 1 Then
                played = SD_PlaySound(BONUS1UPSND)

                CA_CacheGrChunk STARTFONT + 1
                Message "This concludes your demo" + Chr$(10) + "of Spear of Destiny! Now," + Chr$(10) + "go to your local software" + Chr$(10) + "store and buy it!"
                UNCACHEGRCHUNK STARTFONT + 1

                IN_ClearKeysDown
                IN_Ack
            End If
        $End If
        ' TODO: PicturePause (Keyboard[sc_P] with the "goobers" parameter)

        VW_FadeOut
        DrawPlayBorder ' (the original drew it into all three screen pages)

        UnCacheLump LEVELEND_LUMP_START, LEVELEND_LUMP_END
    End Sub

    ' The floor completed screen (not a boss or secret level)
    Function LevelCompletedNormal% ()
        $If SPEAR = UNDEFINED Then
            LevelCompletedNormal% = (mapon < 8)
        $Else
            LevelCompletedNormal% = (mapon <> 4 And mapon <> 9 And mapon <> 15 And mapon < 17)
        $End If
    End Function

    ' The boss / secret level title of LevelCompleted
    Sub LevelCompletedSecret ()
        $If SPEAR = DEFINED Then
            $If SPEARDEMO = UNDEFINED Then
                Select Case mapon
                    Case 4: WritePic 14, 4, " trans" + Chr$(10) + " grosse" + Chr$(10) + STR_DEFEATED
                    Case 9: WritePic 14, 4, "barnacle" + Chr$(10) + "wilhelm" + Chr$(10) + STR_DEFEATED
                    Case 15: WritePic 14, 4, "ubermutant" + Chr$(10) + STR_DEFEATED
                    Case 17: WritePic 14, 4, " death" + Chr$(10) + " knight" + Chr$(10) + STR_DEFEATED
                    Case 18: WritePic 13, 4, "secret tunnel" + Chr$(10) + "    area" + Chr$(10) + "  completed!"
                    Case 19: WritePic 13, 4, "secret castle" + Chr$(10) + "    area" + Chr$(10) + "  completed!"
                End Select
            $End If
        $Else
            WritePic 14, 4, "secret floor" + Chr$(10) + " completed!"
        $End If
    End Sub


    '=================
    '=
    '= PreloadGraphics
    '=
    '= Fill the cache up
    '=
    '=================
    Function PreloadUpdate% (current As Long, total As Long)
        Dim w As Long

        w = WindowW - 10
        VWB_Bar WindowX + 5, WindowY + WindowH - 3, w, 2, 0 ' BLACK
        w = (w * current) \ total
        If w Then
            VWB_Bar WindowX + 5, WindowY + WindowH - 3, w, 2, &H37 ' SECONDCOLOR
            VWB_Bar WindowX + 5, WindowY + WindowH - 3, w - 1, 1, &H32
        End If
        VW_UpdateScreen
        PreloadUpdate% = FALSE
    End Function

    Sub PreloadGraphics ()
        Dim result As Integer

        DrawLevel
        ClearSplitVWB ' set up for double buffering in split screen

        VWB_Bar 0, 0, 320, 200 - STATUSLINES, 127

        LatchDrawPic 20 - 14, 80 - 3 * 8, GETPSYCHEDPIC

        WindowX = 160 - 14 * 8
        WindowY = 80 - 3 * 8
        WindowW = 28 * 8
        WindowH = 48
        VW_UpdateScreen
        VW_FadeIn

        PM_Preload
        result = IN_UserInput(70)
        VW_FadeOut

        DrawPlayBorder
        VW_UpdateScreen
    End Sub

    Sub NonShareware
        VW_FadeOut

        ClearMScreen
        DrawStripes 10

        CA_CacheGrChunk STARTFONT + 1
        fontnumber = 1

        SETFONTCOLOR READHCOLOR, BKGDCOLOR
        PrintX = 110
        PrintY = 15

        $If SPANISH = DEFINED Then
                US_Print "Atencion"
        $Else
            US_Print "Attention"
        $End If

        SETFONTCOLOR HIGHLIGHT, BKGDCOLOR
        WindowX = 40
        PrintX = 40
        PrintY = 60
        $If SPANISH = DEFINED Then
                US_Print "Este juego NO es gratis y" + Chr$(10)
                US_Print "NO es Shareware; favor de" + Chr$(10)
                US_Print "no distribuirlo." + Chr$(10) + Chr$(10)
        $Else
            US_Print "This game is NOT shareware." + Chr$(10)
            US_Print "Please do not distribute it." + Chr$(10)
            US_Print "Thanks." + Chr$(10) + Chr$(10)
        $End If
        US_Print "        Id Software" + Chr$(10)

        VW_UpdateScreen
        VW_FadeIn
        IN_Ack
    End Sub

    $If JAPAN = UNDEFINED Then
        '==================
        '=
        '= PG13
        '=
        '==================
        Sub PG13
            Dim ack As Integer

            VW_FadeOut
            VWB_Bar 0, 0, 320, 200, &H82 ' background

            CA_CacheGrChunk PG13PIC
            VWB_DrawPic 216, 110, PG13PIC
            VW_UpdateScreen

            UNCACHEGRCHUNK PG13PIC

            VW_FadeIn
            ack = IN_UserInput(TickBase * 7)

            VW_FadeOut
        End Sub
    $End If

    ' ultoa + fixed-width digits: font 0 has same-width digit glyphs at 129..138
    Function HighScoreNumber$ (n As Long)
        Dim buffer As String
        Dim i As Long

        buffer = LTrim$(Str$(n))
        $If SPEAR = UNDEFINED Then
            For i = 1 To Len(buffer)
                Mid$(buffer, i, 1) = Chr$(Asc(buffer, i) + (129 - 48)) ' Used fixed-width numbers (129...)
            Next i
        $End If
        HighScoreNumber$ = buffer
    End Function

    '==================
    '=
    '= DrawHighScores
    '=
    '==================
    Sub DrawHighScores
        Dim i As Integer, w As Integer, h As Integer
        Dim buffer As String

        $If SPEAR = UNDEFINED Then
            CA_CacheGrChunk HIGHSCORESPIC
            CA_CacheGrChunk STARTFONT
            $If APOGEE_1_0 = UNDEFINED Then
                CA_CacheGrChunk C_LEVELPIC
                CA_CacheGrChunk C_SCOREPIC
                CA_CacheGrChunk C_NAMEPIC
            $End If

            ClearMScreen
            DrawStripes 10

            VWB_DrawPic 48, 0, HIGHSCORESPIC
            UNCACHEGRCHUNK HIGHSCORESPIC

            ' (the v1.0 data has no column headings)
            $If APOGEE_1_0 = UNDEFINED Then
                VWB_DrawPic 4 * 8, 68, C_NAMEPIC
                VWB_DrawPic 20 * 8, 68, C_LEVELPIC
                VWB_DrawPic 28 * 8, 68, C_SCOREPIC
            $End If
            fontnumber = 0

            SETFONTCOLOR 15, &H29
        $Else
            CacheLump BACKDROP_LUMP_START, BACKDROP_LUMP_END
            ClearMScreen
            DrawStripes 10
            UnCacheLump BACKDROP_LUMP_START, BACKDROP_LUMP_END

            CacheLump HIGHSCORES_LUMP_START, HIGHSCORES_LUMP_END
            CA_CacheGrChunk STARTFONT + 1
            VWB_DrawPic 0, 0, HIGHSCORESPIC

            fontnumber = 1
            SETFONTCOLOR HIGHLIGHT, &H29
        $End If

        For i = 0 To MaxScores - 1
            PrintY = 76 + (16 * i)

            '
            ' name
            '
            $If SPEAR = UNDEFINED Then
                PrintX = 4 * 8
            $Else
                PrintX = 16
            $End If
            US_Print US_CString$(Scores(i).name)

            '
            ' level
            '
            buffer = HighScoreNumber$(Scores(i).completed)
            VW_MeasurePropString buffer, w, h
            $If SPEAR = UNDEFINED Then
                PrintX = (22 * 8) - w
            $Else
                PrintX = 194 - w
            $End If

            $If UPLOAD = UNDEFINED Then
                $If SPEAR = UNDEFINED Then
                    PrintX = PrintX - 6
                    US_Print "E"
                    US_Print LTrim$(Str$(Scores(i).episode + 1))
                    US_Print "/L"
                $End If
            $End If

            $If SPEAR = DEFINED Then
                If Scores(i).completed = 21 Then
                    VWB_DrawPic PrintX + 8, PrintY - 1, C_WONSPEARPIC
                Else
                    US_Print buffer
                End If
            $Else
                US_Print buffer
            $End If

            '
            ' score
            '
            buffer = HighScoreNumber$(Scores(i).score)
            VW_MeasurePropString buffer, w, h
            $If SPEAR = UNDEFINED Then
                PrintX = (34 * 8) - 8 - w
            $Else
                PrintX = 292 - w
            $End If
            US_Print buffer
        Next i

        VW_UpdateScreen

        $If SPEAR = DEFINED Then
            UnCacheLump HIGHSCORES_LUMP_START, HIGHSCORES_LUMP_END
            fontnumber = 0
        $End If
    End Sub

    '=======================
    '=
    '= CheckHighScore
    '=
    '=======================
    Sub CheckHighScore (score As Long, other As Integer)
        Dim i As Integer, j As Integer, n As Integer, result As Integer
        Dim myscore As HighScore, nm As String

        myscore.name = Chr$(0) ' strcpy(myscore.name,"")
        myscore.score = score
        myscore.episode = gamestate.episode
        myscore.completed = other

        n = -1
        For i = 0 To MaxScores - 1
            If myscore.score > Scores(i).score Or (myscore.score = Scores(i).score And myscore.completed > Scores(i).completed) Then
                For j = MaxScores - 1 To i + 1 Step -1
                    Scores(j) = Scores(j - 1)
                Next j
                Scores(i) = myscore
                n = i
                Exit For
            End If
        Next i

        $If SPEAR = DEFINED Then
            StartCPMusic XAWARD_MUS
        $Else
            StartCPMusic ROSTER_MUS
        $End If
        DrawHighScores

        VW_FadeIn

        If n <> -1 Then
            '
            ' got a high score
            '
            PrintY = 76 + (16 * n)
            nm = ""
            $If SPEAR = UNDEFINED Then
                PrintX = 4 * 8
                backcolor = BORDCOLOR
                fontcolor = 15
                result = US_LineInput(PrintX, PrintY, nm, "", TRUE, MaxHighName, 100)
            $Else
                PrintX = 16
                fontnumber = 1
                VWB_Bar PrintX - 2, PrintY - 2, 145, 15, &H9C
                VW_UpdateScreen
                backcolor = &H9C
                fontcolor = 15
                result = US_LineInput(PrintX, PrintY, nm, "", TRUE, MaxHighName, 130)
            $End If
            ' (US_LineInput only stores the name on Enter: after Esc it stays empty, as in C)
            Scores(n).name = nm + Chr$(0)
        Else
            IN_ClearKeysDown
            result = IN_UserInput(500)
        End If
    End Sub

    $If SPEAR = DEFINED Then
        $If SPEARDEMO = UNDEFINED Then
            '////////////////////////////////////////////////////////
            '//
            '// COPY PROTECTION FOR FormGen (WL_INTER.C 1315-1716)
            '//
            '////////////////////////////////////////////////////////

            ' The string tables of the quiz (char far CopyProFailedStrs[], BackDoorStrs[]...,
            ' the strings of F_SPEAR.H), by table name and index
            Function CopyProStr$ (table As String, i As Integer)
                Dim s As String

                Select Case table
                    Case "failed" ' CopyProFailedStrs[18]
                        Select Case i
                            Case 0: s = "That's close, but not close enough to get"
                            Case 1: s = "you into the game."
                            Case 2: s = "Wow, you must have the early version of the"
                            Case 3: s = "manual with the totally false information in it."
                            Case 4: s = "I would let you into the game, but seeing"
                            Case 5: s = "as that was not at all the right answer..."
                            Case 6: s = "It's just too bad we can't get together on"
                            Case 7: s = "this one.  Sorry."
                            Case 8: s = "Hey, you're just SO off base!"
                            Case 10: s = "You know, I once typed that myself when"
                            Case 11: s = "I was your age."
                            Case 12: s = "Nops.  Zero points.  Zugga."
                            Case 14: s = "Yeah...right."
                            Case 16: s = "You must like these quizzes."
                        End Select
                    Case "backdoor" ' BackDoorStrs[5] (BETA is not defined: "snoops")
                        Select Case i
                            Case 0: s = "a spoon?"
                            Case 1: s = "bite me!"
                            Case 2: s = "joshua"
                            Case 3: s = "pelt"
                            Case 4: s = "snoops"
                        End Select
                    Case "goodboy" ' GoodBoyStrs[10]
                        Select Case i
                            Case 0: s = "...is the CORRECT ANSWER!"
                            Case 2: s = "Consider yourself bitten, sir."
                            Case 4: s = "Greetings Professor Falken, would you"
                            Case 5: s = "like to play Spear of Destiny?"
                            Case 6: s = "Do you have any gold spray paint?"
                            Case 8: s = "I wish I had a 21" + Chr$(34) + " monitor..."
                        End Select
                    Case "boss" ' bossstrs[4]
                        Select Case i
                            Case 0: s = "DEATH KNIGHT"
                            Case 1: s = "BARNACLE WILHELM"
                            Case 2: s = "UBERMUTANTUBER MUTANT"
                            Case 3: s = "TRANS GROSSE"
                        End Select
                    Case "word" ' WordStr[5]
                        Select Case i
                            Case 0: s = "New Game"
                            Case 1: s = "Sound...F4"
                            Case 2: s = "Control...F6"
                            Case 3: s = "Change View...F5"
                            Case 4: s = "Quit...F10"
                        End Select
                    Case "wordcorrect" ' WordCorrect[5]
                        Select Case i
                            Case 0: s = "3"
                            Case 1, 2: s = "4"
                            Case 3, 4: s = "5"
                        End Select
                    Case "member" ' MemberStr[10]
                        Select Case i
                            Case 0: s = "Could be called " + Chr$(34) + "PixelMeister" + Chr$(34) + "?"
                            Case 2: s = "Might engineer some software?"
                            Case 4: s = "Would be found"
                            Case 5: s = "directing creatively?"
                            Case 6: s = "Might be found"
                            Case 7: s = "handling operations?"
                            Case 8: s = "Has a name familiar"
                            Case 9: s = "to your weatherman?"
                        End Select
                    Case "membercorrect" ' MemberCorrect[5]
                        Select Case i
                            Case 0: s = "adrian carmack"
                            Case 1: s = "john carmackjohn romero"
                            Case 2: s = "tom hall"
                            Case 3: s = "jay wilbur"
                            Case 4: s = "kevin cloud"
                        End Select
                    Case "dos" ' DosMessages[9]
                        Select Case i
                            Case 0: s = "Welcome to the DOS prompt, pirate!"
                            Case 1: s = "Eat hot DOS prompt, goober!"
                            Case 2: s = "Ya know, this program doesn't cost that much."
                            Case 3: s = "Hey...weren't you just AT this DOS prompt?"
                            Case 4: s = "What's a nice user like you doin' at a DOS prompt like this?"
                            Case 5: s = "Well, I'm sure you just " + Chr$(34) + "misplaced" + Chr$(34) + " the manual..."
                            Case 6: s = "Run me again when you've boned up on your manual a bit."
                            Case 7: s = "Nice try, but no Spear."
                            Case 8: s = "That information is in the Spear of Destiny manual, by the way."
                        End Select
                    Case "misctitle" ' MiscTitle[4]
                        Select Case i
                            Case 0: s = "BLOOD TEST"
                            Case 1: s = "STRAIGHT-LACED"
                            Case 2: s = "QUITE SHAPELY"
                            Case 3: s = "I AM WHAT I AMMO"
                        End Select
                    Case "misc" ' MiscStr[12]
                        Select Case i
                            Case 0: s = "Under " + Chr$(34) + "Killing the Enemy" + Chr$(34) + ", what"
                            Case 1: s = "type of enemy is pictured?"
                            Case 3: s = "How many eyelets are on B.J.'s"
                            Case 4: s = "boots? (see page 2)"
                            Case 6: s = "The word " + Chr$(34) + "minister" + Chr$(34) + " appears in"
                            Case 7: s = "what gray shape on page 2?"
                            Case 9: s = "How many bullets does B.J. have"
                            Case 10: s = "on the screen-shot in the middle"
                            Case 11: s = "of page 9?"
                        End Select
                    Case "misccorrect" ' MiscCorrect[4]
                        Select Case i
                            Case 0: s = "ss"
                            Case 1: s = "8"
                            Case 2: s = "star" ' STR_STAR
                            Case 3: s = "45"
                        End Select
                End Select
                CopyProStr$ = s
            End Function

            ' Some answers always pass, with their own reply
            Function BackDoor% (s As String)
                Dim i As Integer

                s = LCase$(s) ' strlwr

                For i = 0 To 4
                    If s = CopyProStr$("backdoor", i) Then
                        SETFONTCOLOR 14, 15
                        fontnumber = 0
                        PrintY = 175
                        VWB_DrawPic 0, 20 * 8, COPYPROTBOXPIC
                        US_CPrint CopyProStr$("goodboy", i * 2)
                        US_CPrint CopyProStr$("goodboy", i * 2 + 1)
                        VW_UpdateScreen
                        BackDoor% = 1
                        Exit Function
                    End If
                Next i

                BackDoor% = 0
            End Function

            ' The C loops of the boss and staff questions: the answer matches when it is
            ' found (case insensitive) anywhere in the correct string, and is longer than minlen
            Function CopyProSubMatch% (answer As String, correct As String, minlen As Integer)
                Dim i As Integer

                CopyProSubMatch% = 0
                If Len(answer) <= minlen Then Exit Function
                For i = 1 To Len(correct)
                    If LCase$(Mid$(correct, i, Len(answer))) = LCase$(answer) Then
                        CopyProSubMatch% = 1
                        Exit Function
                    End If
                Next i
            End Function

            Sub CopyProtection ()
                Const TYPEBOX_Y = 177
                Const TYPEBOX_BKGD = &H9C
                Const PRINTCOLOR = HIGHLIGHT

                ' the quiz types
                Const debriefing = 0
                Const checkmanual = 1
                Const staffquiz = 2
                Const miscquiz = 3
                Const totaltypes = 4

                Dim i As Integer, match As Integer, whichboss As Integer, bossnum As Integer
                Dim try As Integer, whichline As Integer, whichone As Integer, quiztype As Integer
                Dim whichmem As Integer, whichword As Integer, start As Integer, played As Integer
                Dim enemypicked(0 To 3) As Integer, whichpicked(0 To 3) As Integer
                Dim memberpicked(0 To 4) As Integer, wordpicked(0 To 4) As Integer
                Dim inputbuffer As String, msgtext As String

                try = 0
                VW_FadeOut
                CA_CacheGrChunk C_BACKDROPPIC
                CacheLump COPYPROT_LUMP_START, COPYPROT_LUMP_END
                CA_CacheGrChunk STARTFONT + 1
                CA_LoadAllSounds
                StartCPMusic COPYPRO_MUS
                US_InitRndT TRUE

                Do While try < 3
                    fontnumber = 1
                    SETFONTCOLOR PRINTCOLOR - 2, 15
                    VWB_DrawPic 0, 0, C_BACKDROPPIC
                    VWB_DrawPic 0, 0, COPYPROTTOPPIC
                    VWB_DrawPic 0, 20 * 8, COPYPROTBOXPIC
                    WindowX = 0: WindowY = 0
                    WindowW = 320
                    WindowH = 200
                    PrintY = 65

                    quiztype = US_RndT Mod totaltypes
                    Select Case quiztype
                        '
                        ' BOSSES QUIZ
                        '
                        Case debriefing
                            PrintX = 0
                            US_Print " DEBRIEFING" + Chr$(10) + " SESSION" + Chr$(10) ' STR_DEBRIEF
                            SETFONTCOLOR PRINTCOLOR, 15

                            Do
                                whichboss = US_RndT And 3
                            Loop While enemypicked(whichboss)
                            enemypicked(whichboss) = 1
                            bossnum = BOSSPIC1PIC + whichboss ' bosses[4]
                            VWB_DrawPic 128, 60, bossnum
                            fontnumber = 0
                            PrintY = 130
                            US_CPrint "Name the member of the" + Chr$(10) ' STR_ENEMY1
                            US_CPrint "enemy forces shown above" + Chr$(10) + Chr$(10) ' STR_ENEMY2

                            VW_UpdateScreen
                            VW_FadeIn

                            PrintX = 100
                            fontcolor = 15
                            backcolor = TYPEBOX_BKGD
                            inputbuffer = ""
                            PrintY = TYPEBOX_Y
                            fontnumber = 1
                            i = US_LineInput(PrintX, PrintY, inputbuffer, "", TRUE, 20, 100)

                            match = CopyProSubMatch(inputbuffer, CopyProStr$("boss", whichboss), 3)
                            match = match + BackDoor(inputbuffer)

                            '
                            ' MANUAL CHECK
                            '
                        Case checkmanual
                            Do
                                whichword = US_RndT Mod 5
                            Loop While wordpicked(whichword)
                            wordpicked(whichword) = 1
                            US_CPrint "CHECK YER MANUAL!" ' STR_CHECKMAN
                            SETFONTCOLOR PRINTCOLOR, 15
                            PrintY = PrintY + 25
                            US_CPrint "Which manual page" ' STR_MAN1
                            US_CPrint "is the Options Menu" ' STR_MAN2
                            msgtext = "function " + Chr$(34) + CopyProStr$("word", whichword) + Chr$(34) + " on?" ' STR_MAN3, STR_MAN4
                            US_CPrint msgtext
                            VW_UpdateScreen
                            VW_FadeIn

                            PrintX = 146
                            fontcolor = 15
                            backcolor = TYPEBOX_BKGD
                            inputbuffer = ""
                            PrintY = TYPEBOX_Y
                            i = US_LineInput(PrintX, PrintY, inputbuffer, "", TRUE, 6, 100)

                            inputbuffer = LCase$(inputbuffer)
                            match = 0
                            If inputbuffer = CopyProStr$("wordcorrect", whichword) Then match = 1
                            match = match + BackDoor(inputbuffer)

                            '
                            ' STAFF QUIZ
                            '
                        Case staffquiz
                            Do
                                whichmem = US_RndT Mod 5
                            Loop While memberpicked(whichmem)
                            memberpicked(whichmem) = 1
                            US_CPrint "Which member of Id Software:" ' STR_ID1
                            SETFONTCOLOR PRINTCOLOR, 15
                            PrintY = PrintY + 25
                            US_CPrint CopyProStr$("member", whichmem * 2)
                            US_CPrint CopyProStr$("member", whichmem * 2 + 1)
                            VW_UpdateScreen
                            VW_FadeIn

                            PrintX = 100
                            fontcolor = 15
                            backcolor = TYPEBOX_BKGD
                            inputbuffer = ""
                            PrintY = TYPEBOX_Y
                            i = US_LineInput(PrintX, PrintY, inputbuffer, "", TRUE, 20, 120)

                            inputbuffer = LCase$(inputbuffer)
                            match = CopyProSubMatch(inputbuffer, CopyProStr$("membercorrect", whichmem), 2)
                            match = match + BackDoor(inputbuffer)

                            '
                            ' MISCELLANEOUS QUESTIONS
                            '
                        Case miscquiz
                            Do
                                whichone = US_RndT And 3
                            Loop While whichpicked(whichone)
                            whichpicked(whichone) = 1
                            US_CPrint CopyProStr$("misctitle", whichone)
                            SETFONTCOLOR PRINTCOLOR, 15
                            PrintY = PrintY + 25
                            US_CPrint CopyProStr$("misc", whichone * 3)
                            US_CPrint CopyProStr$("misc", whichone * 3 + 1)
                            US_CPrint CopyProStr$("misc", whichone * 3 + 2)
                            VW_UpdateScreen
                            VW_FadeIn

                            PrintX = 146
                            fontcolor = 15
                            backcolor = TYPEBOX_BKGD
                            inputbuffer = ""
                            PrintY = TYPEBOX_Y
                            i = US_LineInput(PrintX, PrintY, inputbuffer, "", TRUE, 6, 100)

                            inputbuffer = LCase$(inputbuffer)
                            match = 0
                            If inputbuffer = CopyProStr$("misccorrect", whichone) Then match = 1
                            match = match + BackDoor(inputbuffer)
                    End Select

                    '
                    ' IF NO MATCH, WE'VE GOT A (MINOR) PROBLEM!
                    '
                    If match = 0 Then
                        whichline = 2 * (US_RndT Mod 9)
                        SETFONTCOLOR 14, 15
                        fontnumber = 0
                        PrintY = 175
                        VWB_DrawPic 0, 20 * 8, COPYPROTBOXPIC
                        US_CPrint CopyProStr$("failed", whichline)
                        US_CPrint CopyProStr$("failed", whichline + 1)

                        VW_UpdateScreen
                        played = SD_PlaySound(NOWAYSND)
                        i = IN_UserInput(TickBase * 3)
                        VW_FadeOut
                        try = try + 1
                    Else
                        played = SD_PlaySound(BONUS1UPSND)
                        SD_WaitSoundDone
                        UNCACHEGRCHUNK STARTFONT + 1
                        UNCACHEGRCHUNK C_BACKDROPPIC
                        UnCacheLump COPYPROT_LUMP_START, COPYPROT_LUMP_END

                        Select Case SoundMode
                            Case sdm_Off: Exit Sub
                            Case sdm_PC: start = STARTPCSOUNDS
                            Case sdm_AdLib: start = STARTADLIBSOUNDS
                        End Select

                        For i = 0 To NUMSOUNDS - 1
                            CA_FreeAudioChunk start + i ' MM_FreePtr
                        Next i
                        Exit Sub
                    End If
                Loop

                ' Three wrong answers: back to DOS with a msgtext (C: ShutdownId, text mode,
                ' printf, exit(1); Quit with a msgtext does not write the config either)
                ClearMemory
                msgtext = CopyProStr$("dos", US_RndT Mod 9)
                Quit msgtext
            End Sub
        $End If
    $End If

    '$INCLUDE: 'ID_VH.BM'
    '$INCLUDE: 'WL_MENU.BM'
$End If
