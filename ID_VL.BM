' ID_VL.BM (Basic Module)
'$INCLUDE: 'ID_VL.BI'
$If INCLUDE_ID_VL_BM = UNDEFINED Then
    $Let INCLUDE_ID_VL_BM = 1

    Sub VL_WaitVBL (num_vbls As Integer)
        Rem Simulate waiting for VBlank in QB64 Basic
        ' This is a placeholder. Implement actual VBlank wait if needed.
        ' ignore num_vbls

        _Limit 60

        ' or use the following
        ' https://github-wiki-see.page/m/QB64Official/qb64/wiki/WAIT
        ' Either statement can be used to try to reduce screen flickering.
        ' If both statements are used, try changing the order.
        ' WAIT &H3DA, 8 ' finishes whenever the screen isn't being written to
        ' WAIT &H3DA, 8, 8 ' finishes whenever the screen is being written to
    End Sub

    Sub VL_GetPalette (palette_array() As Long)
        Dim i As Integer
        Rem Simulate getting the current palette in QB64 Basic
        ' This is a placeholder. Implement actual palette retrieval if needed.
        For i = 0 To 255
            ' Syntax: color32Value& = _PALETTECOLOR(attributeNumber%, imgHandle&)'
            palette_array(i) = _PaletteColor(i, 0)
        Next i
    End Sub

    Sub c_fmemcpy (dest() As Long, src() As Long, num_bytes As Integer)
        Dim i As Integer
        Rem Simulate memory copy in QB64 Basic
        ' This is a placeholder. Implement actual memory copy if needed.
        For i = 0 To num_bytes - 1
            dest(i) = src(i)
        Next i
    End Sub

    Sub VL_SetPalette (palette_array() As Long)
        Dim i As Integer
        Rem Simulate setting the palette in QB64 Basic
        ' This is a placeholder. Implement actual palette setting if needed.
        For i = 0 To 255
            _PaletteColor i, palette_array(i)
        Next i
    End Sub

    Sub VL_FillPalette (red As Integer, green As Integer, blue As Integer)
        Dim i As Integer
        Rem Simulate filling the entire palette with a single color in QB64 Basic
        ' This is a placeholder. Implement actual palette fill if needed.
        For i = 0 To 255
            _PaletteColor i, _RGB32(red, green, blue)
        Next i
    End Sub

    ' Example usage:
    ' Call the fade out function
    ' VL_FadeOut 0, 255, 255, 0, 0, 64
    ' red, green, blue are 6-bit VGA DAC values (0-63) as in the original
    Sub VL_FadeOut (start As Integer, finish As Integer, red6 As Long, green6 As Long, blue6 As Long, steps As Integer)
        Dim i As Integer
        Dim j As Integer
        Dim red As Long, green As Long, blue As Long
        red = red6 * 255 \ 63
        green = green6 * 255 \ 63
        blue = blue6 * 255 \ 63
        VL_WaitVBL 1
        VL_GetPalette palette1()

        c_fmemcpy palette2(), palette1(), 256

        For i = 0 To steps - 1
            For j = start To finish
                palette2(j) = _RGB32(_Red32(palette1(j)) + (red - _Red32(palette1(j))) * i / steps, _Green32(palette1(j)) + (green - _Green32(palette1(j))) * i / steps, _Blue32(palette1(j)) + (blue - _Blue32(palette1(j))) * i / steps)
            Next j

            VL_WaitVBL 1
            VL_SetPalette palette2()
        Next i

        VL_FillPalette red, green, blue
        screenfaded = TRUE
    End Sub

    '=================
    '=
    '= VL_FadeIn
    '=
    '=================
    Sub VL_FadeIn (start As Integer, finish As Integer, palette_array() As Long, steps As Integer)
        Dim i As Integer
        Dim j As Integer
        VL_WaitVBL 1
        VL_GetPalette palette1()

        c_fmemcpy palette2(), palette1(), 256

        ' fade through intermediate frames
        For i = 0 To steps - 1
            For j = start To finish
                palette2(j) = _RGB32(_Red32(palette1(j)) + (_Red32(palette_array(j)) - _Red32(palette1(j))) * i / steps, _Green32(palette1(j)) + (_Green32(palette_array(j)) - _Green32(palette1(j))) * i / steps, _Blue32(palette1(j)) + (_Blue32(palette_array(j)) - _Blue32(palette1(j))) * i / steps)
            Next j

            VL_WaitVBL 1
            VL_SetPalette palette2()
        Next i

        ' final color
        VL_SetPalette palette_array()
        screenfaded = FALSE
    End Sub

    '=================
    '=
    '= VL_PlanarMemToScreen
    '=
    '= VL_MemToScreen of ID_VL.C: draws a block stored as 4 VGA planes
    '= (plane p holds the pixels with x mod 4 = p) to the Screen 13 page.
    '= VL_MemToScreen in WOLF3D.BAS draws linear (already munged) data.
    '=
    '=================
    Sub VL_PlanarMemToScreen (source As _MEM, width As Integer, height As Integer, x As Integer, y As Integer)
        Dim scr As _MEM
        Dim plane As Long, py As Long, px As Long, sx As Long, sy As Long
        Dim src As _Offset
        Dim pixel As _Unsigned _Byte

        scr = _MemImage(0)
        src = source.OFFSET
        For plane = 0 To 3
            For py = 0 To height - 1
                sy = y + py
                For px = 0 To width \ 4 - 1
                    sx = x + px * 4 + plane
                    pixel = _MemGet(source, src, _Unsigned _Byte)
                    If sx >= 0 And sx < 320 And sy >= 0 And sy < 200 Then
                        _MemPut scr, scr.OFFSET + sy * 320 + sx, pixel
                    End If
                    src = src + 1
                Next px
            Next py
        Next plane
        _MemFree scr
    End Sub

    '=================
    '=
    '= VL_Hlin
    '=
    '=================

    Sub VL_Hlin (x As Integer, y As Integer, width As Integer, color_bar As Integer)
        Line (x, y)-(x + width - 1, y), color_bar
    End Sub

    '=================
    '=
    '= VL_Vlin
    '=
    '=================
    Sub VL_Vlin (x As Integer, y As Integer, height As Integer, color_bar As Integer)
        Line (x, y)-(x, y + height - 1), color_bar
    End Sub

    '=================
    '=
    '= VL_Bar
    '=
    '=================
    Sub VL_Bar (x As Integer, y As Integer, width As Integer, height As Integer, color_bar As Integer)
        Line (x, y)-(x + width - 1, y + height - 1), color_bar, BF
    End Sub
$End If
