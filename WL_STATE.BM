' WL_STATE.C - actor movement, sight, damage (step 6g); the state table setup and
' the routine dispatcher of the port (see WL_STATE.BI)

$If INCLUDE_WL_STATE_BM = UNDEFINED Then
    $Let INCLUDE_WL_STATE_BM = 1

    '$INCLUDE: 'WL_STATE.BI'

    '===================
    '=
    '= SpawnNewObj
    '=
    '= Spaws a new actor at the given TILE coordinates, with the given state, and
    '= the given size in GLOBAL units.
    '=
    '= new                   = a pointer to an initialized new actor
    '=
    '===================
    Sub SpawnNewObj (tilex As Integer, tiley As Integer, state As Integer)
        GetNewActor
        objlist(newobj).state = state
        If states(state).tictime Then
            objlist(newobj).ticcount = US_RndT Mod states(state).tictime
        Else
            objlist(newobj).ticcount = 0
        End If

        objlist(newobj).tilex = tilex
        objlist(newobj).tiley = tiley
        objlist(newobj).x = tilex * TILEGLOBAL + TILEGLOBAL \ 2 ' ((long)tilex<<TILESHIFT)+TILEGLOBAL/2
        objlist(newobj).y = tiley * TILEGLOBAL + TILEGLOBAL \ 2
        objlist(newobj).dir = dt_nodir

        actorat(tilex, tiley) = OBJ_BASE + newobj
        objlist(newobj).areanumber = mapsegs(0, objlist(newobj).tiley * 64 + objlist(newobj).tilex) - AREATILE
    End Sub

    '===================
    '=
    '= NewState
    '=
    '= Changes ob to a new state, setting ticcount to the max for that state
    '=
    '===================
    Sub NewState (ob As Integer, state As Integer)
        objlist(ob).state = state
        objlist(ob).ticcount = states(state).tictime
    End Sub

    '
    ' =============================================================================
    '                  ENEMY TILE WORLD MOVEMENT CODE
    ' =============================================================================
    '

    ' CHECKDIAG (x,y) of TryWalk: FALSE when the tile blocks a diagonal move.
    ' actorat() values: walls and doors are below 256 (C: temp<256), objects OBJ_BASE and up
    Function CheckDiag% (x As Long, y As Long)
        Dim temp As Integer

        CheckDiag% = TRUE
        temp = actorat(x, y)
        If temp Then
            If temp < 256 Then CheckDiag% = FALSE: Exit Function
            If objlist(temp - OBJ_BASE).flags And FL_SHOOTABLE Then CheckDiag% = FALSE
        End If
    End Function

    ' CHECKSIDE (x,y) of TryWalk: FALSE when the tile blocks; a door (128-255) sets doornumv
    Function CheckSide% (x As Long, y As Long, doornumv As Integer)
        Dim temp As Integer

        CheckSide% = TRUE
        temp = actorat(x, y)
        If temp Then
            If temp < 128 Then CheckSide% = FALSE: Exit Function
            If temp < 256 Then
                doornumv = temp And 63
            ElseIf objlist(temp - OBJ_BASE).flags And FL_SHOOTABLE Then
                CheckSide% = FALSE
            End If
        End If
    End Function

    '==================================
    '=
    '= TryWalk
    '=
    '= Attempts to move ob in its current (ob->dir) direction.
    '=
    '= If blocked by either a wall or an actor returns FALSE
    '=
    '= If move is either clear or blocked only by a door, returns TRUE and sets
    '=
    '= ob->tilex                     = new destination
    '= ob->tiley
    '= ob->areanumber    = the floor tile number (0-(NUMAREAS-1)) of destination
    '= ob->distance          = TILEGLOBAl, or -doornumber if a door is blocking the way
    '=
    '= If a door is in the way, an OpenDoor call is made to start it opening.
    '= The actor code should wait until
    '=       doorobjlist[-ob->distance].action = dr_open, meaning the door has been
    '=       fully opened
    '=
    '==================================
    Function TryWalk% (ob As Integer)
        Dim doornumv As Integer, tx As Long, ty As Long, dogfake As Integer

        TryWalk% = FALSE
        doornumv = -1
        tx = objlist(ob).tilex
        ty = objlist(ob).tiley

        If objlist(ob).obclass = inertobj Then
            Select Case objlist(ob).dir
                Case dt_north
                    objlist(ob).tiley = ty - 1
                Case dt_northeast
                    objlist(ob).tilex = tx + 1
                    objlist(ob).tiley = ty - 1
                Case dt_east
                    objlist(ob).tilex = tx + 1
                Case dt_southeast
                    objlist(ob).tilex = tx + 1
                    objlist(ob).tiley = ty + 1
                Case dt_south
                    objlist(ob).tiley = ty + 1
                Case dt_southwest
                    objlist(ob).tilex = tx - 1
                    objlist(ob).tiley = ty + 1
                Case dt_west
                    objlist(ob).tilex = tx - 1
                Case dt_northwest
                    objlist(ob).tilex = tx - 1
                    objlist(ob).tiley = ty - 1
            End Select
        Else
            dogfake = (objlist(ob).obclass = dogobj Or objlist(ob).obclass = fakeobj)
            Select Case objlist(ob).dir
                Case dt_north
                    If dogfake Then
                        If Not CheckDiag(tx, ty - 1) Then Exit Function
                    Else
                        If Not CheckSide(tx, ty - 1, doornumv) Then Exit Function
                    End If
                    objlist(ob).tiley = ty - 1

                Case dt_northeast
                    If Not CheckDiag(tx + 1, ty - 1) Then Exit Function
                    If Not CheckDiag(tx + 1, ty) Then Exit Function
                    If Not CheckDiag(tx, ty - 1) Then Exit Function
                    objlist(ob).tilex = tx + 1
                    objlist(ob).tiley = ty - 1

                Case dt_east
                    If dogfake Then
                        If Not CheckDiag(tx + 1, ty) Then Exit Function
                    Else
                        If Not CheckSide(tx + 1, ty, doornumv) Then Exit Function
                    End If
                    objlist(ob).tilex = tx + 1

                Case dt_southeast
                    If Not CheckDiag(tx + 1, ty + 1) Then Exit Function
                    If Not CheckDiag(tx + 1, ty) Then Exit Function
                    If Not CheckDiag(tx, ty + 1) Then Exit Function
                    objlist(ob).tilex = tx + 1
                    objlist(ob).tiley = ty + 1

                Case dt_south
                    If dogfake Then
                        If Not CheckDiag(tx, ty + 1) Then Exit Function
                    Else
                        If Not CheckSide(tx, ty + 1, doornumv) Then Exit Function
                    End If
                    objlist(ob).tiley = ty + 1

                Case dt_southwest
                    If Not CheckDiag(tx - 1, ty + 1) Then Exit Function
                    If Not CheckDiag(tx - 1, ty) Then Exit Function
                    If Not CheckDiag(tx, ty + 1) Then Exit Function
                    objlist(ob).tilex = tx - 1
                    objlist(ob).tiley = ty + 1

                Case dt_west
                    If dogfake Then
                        If Not CheckDiag(tx - 1, ty) Then Exit Function
                    Else
                        If Not CheckSide(tx - 1, ty, doornumv) Then Exit Function
                    End If
                    objlist(ob).tilex = tx - 1

                Case dt_northwest
                    If Not CheckDiag(tx - 1, ty - 1) Then Exit Function
                    If Not CheckDiag(tx - 1, ty) Then Exit Function
                    If Not CheckDiag(tx, ty - 1) Then Exit Function
                    objlist(ob).tilex = tx - 1
                    objlist(ob).tiley = ty - 1

                Case dt_nodir
                    Exit Function

                Case Else
                    Quit "Walk: Bad dir"
            End Select
        End If

        If doornumv <> -1 Then
            OpenDoor doornumv
            objlist(ob).distance = -doornumv - 1
            TryWalk% = TRUE
            Exit Function
        End If

        objlist(ob).areanumber = mapsegs(0, objlist(ob).tiley * 64 + objlist(ob).tilex) - AREATILE

        objlist(ob).distance = TILEGLOBAL
        TryWalk% = TRUE
    End Function

    '==================================
    '=
    '= SelectDodgeDir
    '=
    '= Attempts to choose and initiate a movement for ob that sends it towards
    '= the player while dodging
    '=
    '= If there is no possible move (ob is totally surrounded)
    '=
    '= ob->dir                       =       nodir
    '=
    '= Otherwise
    '=
    '= ob->dir                       = new direction to follow
    '= ob->distance          = TILEGLOBAL or -doornumber
    '= ob->tilex                     = new destination
    '= ob->tiley
    '= ob->areanumber    = the floor tile number (0-(NUMAREAS-1)) of destination
    '=
    '==================================
    Sub SelectDodgeDir (ob As Integer)
        Dim deltax As Integer, deltay As Integer, i As Integer
        Dim absdx As Integer, absdy As Integer
        Dim dirtry(0 To 4) As Integer
        Dim turnaround As Integer, tdir As Integer

        If objlist(ob).flags And FL_FIRSTATTACK Then
            '
            ' turning around is only ok the very first time after noticing the
            ' player
            '
            turnaround = dt_nodir
            objlist(ob).flags = objlist(ob).flags And (Not FL_FIRSTATTACK)
        Else
            turnaround = opposite(objlist(ob).dir)
        End If

        deltax = objlist(player).tilex - objlist(ob).tilex
        deltay = objlist(player).tiley - objlist(ob).tiley

        '
        ' arange 5 direction choices in order of preference
        ' the four cardinal directions plus the diagonal straight towards
        ' the player
        '
        If deltax > 0 Then
            dirtry(1) = dt_east
            dirtry(3) = dt_west
        Else
            dirtry(1) = dt_west
            dirtry(3) = dt_east
        End If

        If deltay > 0 Then
            dirtry(2) = dt_south
            dirtry(4) = dt_north
        Else
            dirtry(2) = dt_north
            dirtry(4) = dt_south
        End If

        '
        ' randomize a bit for dodging
        '
        absdx = Abs(deltax)
        absdy = Abs(deltay)

        If absdx > absdy Then
            tdir = dirtry(1)
            dirtry(1) = dirtry(2)
            dirtry(2) = tdir
            tdir = dirtry(3)
            dirtry(3) = dirtry(4)
            dirtry(4) = tdir
        End If

        If US_RndT < 128 Then
            tdir = dirtry(1)
            dirtry(1) = dirtry(2)
            dirtry(2) = tdir
            tdir = dirtry(3)
            dirtry(3) = dirtry(4)
            dirtry(4) = tdir
        End If

        dirtry(0) = diagonal(dirtry(1), dirtry(2))

        '
        ' try the directions util one works
        '
        For i = 0 To 4
            If dirtry(i) = dt_nodir Or dirtry(i) = turnaround Then _Continue

            objlist(ob).dir = dirtry(i)
            If TryWalk(ob) Then Exit Sub
        Next i

        '
        ' turn around only as a last resort
        '
        If turnaround <> dt_nodir Then
            objlist(ob).dir = turnaround

            If TryWalk(ob) Then Exit Sub
        End If

        objlist(ob).dir = dt_nodir
    End Sub

    '============================
    '=
    '= SelectChaseDir
    '=
    '= As SelectDodgeDir, but doesn't try to dodge
    '=
    '============================
    Sub SelectChaseDir (ob As Integer)
        Dim deltax As Integer, deltay As Integer
        Dim d(1 To 2) As Integer
        Dim tdir As Integer, olddir As Integer, turnaround As Integer

        olddir = objlist(ob).dir
        turnaround = opposite(olddir)

        deltax = objlist(player).tilex - objlist(ob).tilex
        deltay = objlist(player).tiley - objlist(ob).tiley

        d(1) = dt_nodir
        d(2) = dt_nodir

        If deltax > 0 Then
            d(1) = dt_east
        ElseIf deltax < 0 Then
            d(1) = dt_west
        End If
        If deltay > 0 Then
            d(2) = dt_south
        ElseIf deltay < 0 Then
            d(2) = dt_north
        End If

        If Abs(deltay) > Abs(deltax) Then
            tdir = d(1)
            d(1) = d(2)
            d(2) = tdir
        End If

        If d(1) = turnaround Then d(1) = dt_nodir
        If d(2) = turnaround Then d(2) = dt_nodir

        If d(1) <> dt_nodir Then
            objlist(ob).dir = d(1)
            If TryWalk(ob) Then Exit Sub ' either moved forward or attacked
        End If

        If d(2) <> dt_nodir Then
            objlist(ob).dir = d(2)
            If TryWalk(ob) Then Exit Sub
        End If

        ' there is no direct path to the player, so pick another direction

        If olddir <> dt_nodir Then
            objlist(ob).dir = olddir
            If TryWalk(ob) Then Exit Sub
        End If

        If US_RndT > 128 Then ' randomly determine direction of search
            For tdir = dt_north To dt_west
                If tdir <> turnaround Then
                    objlist(ob).dir = tdir
                    If TryWalk(ob) Then Exit Sub
                End If
            Next tdir
        Else
            For tdir = dt_west To dt_north Step -1
                If tdir <> turnaround Then
                    objlist(ob).dir = tdir
                    If TryWalk(ob) Then Exit Sub
                End If
            Next tdir
        End If

        If turnaround <> dt_nodir Then
            objlist(ob).dir = turnaround
            If objlist(ob).dir <> dt_nodir Then
                If TryWalk(ob) Then Exit Sub
            End If
        End If

        objlist(ob).dir = dt_nodir ' can't move
    End Sub

    '============================
    '=
    '= SelectRunDir
    '=
    '= Run Away from player
    '=
    '============================
    Sub SelectRunDir (ob As Integer)
        Dim deltax As Integer, deltay As Integer
        Dim d(1 To 2) As Integer
        Dim tdir As Integer

        deltax = objlist(player).tilex - objlist(ob).tilex
        deltay = objlist(player).tiley - objlist(ob).tiley

        If deltax < 0 Then
            d(1) = dt_east
        Else
            d(1) = dt_west
        End If
        If deltay < 0 Then
            d(2) = dt_south
        Else
            d(2) = dt_north
        End If

        If Abs(deltay) > Abs(deltax) Then
            tdir = d(1)
            d(1) = d(2)
            d(2) = tdir
        End If

        objlist(ob).dir = d(1)
        If TryWalk(ob) Then Exit Sub ' either moved forward or attacked

        objlist(ob).dir = d(2)
        If TryWalk(ob) Then Exit Sub

        ' there is no direct path to the player, so pick another direction

        If US_RndT > 128 Then ' randomly determine direction of search
            For tdir = dt_north To dt_west
                objlist(ob).dir = tdir
                If TryWalk(ob) Then Exit Sub
            Next tdir
        Else
            For tdir = dt_west To dt_north Step -1
                objlist(ob).dir = tdir
                If TryWalk(ob) Then Exit Sub
            Next tdir
        End If

        objlist(ob).dir = dt_nodir ' can't move
    End Sub

    ' One move of MoveObj in direction dir: sign +1 moves, -1 backs up
    Sub MoveObjDir (ob As Integer, dir As Integer, move As Long)
        Select Case dir
            Case dt_north
                objlist(ob).y = objlist(ob).y - move
            Case dt_northeast
                objlist(ob).x = objlist(ob).x + move
                objlist(ob).y = objlist(ob).y - move
            Case dt_east
                objlist(ob).x = objlist(ob).x + move
            Case dt_southeast
                objlist(ob).x = objlist(ob).x + move
                objlist(ob).y = objlist(ob).y + move
            Case dt_south
                objlist(ob).y = objlist(ob).y + move
            Case dt_southwest
                objlist(ob).x = objlist(ob).x - move
                objlist(ob).y = objlist(ob).y + move
            Case dt_west
                objlist(ob).x = objlist(ob).x - move
            Case dt_northwest
                objlist(ob).x = objlist(ob).x - move
                objlist(ob).y = objlist(ob).y - move
        End Select
    End Sub

    '=================
    '=
    '= MoveObj
    '=
    '= Moves ob be move global units in ob->dir direction
    '= Actors are not allowed to move inside the player
    '= Does NOT check to see if the move is tile map valid
    '=
    '= ob->x                 = adjusted for new position
    '= ob->y
    '=
    '=================
    Sub MoveObj (ob As Integer, move As Long)
        Dim deltax As Long, deltay As Long

        If objlist(ob).dir = dt_nodir Then Exit Sub
        If objlist(ob).dir < 0 Or objlist(ob).dir > dt_nodir Then Quit "MoveObj: bad dir!"

        MoveObjDir ob, objlist(ob).dir, move

        '
        ' check to make sure it's not on top of player
        '
        If areabyplayer(objlist(ob).areanumber) Then
            deltax = objlist(ob).x - objlist(player).x
            If deltax >= -MINACTORDIST And deltax <= MINACTORDIST Then
                deltay = objlist(ob).y - objlist(player).y
                If deltay >= -MINACTORDIST And deltay <= MINACTORDIST Then
                    If objlist(ob).obclass = ghostobj Or objlist(ob).obclass = spectreobj Then TakeDamage tics * 2, ob

                    '
                    ' back up
                    '
                    MoveObjDir ob, objlist(ob).dir, -move
                    Exit Sub
                End If
            End If
        End If
        ' moveok:
        objlist(ob).distance = objlist(ob).distance - move
    End Sub

    '
    ' =============================================================================
    '                              STUFF
    ' =============================================================================
    '

    '===============
    '=
    '= DropItem
    '=
    '= Tries to drop a bonus item somewhere in the tiles surrounding the
    '= given tilex/tiley
    '=
    '===============
    Sub DropItem (itemtype As Integer, tilex As Integer, tiley As Integer)
        Dim x As Integer, y As Integer

        '
        ' find a free spot to put it in
        '
        If actorat(tilex, tiley) = 0 Then
            PlaceItemType itemtype, tilex, tiley
            Exit Sub
        End If

        For x = tilex - 1 To tilex + 1
            For y = tiley - 1 To tiley + 1
                If actorat(x, y) = 0 Then
                    PlaceItemType itemtype, x, y
                    Exit Sub
                End If
            Next y
        Next x
    End Sub

    '===============
    '=
    '= KillActor
    '=
    '===============
    Sub KillActor (ob As Integer)
        Dim tilex As Integer, tiley As Integer

        objlist(ob).tilex = SarL(objlist(ob).x, TILESHIFT) ' drop item on center
        objlist(ob).tiley = SarL(objlist(ob).y, TILESHIFT)
        tilex = objlist(ob).tilex
        tiley = objlist(ob).tiley

        Select Case objlist(ob).obclass
            Case guardobj
                GivePoints 100
                NewState ob, s_grddie1
                PlaceItemType bo_clip2, tilex, tiley

            Case officerobj
                GivePoints 400
                NewState ob, s_ofcdie1
                PlaceItemType bo_clip2, tilex, tiley

            Case mutantobj
                GivePoints 700
                NewState ob, s_mutdie1
                PlaceItemType bo_clip2, tilex, tiley

            Case ssobj
                GivePoints 500
                NewState ob, s_ssdie1
                If gamestate.bestweapon < wp_machinegun Then
                    PlaceItemType bo_machinegun, tilex, tiley
                Else
                    PlaceItemType bo_clip2, tilex, tiley
                End If

            Case dogobj
                GivePoints 200
                NewState ob, s_dogdie1

            Case Else
                KillBoss ob, tilex, tiley
        End Select

        gamestate.killcount = gamestate.killcount + 1
        objlist(ob).flags = objlist(ob).flags And (Not FL_SHOOTABLE)
        actorat(objlist(ob).tilex, objlist(ob).tiley) = 0
        objlist(ob).flags = objlist(ob).flags Or FL_NONMARK
    End Sub

    ' The boss cases of KillActor (a $If between Case lines breaks Select Case)
    Sub KillBoss (ob As Integer, tilex As Integer, tiley As Integer)
        $If SPEAR = UNDEFINED Then
            Select Case objlist(ob).obclass
                Case bossobj
                    GivePoints 5000
                    NewState ob, s_bossdie1
                    PlaceItemType bo_key1, tilex, tiley

                Case gretelobj
                    GivePoints 5000
                    NewState ob, s_greteldie1
                    PlaceItemType bo_key1, tilex, tiley

                Case giftobj
                    GivePoints 5000
                    gamestate.killx = objlist(player).x
                    gamestate.killy = objlist(player).y
                    NewState ob, s_giftdie1

                Case fatobj
                    GivePoints 5000
                    gamestate.killx = objlist(player).x
                    gamestate.killy = objlist(player).y
                    NewState ob, s_fatdie1

                Case schabbobj
                    GivePoints 5000
                    gamestate.killx = objlist(player).x
                    gamestate.killy = objlist(player).y
                    NewState ob, s_schabbdie1
                    A_DeathScream ob

                Case fakeobj
                    GivePoints 2000
                    NewState ob, s_fakedie1

                Case mechahitlerobj
                    GivePoints 5000
                    NewState ob, s_mechadie1

                Case realhitlerobj
                    GivePoints 5000
                    gamestate.killx = objlist(player).x
                    gamestate.killy = objlist(player).y
                    NewState ob, s_hitlerdie1
                    A_DeathScream ob
            End Select
        $Else
                Select Case objlist(ob).obclass
                Case spectreobj
                GivePoints 200
                NewState ob, s_spectredie1

                Case angelobj
                GivePoints 5000
                NewState ob, s_angeldie1

                Case transobj
                GivePoints 5000
                NewState ob, s_transdie0
                PlaceItemType bo_key1, tilex, tiley

                Case uberobj
                GivePoints 5000
                NewState ob, s_uberdie0
                PlaceItemType bo_key1, tilex, tiley

                Case willobj
                GivePoints 5000
                NewState ob, s_willdie1
                PlaceItemType bo_key1, tilex, tiley

                Case deathobj
                GivePoints 5000
                NewState ob, s_deathdie1
                PlaceItemType bo_key1, tilex, tiley
                End Select
        $End If
    End Sub

    '===================
    '=
    '= DamageActor
    '=
    '= Called when the player succesfully hits an enemy.
    '=
    '= Does damage points to enemy ob, either putting it into a stun frame or
    '= killing it.
    '=
    '===================
    Sub DamageActor (ob As Integer, damage As Integer)
        Dim dmg As Long

        madenoise = TRUE

        '
        ' do double damage if shooting a non attack mode actor
        '
        dmg = damage
        If (objlist(ob).flags And FL_ATTACKMODE) = 0 Then dmg = dmg * 2

        objlist(ob).hitpoints = objlist(ob).hitpoints - dmg

        If objlist(ob).hitpoints <= 0 Then
            KillActor ob
        Else
            If (objlist(ob).flags And FL_ATTACKMODE) = 0 Then FirstSighting ob ' put into combat mode

            Select Case objlist(ob).obclass ' dogs only have one hit point
                Case guardobj
                    If objlist(ob).hitpoints And 1 Then
                        NewState ob, s_grdpain
                    Else
                        NewState ob, s_grdpain1
                    End If

                Case officerobj
                    If objlist(ob).hitpoints And 1 Then
                        NewState ob, s_ofcpain
                    Else
                        NewState ob, s_ofcpain1
                    End If

                Case mutantobj
                    If objlist(ob).hitpoints And 1 Then
                        NewState ob, s_mutpain
                    Else
                        NewState ob, s_mutpain1
                    End If

                Case ssobj
                    If objlist(ob).hitpoints And 1 Then
                        NewState ob, s_sspain
                    Else
                        NewState ob, s_sspain1
                    End If
            End Select
        End If
    End Sub

    '
    ' =============================================================================
    '                              CHECKSIGHT
    ' =============================================================================
    '

    ' tilemap[x][y] as the C byte array: a y outside 0-63 reads the next / previous column.
    ' (Outside the whole array C read other memory; here that is an empty tile.)
    Function TileAt% (x As Integer, y As Integer)
        Dim idx As Long

        idx = CLng(x) * MAPSIZE + y
        If idx < 0 Or idx >= MAPSIZE * MAPSIZE Then
            TileAt% = 0
        Else
            TileAt% = tilemap(idx \ MAPSIZE, idx Mod MAPSIZE)
        End If
    End Function

    ' One tile of CheckLine's trace: FALSE when it blocks the line. frac is the 1/256 tile
    ' position after the step, stepv the step (C: int)
    Function CheckLineTile% (value As Integer, frac As Integer, stepv As Integer)
        Dim intercept As Long, door As Integer

        CheckLineTile% = TRUE
        If value = 0 Then Exit Function

        If value < 128 Or value > 256 Then CheckLineTile% = FALSE: Exit Function

        '
        ' see if the door is open enough
        '
        door = value And (Not &H80)
        ' (a moving push wall is |0xc0: C read doorposition[] past its end; here it blocks)
        If door >= MAXDOORS Then CheckLineTile% = FALSE: Exit Function
        intercept = (frac - Fix(stepv / 2)) And &HFFFF& ' unsigned

        If intercept > doorposition(door) Then CheckLineTile% = FALSE
    End Function

    '=====================
    '=
    '= CheckLine
    '=
    '= Returns true if a straight line between the player and ob is unobstructed
    '=
    '= (int is 16-bit in the C code: Wrap16 where the sums can leave its range)
    '=
    '=====================
    Function CheckLine% (ob As Integer)
        Dim x1 As Integer, y1 As Integer, xt1 As Integer, yt1 As Integer
        Dim x2 As Integer, y2 As Integer, xt2 As Integer, yt2 As Integer
        Dim x As Integer, y As Integer
        Dim xdist As Integer, ydist As Integer, xstep As Integer, ystep As Integer
        Dim partial As Integer, delta As Integer
        Dim ltemp As Long
        Dim xfrac As Integer, yfrac As Integer, deltafrac As Integer
        Dim value As Integer

        CheckLine% = FALSE

        x1 = Wrap16%(SarL(objlist(ob).x, UNSIGNEDSHIFT)) ' 1/256 tile precision
        y1 = Wrap16%(SarL(objlist(ob).y, UNSIGNEDSHIFT))
        xt1 = SarL(x1, 8)
        yt1 = SarL(y1, 8)

        x2 = plux
        y2 = pluy
        xt2 = objlist(player).tilex
        yt2 = objlist(player).tiley

        xdist = Abs(xt2 - xt1)

        If xdist > 0 Then
            If xt2 > xt1 Then
                partial = 256 - (x1 And &HFF)
                xstep = 1
            Else
                partial = x1 And &HFF
                xstep = -1
            End If

            deltafrac = Abs(x2 - x1)
            delta = y2 - y1
            ltemp = Fix((CLng(delta) * 256) / deltafrac) ' C long division truncates
            If ltemp > &H7FFF& Then
                ystep = &H7FFF
            ElseIf ltemp < -32767& Then ' -0x7fffl (decimal: the QB64 IDE drops a - before &H)
                ystep = -32767
            Else
                ystep = ltemp
            End If
            yfrac = Wrap16%(y1 + SarL(CLng(ystep) * partial, 8))

            x = xt1 + xstep
            xt2 = xt2 + xstep
            Do
                y = SarL(yfrac, 8)
                yfrac = Wrap16%(CLng(yfrac) + ystep)

                value = TileAt(x, y)
                x = x + xstep

                If Not CheckLineTile(value, yfrac, ystep) Then Exit Function
            Loop While x <> xt2
        End If

        ydist = Abs(yt2 - yt1)

        If ydist > 0 Then
            If yt2 > yt1 Then
                partial = 256 - (y1 And &HFF)
                ystep = 1
            Else
                partial = y1 And &HFF
                ystep = -1
            End If

            deltafrac = Abs(y2 - y1)
            delta = x2 - x1
            ltemp = Fix((CLng(delta) * 256) / deltafrac)
            If ltemp > &H7FFF& Then
                xstep = &H7FFF
            ElseIf ltemp < -32767& Then ' -0x7fffl (decimal: the QB64 IDE drops a - before &H)
                xstep = -32767
            Else
                xstep = ltemp
            End If
            xfrac = Wrap16%(x1 + SarL(CLng(xstep) * partial, 8))

            y = yt1 + ystep
            yt2 = yt2 + ystep
            Do
                x = SarL(xfrac, 8)
                xfrac = Wrap16%(CLng(xfrac) + xstep)

                value = TileAt(x, y)
                y = y + ystep

                If Not CheckLineTile(value, xfrac, xstep) Then Exit Function
            Loop While y <> yt2
        End If

        CheckLine% = TRUE
    End Function

    '================
    '=
    '= CheckSight
    '=
    '= Checks a straight line between player and current object
    '=
    '= If the sight is ok, check alertness and angle to see if they notice
    '=
    '= returns true if the player has been spoted
    '=
    '================
    Function CheckSight% (ob As Integer)
        Const MINSIGHT = &H18000
        Dim deltax As Long, deltay As Long

        CheckSight% = FALSE

        '
        ' don't bother tracing a line if the area isn't connected to the player's
        '
        If Not areabyplayer(objlist(ob).areanumber) Then Exit Function

        '
        ' if the player is real close, sight is automatic
        '
        deltax = objlist(player).x - objlist(ob).x
        deltay = objlist(player).y - objlist(ob).y

        If deltax > -MINSIGHT And deltax < MINSIGHT And deltay > -MINSIGHT And deltay < MINSIGHT Then
            CheckSight% = TRUE
            Exit Function
        End If

        '
        ' see if they are looking in the right direction
        '
        Select Case objlist(ob).dir
            Case dt_north
                If deltay > 0 Then Exit Function
            Case dt_east
                If deltax < 0 Then Exit Function
            Case dt_south
                If deltay < 0 Then Exit Function
            Case dt_west
                If deltax > 0 Then Exit Function
        End Select

        '
        ' trace a line to check for blocking tiles (corners)
        '
        CheckSight% = CheckLine(ob)
    End Function

    '===============
    '=
    '= FirstSighting
    '=
    '= Puts an actor into attack mode and possibly reverses the direction
    '= if the player is behind it
    '=
    '===============
    Sub FirstSighting (ob As Integer)
        '
        ' react to the player
        '
        Select Case objlist(ob).obclass
            Case guardobj
                PlaySoundLocActor HALTSND, ob
                NewState ob, s_grdchase1
                objlist(ob).speed = objlist(ob).speed * 3 ' go faster when chasing player

            Case officerobj
                PlaySoundLocActor SPIONSND, ob
                NewState ob, s_ofcchase1
                objlist(ob).speed = objlist(ob).speed * 5 ' go faster when chasing player

            Case mutantobj
                NewState ob, s_mutchase1
                objlist(ob).speed = objlist(ob).speed * 3 ' go faster when chasing player

            Case ssobj
                PlaySoundLocActor SCHUTZADSND, ob
                NewState ob, s_sschase1
                objlist(ob).speed = objlist(ob).speed * 4 ' go faster when chasing player

            Case dogobj
                PlaySoundLocActor DOGBARKSND, ob
                NewState ob, s_dogchase1
                objlist(ob).speed = objlist(ob).speed * 2 ' go faster when chasing player

            Case Else
                FirstSightingBoss ob
        End Select

        If objlist(ob).distance < 0 Then objlist(ob).distance = 0 ' ignore the door opening command

        objlist(ob).flags = objlist(ob).flags Or FL_ATTACKMODE Or FL_FIRSTATTACK
    End Sub

    ' The boss cases of FirstSighting (a $If between Case lines breaks Select Case)
    Sub FirstSightingBoss (ob As Integer)
        Dim played As Integer

        $If SPEAR = UNDEFINED Then
            Select Case objlist(ob).obclass
                Case bossobj
                    played = SD_PlaySound(GUTENTAGSND)
                    NewState ob, s_bosschase1
                    objlist(ob).speed = SPDPATROL * 3 ' go faster when chasing player

                Case gretelobj
                    played = SD_PlaySound(KEINSND)
                    NewState ob, s_gretelchase1
                    objlist(ob).speed = objlist(ob).speed * 3

                Case giftobj
                    played = SD_PlaySound(EINESND)
                    NewState ob, s_giftchase1
                    objlist(ob).speed = objlist(ob).speed * 3

                Case fatobj
                    played = SD_PlaySound(ERLAUBENSND)
                    NewState ob, s_fatchase1
                    objlist(ob).speed = objlist(ob).speed * 3

                Case schabbobj
                    played = SD_PlaySound(SCHABBSHASND)
                    NewState ob, s_schabbchase1
                    objlist(ob).speed = objlist(ob).speed * 3

                Case fakeobj
                    played = SD_PlaySound(TOT_HUNDSND)
                    NewState ob, s_fakechase1
                    objlist(ob).speed = objlist(ob).speed * 3

                Case mechahitlerobj
                    played = SD_PlaySound(DIESND)
                    NewState ob, s_mechachase1
                    objlist(ob).speed = objlist(ob).speed * 3

                Case realhitlerobj
                    played = SD_PlaySound(DIESND)
                    NewState ob, s_hitlerchase1
                    objlist(ob).speed = objlist(ob).speed * 5

                Case ghostobj
                    NewState ob, s_blinkychase1
                    objlist(ob).speed = objlist(ob).speed * 2
            End Select
        $Else
                Select Case objlist(ob).obclass
                Case spectreobj
                played = SD_PlaySound(GHOSTSIGHTSND)
                NewState ob, s_spectrechase1
                objlist(ob).speed = 800 ' go faster when chasing player

                Case angelobj
                played = SD_PlaySound(ANGELSIGHTSND)
                NewState ob, s_angelchase1
                objlist(ob).speed = 1536

                Case transobj
                played = SD_PlaySound(TRANSSIGHTSND)
                NewState ob, s_transchase1
                objlist(ob).speed = 1536

                Case uberobj
                NewState ob, s_uberchase1
                objlist(ob).speed = 3000

                Case willobj
                played = SD_PlaySound(WILHELMSIGHTSND)
                NewState ob, s_willchase1
                objlist(ob).speed = 2048

                Case deathobj
                played = SD_PlaySound(KNIGHTSIGHTSND)
                NewState ob, s_deathchase1
                objlist(ob).speed = 2048
                End Select
        $End If
    End Sub

    '===============
    '=
    '= SightPlayer
    '=
    '= Called by actors that ARE NOT chasing the player.  If the player
    '= is detected (by sight, noise, or proximity), the actor is put into
    '= it's combat frame and true is returned.
    '=
    '= Incorporates a random reaction delay
    '=
    '===============
    Function SightPlayer% (ob As Integer)
        SightPlayer% = FALSE

        If objlist(ob).flags And FL_ATTACKMODE Then Quit "An actor in ATTACKMODE called SightPlayer!"

        If objlist(ob).temp2 Then
            '
            ' count down reaction time
            '
            objlist(ob).temp2 = objlist(ob).temp2 - tics
            If objlist(ob).temp2 > 0 Then Exit Function
            objlist(ob).temp2 = 0 ' time to react
        Else
            If Not areabyplayer(objlist(ob).areanumber) Then Exit Function

            If objlist(ob).flags And FL_AMBUSH Then
                If Not CheckSight(ob) Then Exit Function
                objlist(ob).flags = objlist(ob).flags And (Not FL_AMBUSH)
            Else
                If Not madenoise Then ' C: !madenoise && !CheckSight (ob)
                    If Not CheckSight(ob) Then Exit Function
                End If
            End If

            Select Case objlist(ob).obclass
                Case guardobj
                    objlist(ob).temp2 = 1 + US_RndT \ 4
                Case officerobj
                    objlist(ob).temp2 = 2
                Case mutantobj
                    objlist(ob).temp2 = 1 + US_RndT \ 6
                Case ssobj
                    objlist(ob).temp2 = 1 + US_RndT \ 6
                Case dogobj
                    objlist(ob).temp2 = 1 + US_RndT \ 8

                Case bossobj, schabbobj, fakeobj, mechahitlerobj, realhitlerobj, gretelobj, giftobj, fatobj, spectreobj, angelobj, transobj, uberobj, willobj, deathobj
                    objlist(ob).temp2 = 1
            End Select
            Exit Function
        End If

        FirstSighting ob

        SightPlayer% = TRUE
    End Function

    ' One state: statetype s = {rotate, shapenum, tictime, think, action, next}
    Sub SetState (s As Integer, rotate As Integer, shapenum As Integer, tictime As Integer, think As Integer, action As Integer, nextstate As Integer)
        states(s).rotate = rotate
        states(s).shapenum = shapenum
        states(s).tictime = tictime
        states(s).think = think
        states(s).action = action
        states(s).nextstate = nextstate
    End Sub

    ' The statetype initializers of the C files (generated by gen_states.py)
    ' statetype s = {rotate, shapenum, tictime, think, action, next}
    Sub InitStates ()
        ' WL_AGENT.C
        SetState s_player, 0, 0, 0, RT_T_PLAYER, RT_NONE, 0
        SetState s_attack, 0, 0, 0, RT_T_ATTACK, RT_NONE, 0
        ' WL_ACT2.C
        SetState s_rocket, 1, SPR_ROCKET_1, 3, RT_T_PROJECTILE, RT_A_SMOKE, s_rocket
        SetState s_smoke1, 0, SPR_SMOKE_1, 3, RT_NONE, RT_NONE, s_smoke2
        SetState s_smoke2, 0, SPR_SMOKE_2, 3, RT_NONE, RT_NONE, s_smoke3
        SetState s_smoke3, 0, SPR_SMOKE_3, 3, RT_NONE, RT_NONE, s_smoke4
        SetState s_smoke4, 0, SPR_SMOKE_4, 3, RT_NONE, RT_NONE, 0
        SetState s_boom1, 0, SPR_BOOM_1, 6, RT_NONE, RT_NONE, s_boom2
        SetState s_boom2, 0, SPR_BOOM_2, 6, RT_NONE, RT_NONE, s_boom3
        SetState s_boom3, 0, SPR_BOOM_3, 6, RT_NONE, RT_NONE, 0
        $If SPEAR = DEFINED Then
                SetState s_hrocket, 1, SPR_HROCKET_1, 3, RT_T_PROJECTILE, RT_A_SMOKE, s_hrocket
                SetState s_hsmoke1, 0, SPR_HSMOKE_1, 3, RT_NONE, RT_NONE, s_hsmoke2
                SetState s_hsmoke2, 0, SPR_HSMOKE_2, 3, RT_NONE, RT_NONE, s_hsmoke3
                SetState s_hsmoke3, 0, SPR_HSMOKE_3, 3, RT_NONE, RT_NONE, s_hsmoke4
                SetState s_hsmoke4, 0, SPR_HSMOKE_4, 3, RT_NONE, RT_NONE, 0
                SetState s_hboom1, 0, SPR_HBOOM_1, 6, RT_NONE, RT_NONE, s_hboom2
                SetState s_hboom2, 0, SPR_HBOOM_2, 6, RT_NONE, RT_NONE, s_hboom3
                SetState s_hboom3, 0, SPR_HBOOM_3, 6, RT_NONE, RT_NONE, 0
        $End If
        SetState s_grdstand, 1, SPR_GRD_S_1, 0, RT_T_STAND, RT_NONE, s_grdstand
        SetState s_grdpath1, 1, SPR_GRD_W1_1, 20, RT_T_PATH, RT_NONE, s_grdpath1s
        SetState s_grdpath1s, 1, SPR_GRD_W1_1, 5, RT_NONE, RT_NONE, s_grdpath2
        SetState s_grdpath2, 1, SPR_GRD_W2_1, 15, RT_T_PATH, RT_NONE, s_grdpath3
        SetState s_grdpath3, 1, SPR_GRD_W3_1, 20, RT_T_PATH, RT_NONE, s_grdpath3s
