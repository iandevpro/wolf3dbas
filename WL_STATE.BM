        SetState s_grddie4, 0, SPR_GRD_DEAD, 0, RT_NONE, RT_NONE, s_grddie4
        $If SPEAR = UNDEFINED Then
            SetState s_blinkychase1, 0, SPR_BLINKY_W1, 10, RT_T_GHOSTS, RT_NONE, s_blinkychase2
