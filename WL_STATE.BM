    End Sub

    ' Calls a think / action routine of a state (C function pointer) for object ob
    Sub CallStateRoutine (routine As Integer, ob As Integer)
        Select Case routine
            Case RT_T_PLAYER
                T_Player ob
            Case RT_T_ATTACK
                T_Attack ob
            Case RT_T_PROJECTILE
                T_Projectile ob
            Case RT_A_SMOKE
                A_Smoke ob
            Case RT_T_STAND
                T_Stand ob
            Case RT_T_PATH
                T_Path ob
            Case RT_T_SHOOT
                T_Shoot ob
            Case RT_T_CHASE
                T_Chase ob
            Case RT_A_DEATHSCREAM
                A_DeathScream ob
            Case RT_T_GHOSTS
                T_Ghosts ob
            Case RT_T_BITE
                T_Bite ob
            Case RT_T_DOGCHASE
                T_DogChase ob
            Case RT_A_SLURPIE
                A_Slurpie ob
            Case RT_T_SCHABB
                T_Schabb ob
            Case RT_A_STARTDEATHCAM
                A_StartDeathCam ob
            Case RT_T_SCHABBTHROW
                T_SchabbThrow ob
            Case RT_T_GIFT
                T_Gift ob
            Case RT_T_GIFTTHROW
                T_GiftThrow ob
            Case RT_T_FAT
                T_Fat ob
            Case RT_T_FAKE
                T_Fake ob
            Case RT_T_FAKEFIRE
                T_FakeFire ob
            Case RT_A_MECHASOUND
                A_MechaSound ob
            Case RT_A_HITLERMORPH
                A_HitlerMorph ob
            Case RT_T_BJRUN
                T_BJRun ob
            Case RT_T_BJJUMP
                T_BJJump ob
            Case RT_T_BJYELL
                T_BJYell ob
            Case RT_T_BJDONE
                T_BJDone ob
            Case Else
                ' not ported (Spear of Destiny actors): T_UShoot, T_Will, T_Launch, A_Victory, A_StartAttack, A_Relaunch, A_Breathing, A_Dormant
        End Select
    End Sub

$End If
