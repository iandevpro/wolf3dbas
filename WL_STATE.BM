        SetState s_grdpath4, 1, SPR_GRD_W4_1, 15, RT_T_PATH, RT_NONE, s_grdpath1
        SetState s_grdpain, 2, SPR_GRD_PAIN_1, 10, RT_NONE, RT_NONE, s_grdchase1
        SetState s_grdpain1, 2, SPR_GRD_PAIN_2, 10, RT_NONE, RT_NONE, s_grdchase1
        SetState s_grdshoot1, 0, SPR_GRD_SHOOT1, 20, RT_NONE, RT_NONE, s_grdshoot2
