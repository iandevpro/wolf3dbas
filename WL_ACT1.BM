' WL_ACT1.C - static objects, doors, push walls
' Statics, doors and push walls (steps 6c / 6e / 6f)

$If INCLUDE_WL_ACT1_BM = UNDEFINED Then
    $Let INCLUDE_WL_ACT1_BM = 1

    '$INCLUDE: 'WL_ACT1.BI'

    ' One statinfo[] entry (the table is filled in WL_ACT1.BI)
    Sub StatInfo (picnum As Integer, stype As Integer, n As Integer)
        statpicnum(n) = picnum
        stattype(n) = stype
        n = n + 1
    End Sub

    '===============
    '=
    '= InitStaticList
    '=
    '===============
    Sub InitStaticList ()
        laststatobj = 0 ' &statobjlist[0]
    End Sub

    '===============
    '=
    '= SpawnStatic
    '=
    '===============
    Sub SpawnStatic (tilex As Integer, tiley As Integer, ttype As Integer)
        statobjlist(laststatobj).shapenum = statpicnum(ttype)
        statobjlist(laststatobj).tilex = tilex
        statobjlist(laststatobj).tiley = tiley
        statobjlist(laststatobj).visspot = tilex * MAPSIZE + tiley ' &spotvis[tilex][tiley]

        Select Case stattype(ttype)
            Case block
                actorat(tilex, tiley) = 1 ' consider it a blocking tile
                statobjlist(laststatobj).flags = 0

            Case dressing
                statobjlist(laststatobj).flags = 0

            Case bo_cross, bo_chalice, bo_bible, bo_crown, bo_fullheal
                If Not loadedgame Then gamestate.treasuretotal = gamestate.treasuretotal + 1
                statobjlist(laststatobj).flags = FL_BONUS
                statobjlist(laststatobj).itemnumber = stattype(ttype)

            Case bo_firstaid, bo_key1, bo_key2, bo_key3, bo_key4, bo_clip, bo_25clip, bo_machinegun, bo_chaingun, bo_food, bo_alpo, bo_gibs, bo_spear
                statobjlist(laststatobj).flags = FL_BONUS
                statobjlist(laststatobj).itemnumber = stattype(ttype)
        End Select

        laststatobj = laststatobj + 1

        If laststatobj = MAXSTATS Then Quit "Too many static objects!" + Chr$(10)
    End Sub

    '===============
    '=
    '= PlaceItemType
    '=
    '= Called during game play to drop actors' items.  It finds the proper
    '= item number based on the item type (bo_???).  If there are no free item
    '= spots, nothing is done.
    '=
    '===============
    Sub PlaceItemType (itemtype As Integer, tilex As Integer, tiley As Integer)
        Dim ttype As Integer, spot As Integer

        '
        ' find the item number
        '
        ttype = 0
        Do
            If statpicnum(ttype) = -1 Then Quit "PlaceItemType: couldn't find type!" ' end of list
            If stattype(ttype) = itemtype Then Exit Do
            ttype = ttype + 1
        Loop

        '
        ' find a spot in statobjlist to put it in
        '
        spot = 0
        Do
            If spot = laststatobj Then
                If spot = MAXSTATS Then Exit Sub ' no free spots
                laststatobj = laststatobj + 1 ' space at end
                Exit Do
            End If

            If statobjlist(spot).shapenum = -1 Then Exit Do ' -1 is a free spot
            spot = spot + 1
        Loop

        '
        ' place it
        '
        statobjlist(spot).shapenum = statpicnum(ttype)
        statobjlist(spot).tilex = tilex
        statobjlist(spot).tiley = tiley
        statobjlist(spot).visspot = tilex * MAPSIZE + tiley ' &spotvis[tilex][tiley]
        statobjlist(spot).flags = FL_BONUS
        statobjlist(spot).itemnumber = stattype(ttype)
    End Sub

    '
    ' =============================================================================
    '                              DOORS
    ' =============================================================================
    '

    '==============
    '=
    '= ConnectAreas
    '=
    '= Scans outward from playerarea, marking all connected areas
    '=
    '==============
    Sub RecursiveConnect (areanumber As Integer)
        Dim i As Integer

        For i = 0 To NUMAREAS - 1
            If areaconnect(areanumber, i) <> 0 And areabyplayer(i) = 0 Then
                areabyplayer(i) = TRUE
                RecursiveConnect i
            End If
        Next i
    End Sub

    ' memset (areabyplayer,0,sizeof(areabyplayer)) - Erase would free these arrays in QB64
    Sub ClearAreaByPlayer ()
        Dim i As Integer
        For i = 0 To NUMAREAS - 1
            areabyplayer(i) = FALSE
        Next i
    End Sub

    Sub ConnectAreas ()
        ClearAreaByPlayer
        areabyplayer(objlist(player).areanumber) = TRUE
        RecursiveConnect objlist(player).areanumber
    End Sub

    Sub InitAreas ()
        ClearAreaByPlayer
        areabyplayer(objlist(player).areanumber) = TRUE
    End Sub

    '===============
    '=
    '= InitDoorList
    '=
    '===============
    Sub InitDoorList ()
        Dim i As Integer, j As Integer

        ClearAreaByPlayer ' memset (areabyplayer,0,sizeof(areabyplayer))
        For i = 0 To NUMAREAS - 1 ' _fmemset (areaconnect,0,sizeof(areaconnect))
            For j = 0 To NUMAREAS - 1
                areaconnect(i, j) = 0
            Next j
        Next i

        lastdoorobj = 0 ' &doorobjlist[0]
        doornum = 0
    End Sub

    '===============
    '=
    '= SpawnDoor
    '=
    '===============
    Sub SpawnDoor (tilex As Integer, tiley As Integer, vertical As Integer, doorlock As Integer)
        Dim mapidx As Long

        If doornum = 64 Then Quit "64+ doors on level!"

        doorposition(doornum) = 0 ' doors start out fully closed
        doorobjlist(lastdoorobj).tilex = tilex
        doorobjlist(lastdoorobj).tiley = tiley
        doorobjlist(lastdoorobj).vertical = vertical
        doorobjlist(lastdoorobj).doorlock = doorlock
        doorobjlist(lastdoorobj).action = dr_closed

        actorat(tilex, tiley) = doornum Or &H80 ' consider it a solid wall

        '
        ' make the door tile a special tile, and mark the adjacent tiles
        ' for door sides
        '
        tilemap(tilex, tiley) = doornum Or &H80
        mapidx = tiley * 64 + tilex ' mapsegs[0] + farmapylookup[tiley] + tilex
        If vertical Then
            mapsegs(0, mapidx) = mapsegs(0, mapidx - 1) ' set area number
            tilemap(tilex, tiley - 1) = tilemap(tilex, tiley - 1) Or &H40
            tilemap(tilex, tiley + 1) = tilemap(tilex, tiley + 1) Or &H40
        Else
            mapsegs(0, mapidx) = mapsegs(0, mapidx - mapwidth) ' set area number
            tilemap(tilex - 1, tiley) = tilemap(tilex - 1, tiley) Or &H40
            tilemap(tilex + 1, tiley) = tilemap(tilex + 1, tiley) Or &H40
        End If

        doornum = doornum + 1
        lastdoorobj = lastdoorobj + 1
    End Sub

    '=====================
    '=
    '= OpenDoor
    '=
    '=====================
    Sub OpenDoor (door As Integer)
        If doorobjlist(door).action = dr_open Then
            doorobjlist(door).ticcount = 0 ' reset open time
        Else
            doorobjlist(door).action = dr_opening ' start it opening
        End If
    End Sub

    ' The x / y of the actor in an actorat() value, for CloseDoor's check->x / check->y.
    ' TRUE when it is an object. (C also dereferenced wall and static values as pointers,
    ' reading whatever was there; here they never block the door.)
    Function ActorAtObject% (check As Integer)
        ActorAtObject% = (check >= OBJ_BASE)
    End Function

    '=====================
    '=
    '= CloseDoor
    '=
    '=====================
    Sub CloseDoor (door As Integer)
        Dim tilex As Integer, tiley As Integer, area As Integer, check As Integer

        '
        ' don't close on anything solid
        '
        tilex = doorobjlist(door).tilex
        tiley = doorobjlist(door).tiley

        If actorat(tilex, tiley) Then Exit Sub

        If objlist(player).tilex = tilex And objlist(player).tiley = tiley Then Exit Sub

        If doorobjlist(door).vertical Then
            If objlist(player).tiley = tiley Then
                If SarL(objlist(player).x + MINDIST, TILESHIFT) = tilex Then Exit Sub
                If SarL(objlist(player).x - MINDIST, TILESHIFT) = tilex Then Exit Sub
            End If
            check = actorat(tilex - 1, tiley)
            If ActorAtObject(check) Then
                If SarL(objlist(check - OBJ_BASE).x + MINDIST, TILESHIFT) = tilex Then Exit Sub
            End If
            check = actorat(tilex + 1, tiley)
            If ActorAtObject(check) Then
                If SarL(objlist(check - OBJ_BASE).x - MINDIST, TILESHIFT) = tilex Then Exit Sub
            End If
        Else
            If objlist(player).tilex = tilex Then
                If SarL(objlist(player).y + MINDIST, TILESHIFT) = tiley Then Exit Sub
                If SarL(objlist(player).y - MINDIST, TILESHIFT) = tiley Then Exit Sub
            End If
            check = actorat(tilex, tiley - 1)
            If ActorAtObject(check) Then
                If SarL(objlist(check - OBJ_BASE).y + MINDIST, TILESHIFT) = tiley Then Exit Sub
            End If
            check = actorat(tilex, tiley + 1)
            If ActorAtObject(check) Then
                If SarL(objlist(check - OBJ_BASE).y - MINDIST, TILESHIFT) = tiley Then Exit Sub
            End If
        End If

        '
        ' play door sound if in a connected area
        '
        area = mapsegs(0, doorobjlist(door).tiley * 64 + doorobjlist(door).tilex) - AREATILE
        If areabyplayer(area) Then
            PlaySoundLocTile CLOSEDOORSND, doorobjlist(door).tilex, doorobjlist(door).tiley ' JAB
        End If

        doorobjlist(door).action = dr_closing
        '
        ' make the door space solid
        '
        actorat(tilex, tiley) = door Or &H80
    End Sub

    '=====================
    '=
    '= OperateDoor
    '=
    '= The player wants to change the door's direction
    '=
    '=====================
    Sub OperateDoor (door As Integer)
        Dim doorlock As Integer, played As Integer

        doorlock = doorobjlist(door).doorlock
        If doorlock >= dr_lock1 And doorlock <= dr_lock4 Then
            If (gamestate.keys And (2 ^ (doorlock - dr_lock1))) = 0 Then
                played = SD_PlaySound(NOWAYSND) ' locked
                Exit Sub
            End If
        End If

        Select Case doorobjlist(door).action
            Case dr_closed, dr_closing
                OpenDoor door
            Case dr_open, dr_opening
                CloseDoor door
        End Select
    End Sub

    '===============
    '=
    '= DoorOpen
    '=
    '= Close the door after three seconds
    '=
    '===============
    Sub DoorOpen (door As Integer)
        doorobjlist(door).ticcount = doorobjlist(door).ticcount + tics
        If doorobjlist(door).ticcount >= OPENTICS Then CloseDoor door
    End Sub

    ' The two areas a door connects: the map tiles at both sides of it
    Sub DoorAreas (door As Integer, area1 As Integer, area2 As Integer)
        Dim map As Long

        map = doorobjlist(door).tiley * 64 + doorobjlist(door).tilex ' mapsegs[0]+farmapylookup[tiley]+tilex

        If doorobjlist(door).vertical Then
            area1 = mapsegs(0, map + 1)
            area2 = mapsegs(0, map - 1)
        Else
            area1 = mapsegs(0, map - mapwidth)
            area2 = mapsegs(0, map + mapwidth)
        End If
        area1 = area1 - AREATILE
        area2 = area2 - AREATILE
    End Sub

    '===============
    '=
    '= DoorOpening
    '=
    '===============
    Sub DoorOpening (door As Integer)
        Dim area1 As Integer, area2 As Integer
        Dim position As Long

        position = doorposition(door)
        If position = 0 Then
            '
            ' door is just starting to open, so connect the areas
            '
            DoorAreas door, area1, area2
            areaconnect(area1, area2) = areaconnect(area1, area2) + 1
            areaconnect(area2, area1) = areaconnect(area2, area1) + 1
            ConnectAreas
            If areabyplayer(area1) Then
                PlaySoundLocTile OPENDOORSND, doorobjlist(door).tilex, doorobjlist(door).tiley ' JAB
            End If
        End If

        '
        ' slide the door by an adaptive amount
        '
        position = position + tics * 1024 ' tics<<10
        If position >= &HFFFF& Then
            '
            ' door is all the way open
            '
            position = &HFFFF&
            doorobjlist(door).ticcount = 0
            doorobjlist(door).action = dr_open
            actorat(doorobjlist(door).tilex, doorobjlist(door).tiley) = 0
        End If

        doorposition(door) = position
    End Sub

    '===============
    '=
    '= DoorClosing
    '=
    '===============
    Sub DoorClosing (door As Integer)
        Dim area1 As Integer, area2 As Integer
        Dim position As Long
        Dim tilex As Integer, tiley As Integer

        tilex = doorobjlist(door).tilex
        tiley = doorobjlist(door).tiley

        If actorat(tilex, tiley) <> (door Or &H80) Or (objlist(player).tilex = tilex And objlist(player).tiley = tiley) Then
            ' something got inside the door
            OpenDoor door
            Exit Sub
        End If

        position = doorposition(door)

        '
        ' slide the door by an adaptive amount
        '
        position = position - tics * 1024 ' tics<<10
        If position <= 0 Then
            '
            ' door is closed all the way, so disconnect the areas
            '
            position = 0

            doorobjlist(door).action = dr_closed

            DoorAreas door, area1, area2
            areaconnect(area1, area2) = areaconnect(area1, area2) - 1
            areaconnect(area2, area1) = areaconnect(area2, area1) - 1

            ConnectAreas
        End If

        doorposition(door) = position
    End Sub

    '=====================
    '=
    '= MoveDoors
    '=
    '= Called from PlayLoop
    '=
    '=====================
    Sub MoveDoors ()
        Dim door As Integer

        If gamestate.victoryflag Then Exit Sub ' don't move door during victory sequence

        For door = 0 To doornum - 1
            Select Case doorobjlist(door).action
                Case dr_open
                    DoorOpen door

                Case dr_opening
                    DoorOpening door

                Case dr_closing
                    DoorClosing door
            End Select
        Next door
    End Sub

    '
    ' =============================================================================
    '                          PUSHABLE WALLS
    ' =============================================================================
    '

    ' One step of a push wall: TRUE when the tile (x, y) is free, then the wall moves into it
    Function PushWallInto% (x As Integer, y As Integer, tile As Integer)
        If actorat(x, y) Then
            PushWallInto% = FALSE
            Exit Function
        End If
        tilemap(x, y) = tile
        actorat(x, y) = tile
        PushWallInto% = TRUE
    End Function

    '===============
    '=
    '= PushWall
    '=
    '===============
    Sub PushWall (checkx As Integer, checky As Integer, dir As Integer)
        Dim oldtile As Integer, moved As Integer, played As Integer

        If pwallstate Then Exit Sub

        oldtile = tilemap(checkx, checky)
        If oldtile = 0 Then Exit Sub

        Select Case dir
            Case di_north
                moved = PushWallInto(checkx, checky - 1, oldtile)
            Case di_east
                moved = PushWallInto(checkx + 1, checky, oldtile)
            Case di_south
                moved = PushWallInto(checkx, checky + 1, oldtile)
            Case di_west
                moved = PushWallInto(checkx - 1, checky, oldtile)
        End Select
        If Not moved Then
            played = SD_PlaySound(NOWAYSND)
            Exit Sub
        End If

        gamestate.secretcount = gamestate.secretcount + 1
        pwallx = checkx
        pwally = checky
        pwalldir = dir
        pwallstate = 1
        pwallpos = 0
        tilemap(pwallx, pwally) = tilemap(pwallx, pwally) Or &HC0
        mapsegs(1, pwally * 64 + pwallx) = 0 ' remove P tile info

        played = SD_PlaySound(PUSHWALLSND)
    End Sub

    '=================
    '=
    '= MovePWalls
    '=
    '=================
    Sub MovePWalls ()
        Dim oldblock As Long, oldtile As Integer, moved As Integer

        If pwallstate = 0 Then Exit Sub

        oldblock = pwallstate \ 128

        pwallstate = pwallstate + tics

        If pwallstate \ 128 <> oldblock Then
            ' block crossed into a new block
            oldtile = tilemap(pwallx, pwally) And 63

            '
            ' the tile can now be walked into
            '
            tilemap(pwallx, pwally) = 0
            actorat(pwallx, pwally) = 0
            mapsegs(0, pwally * 64 + pwallx) = objlist(player).areanumber + AREATILE

            '
            ' see if it should be pushed farther
            '
            If pwallstate > 256 Then
                '
                ' the block has been pushed two tiles
                '
                pwallstate = 0
                Exit Sub
            Else
                Select Case pwalldir
                    Case di_north
                        pwally = pwally - 1
                        moved = PushWallInto(pwallx, pwally - 1, oldtile)
                    Case di_east
                        pwallx = pwallx + 1
                        moved = PushWallInto(pwallx + 1, pwally, oldtile)
                    Case di_south
                        pwally = pwally + 1
                        moved = PushWallInto(pwallx, pwally + 1, oldtile)
                    Case di_west
                        pwallx = pwallx - 1
                        moved = PushWallInto(pwallx - 1, pwally, oldtile)
                End Select
                If Not moved Then
                    pwallstate = 0
                    Exit Sub
                End If

                tilemap(pwallx, pwally) = oldtile Or &HC0
            End If
        End If

        pwallpos = (pwallstate \ 2) And 63
    End Sub

$EndIf
