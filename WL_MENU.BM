Sub ClearMScreen ()
    $If SPEAR = UNDEFINED Then
        ' Call VWB_Bar to fill the screen with BORDCOLOR
        Call VWB_Bar(0, 0, 320, 200, BORDCOLOR)
        '    ELSE
        '' Load and draw an image for C_BACKDROPPIC (adjust path as needed)
        'DIM img AS INTEGER
        'img = _LOADIMAGE("path_to_C_BACKDROPPIC.png")
        'IF img THEN
        '_DRAWIMAGE (0, 0), img
        'END IF
    $End If
End Sub

