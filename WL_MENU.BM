        fontnumber = 1

        IN_Ack

        StartCPMusic MENUSONG
        MenuFadeOut
    End Sub

    '////////////////////////////////////////////////////////////////////
    '//
    '// Load / save, ported in step 5c
    '//
    '////////////////////////////////////////////////////////////////////
    '////////////////////////////////////////////////////////////////////
    '//
    '// START A NEW GAME
    '//
    '////////////////////////////////////////////////////////////////////
    Sub CP_NewGame ()
        Dim which As Integer, episode As Integer

        $If SPEAR = UNDEFINED Then
            Do ' firstpart:
                DrawNewEpisode

                Do
                    which = HandleMenu(NewEitems, NewEmenu(), DRAWRTN_NONE)
                    Select Case which
                        Case -1
                            MenuFadeOut
                            Exit Sub

                        Case Else
                            If EpisodeSelect(which \ 2) = 0 Then
                                CP_PlaySound NOWAYSND
                                Message "Please select " + Chr$(34) + "Read This!" + Chr$(34) + Chr$(10) + "from the Options menu to" + Chr$(10) + "find out how to order this" + Chr$(10) + "episode from Apogee."
                                IN_ClearKeysDown
                                IN_Ack
                                DrawNewEpisode
                                which = 0
                            Else
                                episode = which \ 2
                                which = 1
                            End If
                    End Select
                Loop While which = 0

                CP_ShootSnd

                '
                ' ALREADY IN A GAME?
                '
                If ingame Then
                    If Confirm(CURGAME) = 0 Then
                        MenuFadeOut
                        Exit Sub
                    End If
                End If

                MenuFadeOut

                DrawNewGame
                which = HandleMenu(NewItems, NewMenu(), DRAWRTN_NEWGAMEDIFF)
                If which >= 0 Then Exit Do
                MenuFadeOut ' goto firstpart
            Loop
        $Else
            ' TODO: SPEAR new game (NEWGAME lumps, no episode selection)
            Exit Sub
        $End If

        CP_ShootSnd
        NewGame which, episode
        StartGameMenu = 1
        MenuFadeOut

        '
        ' CHANGE "READ THIS!" TO NORMAL COLOR
        '
        $If READTHIS_ITEM = 1 Then
            MainMenu(mi_readthis).active = 1
        $End If

        pickquick = 0
    End Sub

