    Sub DrawStripes (y As Integer)
        $If SPEAR = UNDEFINED Then
            VL_Bar 0, y, 320, 24, 0
            VWB_Hlin 0, 319, y + 22, STRIPE
        $Else
                VL_Bar 0, y, 320, 22, 0
                VWB_Hlin 0, 319, y + 23, 0
        $End If
    End Sub

    Sub CheckForEpisodes
        Dim fileExists As Integer
        Dim i As Integer
        Dim testFile As String

        ' Check for full version (WL6)
        fileExists = 0
        testFile = "VSWAP.WL6"
        If _FileExists(testFile) Then fileExists = 1

        EpisodeSelect(0) = 1 ' int EpisodeSelect[6]={1}; episode 1 is always there

        If fileExists Then
            extension = "WL6"
            ' Enable all episodes
            For i = 1 To 5
                EpisodeSelect(i) = 1
            Next i
        Else
            ' Check for shareware version (WL1)
            testFile = "VSWAP.WL1"
            If _FileExists(testFile) Then
                extension = "WL1"
            Else
                Print "NO WOLFENSTEIN 3-D DATA FILES TO BE FOUND!"
                Print "Please ensure VSWAP.WL1 or VSWAP.WL6 is in the current directory."
                End
            End If
        End If

        ' Append extension to all file names
        configname = configname + extension
        SaveName = SaveName + extension
        PageFileName = PageFileName + extension
        audioname = audioname + extension
        demoname = demoname + extension
        ' TODO
        '#ifdef SPEAR
        '#ifndef SPEARDEMO
        '   if (!findfirst("*.SOD",&f,FA_ARCH))
        '   {
        '       strcpy(extension,"SOD");
        '   }
    End Sub

    Sub StartCPMusic (song As Integer)
        Dim chunk As Integer
        Dim tempPtr As _Offset

        ' Stop music first (orig C does it after freeing), so the sequencer no longer reads the freed chunk
        SD_MusicOff

        ' Free previous music if it exists
        CA_FreeAudioChunk STARTMUSIC + lastmusic_gbl
        lastmusic_gbl = song

        chunk = song

        MM_BombOnError FALSE
        CA_CacheAudioChunk STARTMUSIC + chunk
        MM_BombOnError TRUE
        If audiosegs(STARTMUSIC + chunk) = 0 Then Exit Sub

        tempPtr = audiosegs(STARTMUSIC + chunk)
        MM_SetLock tempPtr, TRUE
        SD_StartMusic audiosegMem(STARTMUSIC + chunk)
    End Sub


    ' #define MenuFadeOut()	VL_FadeOut(0,255,43,0,0,10)
    Sub MenuFadeOut ()
        $If SPEAR = UNDEFINED Then
            VL_FadeOut 0, 255, 43, 0, 0, 10
        $Else
            VL_FadeOut 0, 255, 0, 0, 51, 10
        $End If
    End Sub

    ' #define MenuFadeIn()	VL_FadeIn(0,255,&gamepal,10)
    Sub MenuFadeIn ()
        VL_FadeIn 0, 255, gamepal(), 10
    End Sub

    ' Calls the routine of a menu item (the C function pointers)
    Sub CP_CallRoutine (rtn As Integer)
        Dim result As Integer

        Select Case rtn
            Case RTN_NEWGAME
                CP_NewGame
            Case RTN_SOUND
                CP_Sound
            Case RTN_CONTROL
                CP_Control
            Case RTN_LOADGAME
                result = CP_LoadGame(0)
            Case RTN_SAVEGAME
                result = CP_SaveGame(0)
            Case RTN_CHANGEVIEW
                CP_ChangeView
            Case RTN_READTHIS
                CP_ReadThis
            Case RTN_VIEWSCORES
                CP_ViewScores
            Case RTN_MOUSESENS
                MouseSensitivity
            Case RTN_CUSTOMIZE
                CustomControls
        End Select
    End Sub

    ' Calls the custom draw routine passed to HandleMenu
    Sub CP_CallDrawRoutine (rtn As Integer, w As Integer)
        Select Case rtn
            Case DRAWRTN_NEWGAMEDIFF
                DrawNewGameDiff w
            Case DRAWRTN_FIXUPCUSTOM
                FixupCustom w
                ' TODO: TrackWhichGame with load / save (step 5c)
        End Select
    End Sub

    '////////////////////////////////////////////////////////////////////
    '//
    '// Wolfenstein Control Panel!  Ta Da!
    '//
    '////////////////////////////////////////////////////////////////////
    Sub US_ControlPanel (scancode As Integer)
        Dim which As Integer, result As Integer

        If ingame Then
            If CP_CheckQuick(scancode) Then Exit Sub
        End If

        StartCPMusic MENUSONG
        SetupControlPanel

        '
        ' F-KEYS FROM WITHIN GAME
        '
        Select Case scancode
            Case sc_F1, sc_F2, sc_F3, sc_F4, sc_F5, sc_F6
                Select Case scancode
                    Case sc_F1
                        ' TODO: HelpScreens (BossKey for SPEAR / GOODTIMES)
                    Case sc_F2
                        result = CP_SaveGame(0)
                    Case sc_F3
                        result = CP_LoadGame(0)
                    Case sc_F4
                        CP_Sound
                    Case sc_F5
                        CP_ChangeView
                    Case sc_F6
                        CP_Control
                End Select
                ' finishup:
                CleanupControlPanel
                Exit Sub
        End Select

        DrawMainMenu
        MenuFadeIn
        StartGameMenu = 0

        '
        ' MAIN MENU LOOP
        '
        Do
            which = HandleMenu(MainItems, MainMenu(), DRAWRTN_NONE)

            ' TODO: SPEAR easter egg (I + D keys)

            Select Case which
                Case mi_viewscores
                    If MainMenu(mi_viewscores).routine = RTN_NONE Then
                        If CP_EndGame Then StartGameMenu = 1
                    End If
                    DrawMainMenu
                    MenuFadeIn

                Case mi_backtodemo
                    StartGameMenu = 1
                    If Not ingame Then StartCPMusic INTROSONG
                    VL_FadeOut 0, 255, 0, 0, 0, 10

                Case -1, mi_quit
                    CP_Quit

                Case Else
                    If StartGameMenu = 0 Then
                        DrawMainMenu
                        MenuFadeIn
                    End If
            End Select

            '
            ' "EXIT OPTIONS" OR "NEW GAME" EXITS
            '
        Loop While StartGameMenu = 0

        '
        ' DEALLOCATE EVERYTHING
        '
        CleanupControlPanel

        '
        ' CHANGE MAINMENU ITEM
        '
        If startgame Or loadedgame Then
            MainMenu(mi_viewscores).routine = RTN_NONE
            MainMenu(mi_viewscores).txt = STR_EG
        End If
    End Sub

    '////////////////////////
    '//
    '// DRAW MAIN MENU SCREEN
    '//
    Sub DrawMainMenu ()
        ClearMScreen
        VWB_DrawPic 112, 184, C_MOUSELBACKPIC
        DrawStripes 10
        VWB_DrawPic 84, 0, C_OPTIONSPIC

        $If SPANISH = DEFINED Then
            DrawWindow MENU_X - 8, MENU_Y - 3, MENU_W + 8, MENU_H, BKGDCOLOR
        $Else
            DrawWindow MENU_X - 8, MENU_Y - 3, MENU_W, MENU_H, BKGDCOLOR
        $End If

        '
        ' CHANGE "GAME" AND "DEMO"
        '
        If ingame Then
            $If SPANISH = DEFINED Then
                MainMenu(mi_backtodemo).txt = STR_GAME
            $Else
                MainMenu(mi_backtodemo).txt = Left$(STR_BD, 8) + STR_GAME
            $End If
            MainMenu(mi_backtodemo).active = 2
        Else
            $If SPANISH = DEFINED Then
                MainMenu(mi_backtodemo).txt = STR_BD
            $Else
                MainMenu(mi_backtodemo).txt = Left$(STR_BD, 8) + STR_DEMO
            $End If
            MainMenu(mi_backtodemo).active = 1
        End If

        DrawMenu MainItems, MainMenu()
        VW_UpdateScreen
    End Sub

