    '////////////////////////////////////////////////////////////////////
    '//
    '// VIEW THE HIGH SCORES
    '//
    '////////////////////////////////////////////////////////////////////
    Sub CP_ViewScores ()
        fontnumber = 0

        $If SPEAR = DEFINED Then
            ' TODO: UnCacheLump OPTIONS_LUMP_START, OPTIONS_LUMP_END
            StartCPMusic XAWARD_MUS
        $Else
            StartCPMusic ROSTER_MUS
        $End If

        DrawHighScores
        VW_UpdateScreen
