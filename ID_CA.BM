    Sub CA_Startup ()
        $If PROFILE = DEFINED Then
                CLOSE "PROFILE.TXT"
                profilehandle = open("PROFILE.TXT", O_CREAT OR O_WRONLY OR O_TEXT)
        $End If

        CAL_SetupMapFile
        CAL_SetupGrFile
        CAL_SetupAudioFile

        mapon = -1
        ca_levelbit = 1
        ca_levelnum = 0
    End Sub

'$INCLUDE: 'ID_CA.BI'
$EndIf
