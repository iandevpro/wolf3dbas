' ID_CA.C
' simulate IFDEFs settings
$If INCLUDE_ID_CA_BM = UNDEFINED Then
    $Let INCLUDE_ID_CA_BM = 1

    Sub CAL_SetupMapFile ()
        ' Implementation of CAL_SetupMapFile in QB64 Basic
        Print "Setting up map file..."

    End Sub

    Sub CAL_SetupGrFile ()
        ' Implementation of CAL_SetupGrFile in QB64 Basic
        Print "Setting up graphics file..."
    End Sub

