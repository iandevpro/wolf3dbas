' ID_CA.C
' The headers and dictionaries are always read from their files: the C alternatives for
' headers linked into the exe (MAPHEADERLINKED, GRHEADERLINKED, AUDIOHEADERLINKED) are
' not ported, no version of the game defines them
' simulate IFDEFs settings
$If INCLUDE_ID_CA_BM = UNDEFINED Then
    $Let INCLUDE_ID_CA_BM = 1

    Sub CAL_SetupMapFile ()
        Dim i As Integer
        Dim handle As Long
        Dim length As Long
        ' pos - reserved keyword in QB64
        Dim position As Long
        Dim fname As String * 13
        Dim tempwidth As Integer, tempheight As Integer
        Dim tempname As String * 16
        Dim tempplanestart(0 To 2) As Long
        Dim tempplanelength(0 To 2) As _Unsigned Integer
        ' QB64 editor removed () from Dim fileBytes() As _Unsigned _Byte
        Dim fileBytes As _Unsigned _Byte

        ' Load maphead.ext (offsets and tileinfo for map file)
        fname = mheadname + extension

        handle = FreeFile
        Open fname For Binary As #handle
        If Err Then
            CA_CannotOpen fname
        End If

        ' Get file length and allocate memory
        length = LOF(handle)
        tinf = _MemNew(length)
        If tinf.SIZE = 0 Then
            Close #handle
            CA_CannotOpen "Memory allocation failed"
        End If

        ' Read file into a byte array, then copy to tinf
        ReDim fileBytes(0 To length - 1) As _Unsigned _Byte
        Get #handle, , fileBytes()
        _MemPut tinf, tinf.OFFSET, fileBytes()
        Close #handle
        RLEWtag = _MemGet(tinf, tinf.OFFSET, _Unsigned Integer) ' ((mapfiletype _seg *)tinf)->RLEWtag

        ' Open the data file
        $If CARMACIZED = DEFINED Then
            fname = "GAMEMAPS." + extension
        $Else
            fname = mfilename + extension
        $End If

        maphandle = FreeFile
        Open fname For Binary As #maphandle
        If Err Then
            CA_CannotOpen fname
        End If

        ' Load all map headers
        For i = 0 To NUMMAPS - 1
            ' Get header offset from tile info
            ' +2 bytes: unsigned int RLEWtag on the start of maptypeinfo C struct
            ' *4: maptypeinfo->long headeroffset[100]
            position = _MemGet(tinf, tinf.OFFSET + 2 + i * 4, Long)
            If position < 0 Then ' -1 indicates sparse map
                _Continue
            End If

            ' Seek to map header and read fields into arrays
            Seek #maphandle, position + 1 ' QB64 uses 1-based file positions
            Get #maphandle, , tempplanestart(0)
            Get #maphandle, , tempplanestart(1)
            Get #maphandle, , tempplanestart(2)
            Get #maphandle, , tempplanelength(0)
            Get #maphandle, , tempplanelength(1)
            Get #maphandle, , tempplanelength(2)
            Get #maphandle, , tempwidth
            Get #maphandle, , tempheight
            Get #maphandle, , tempname

            planestart(i, 0) = tempplanestart(0)
            planestart(i, 1) = tempplanestart(1)
            planestart(i, 2) = tempplanestart(2)
            planelength(i, 0) = tempplanelength(0)
            planelength(i, 1) = tempplanelength(1)
            planelength(i, 2) = tempplanelength(2)
            mapwidth(i) = tempwidth
            mapheight(i) = tempheight
            mapname(i) = tempname
        Next i

        ' The map planes (64x64 each) are the mapsegs() array, nothing to allocate
    End Sub

    '======================
    '=
    '= CAL_CarmackExpand
    '=
    '= Length is the length of the EXPANDED data
    '= source() holds bytes (from srcpos on), dest() receives words
    '=
    '======================
    Sub CAL_CarmackExpand (source() As _Unsigned _Byte, srcpos As Long, dest() As _Unsigned Integer, length As Long)
        Const NEARTAG = &HA7
        Const FARTAG = &HA8
        Dim ch As Long, chhigh As Long, count As Long, offset As Long
        Dim inptr As Long, outptr As Long, copyptr As Long, words As Long

        words = length \ 2
        inptr = srcpos
        outptr = 0

        Do While words > 0
            ch = source(inptr) + source(inptr + 1) * 256&
            inptr = inptr + 2
            chhigh = ch \ 256
            If chhigh = NEARTAG Then
                count = ch And &HFF
                If count = 0 Then
                    ' have to insert a word containing the tag byte
                    ch = ch Or source(inptr)
                    inptr = inptr + 1
                    dest(outptr) = ch
                    outptr = outptr + 1
                    words = words - 1
                Else
                    offset = source(inptr)
                    inptr = inptr + 1
                    copyptr = outptr - offset
                    words = words - count
                    Do While count > 0
                        dest(outptr) = dest(copyptr)
                        outptr = outptr + 1
                        copyptr = copyptr + 1
                        count = count - 1
                    Loop
                End If
            ElseIf chhigh = FARTAG Then
                count = ch And &HFF
                If count = 0 Then
                    ' have to insert a word containing the tag byte
                    ch = ch Or source(inptr)
                    inptr = inptr + 1
                    dest(outptr) = ch
                    outptr = outptr + 1
                    words = words - 1
                Else
                    offset = source(inptr) + source(inptr + 1) * 256&
                    inptr = inptr + 2
                    copyptr = offset ' dest + offset
                    words = words - count
                    Do While count > 0
                        dest(outptr) = dest(copyptr)
                        outptr = outptr + 1
                        copyptr = copyptr + 1
                        count = count - 1
                    Loop
                End If
            Else
                dest(outptr) = ch
                outptr = outptr + 1
                words = words - 1
            End If
        Loop
    End Sub

    '======================
    '=
    '= CA_RLEWexpand
    '=
    '= length is the EXPANDED length in bytes; source() words from srcpos on,
    '= expanded into map plane "plane" (the C version took any destination buffer,
    '= only the map planes use it)
    '=
    '======================
    Sub CA_RLEWexpand (source() As _Unsigned Integer, srcpos As Long, plane As Integer, length As Long, tag As Long) ' C: rlewtag, renamed: it clashes with the RLEWtag global
        Dim value As Long, count As Long, i As Long
        Dim si As Long, di As Long, dend As Long

        si = srcpos
        di = 0
        dend = length \ 2

        '
        ' expand it
        '
        Do While di < dend
            value = source(si)
            si = si + 1
            If value <> tag Then
                '
                ' uncompressed
                '
                mapsegs(plane, di) = value
                di = di + 1
            Else
                '
                ' compressed string
                '
                count = source(si)
                value = source(si + 1)
                si = si + 2
                For i = 1 To count
                    If di < dend Then mapsegs(plane, di) = value ' the original trusted the data
                    di = di + 1
                Next i
            End If
        Loop
    End Sub

    '======================
    '=
    '= CA_CacheMap
    '=
    '= WOLF does not use the huffman or carmack compression on the map planes,
    '= except with CARMACIZED (defined in VERSION.BI): GAMEMAPS is carmack + RLEW
    '=
    '======================
    Sub CA_CacheMap (mapnum As Integer)
        Dim position As Long, compressed As Long
        Dim plane As Integer
        Dim source As _Unsigned _Byte
        Dim buffer2seg As _Unsigned Integer
        Dim size As Long

        mapon = mapnum

        '
        ' load the planes into the allready allocated buffers
        '
        size = 64 * 64 * 2

        For plane = 0 To MAPPLANES - 1
            position = planestart(mapnum, plane)
            compressed = planelength(mapnum, plane)

            ReDim source(0 To compressed + 1) As _Unsigned _Byte ' 2 spare bytes at the end
            Seek #maphandle, position + 1 ' QB64 uses 1-based file positions
            Get #maphandle, , source() ' CA_FarRead

            $If CARMACIZED = DEFINED Then
                Dim expanded As Long
                '
                ' unhuffman, then unRLEW
                ' The huffman chunk has a two byte expanded length first
                ' The resulting RLEW chunk also does, even though it is not really
                ' needed
                '
                expanded = source(0) + source(1) * 256&
                ReDim buffer2seg(0 To expanded \ 2 + 2) As _Unsigned Integer
                CAL_CarmackExpand source(), 2, buffer2seg(), expanded
                CA_RLEWexpand buffer2seg(), 1, plane, size, RLEWtag
            $Else
                '
                ' unRLEW, skipping expanded length (the plane as words)
                '
                Dim i As Long
                ReDim buffer2seg(0 To compressed \ 2) As _Unsigned Integer
                For i = 0 To compressed \ 2 - 1: buffer2seg(i) = source(i * 2) + source(i * 2 + 1) * 256&: Next i
                CA_RLEWexpand buffer2seg(), 1, plane, size, RLEWtag
            $End If
        Next plane
    End Sub

    ' #define MAPSPOT(x,y,plane) (*(mapsegs[plane]+farmapylookup[y]+x))
    Function MAPSPOT& (x As Integer, y As Integer, plane As Integer)
        MAPSPOT& = mapsegs(plane, y * 64 + x)
    End Function

    Sub CAL_SetupGrFile ()
        Dim fname As String * 13
        Dim handle As Integer
        Dim compseg As _MEM, picseg As _MEM
        Dim i As Integer
        Dim fileBytes As _Unsigned _Byte

        ' Load ???dict.ext (huffman dictionary for graphics files)
        fname = gdictname + extension

        handle = FreeFile
        Open fname For Binary As #handle
        If Err Then
            CA_CannotOpen fname
        End If

        ' Read huffman dictionary
        Get #handle, , grhuffman()
        Close #handle
        CAL_OptimizeNodes grhuffman()

        ' Load the data offsets from ???head.ext
        grstarts = _MemNew((NUMCHUNKS + 1) * FILEPOSSIZE)
        If grstarts.SIZE = 0 Then
            CA_CannotOpen "Memory allocation failed for graphics starts"
        End If

        fname = gheadname + extension

        handle = FreeFile
        Open fname For Binary As #handle
        If Err Then
            CA_CannotOpen fname
        End If

        ' Read file into byte array, then copy to grstarts
        ReDim fileBytes(0 To (NUMCHUNKS + 1) * FILEPOSSIZE - 1) As _Unsigned _Byte
        Get #handle, , fileBytes()
        _MemPut grstarts, grstarts.OFFSET, fileBytes()
        Close #handle

        ' Open the graphics file, leaving it open until the game is finished
        fname = gfilename + extension

        grhandle = FreeFile
        Open fname For Binary As #grhandle
        If Err Then
            CA_CannotOpen fname
        End If

        ' Load the pic and sprite headers into the arrays in the data segment
        CAL_GetGrChunkLength STRUCTPIC ' Position file pointer
        ' Print "chunkcomplen"; chunkcomplen
        compseg = _MemNew(chunkcomplen)
        If compseg.SIZE = 0 Then
            CA_CannotOpen "Memory allocation failed for compressed segment"
        End If

        ' Read compressed data
        ReDim fileBytes(0 To chunkcomplen - 1) As _Unsigned _Byte
        Get #grhandle, , fileBytes()
        _MemPut compseg, compseg.OFFSET, fileBytes()

        ' Expand the data into pictable (NUMPICS pairs of width, height words)
        picseg = _MemNew(NUMPICS * Len(pictable(0)))
        CAL_HuffExpand compseg, picseg, NUMPICS * Len(pictable(0)), grhuffman(), FALSE
        For i = 0 To NUMPICS - 1
            pictable(i).width = _MemGet(picseg, picseg.OFFSET + i * 4, Integer)
            pictable(i).height = _MemGet(picseg, picseg.OFFSET + i * 4 + 2, Integer)
        Next i
        _MemFree picseg
        _MemFree compseg
    End Sub

    Sub CAL_OptimizeNodes (huffTable() As huffnode)
        ' Goes through a huffman table and changes the 256-511 node numbers to the
        ' actual address of the node. Must be called before CAL_HuffExpand
        ' QB64 has no pointers: the node numbers are kept as is and CAL_HuffExpand
        ' uses (code - 256) as the node index, so there is nothing to do here
    End Sub

    Sub CAL_GetGrChunkLength (chunk As Integer)
        ' Gets the length of an explicit length chunk (not tiles)
        ' The file pointer is positioned so the compressed data can be read in next.
        Dim chunkPosition As Long
        Dim tempBytes(0 To 2) As _Unsigned _Byte

        ' Calculate position in grstarts array - handle 3-byte file positions
        $If THREEBYTEGRSTARTS = DEFINED Then
            ' Read 3 bytes and convert to 24-bit value
            tempBytes(0) = _MemGet(grstarts, grstarts.OFFSET + chunk * 3, _Unsigned _Byte)
            tempBytes(1) = _MemGet(grstarts, grstarts.OFFSET + chunk * 3 + 1, _Unsigned _Byte)
            tempBytes(2) = _MemGet(grstarts, grstarts.OFFSET + chunk * 3 + 2, _Unsigned _Byte)

            ' Convert 3 bytes to 24-bit value (little-endian)
            chunkPosition = tempBytes(0) + (tempBytes(1) * 256) + (tempBytes(2) * 65536)

            ' Mask to 24 bits (same as C code: value &= 0x00ffffffl)
            chunkPosition = chunkPosition And &HFFFFFF

            ' Check for sparse tile marker (0xffffff)
            If chunkPosition = &HFFFFFF Then
                chunkPosition = -1
            End If
        $Else
                ' 4-byte file positions
                chunkPosition = _MemGet(grstarts, grstarts.OFFSET + chunk * 4, Long)
        $End If

        ' Check if position is valid
        If chunkPosition < 0 Then
            Print "Error: Invalid chunk position for chunk"; chunk; "position:"; chunkPosition
            chunkcomplen = 8192 ' Default size
            chunkexplen = 8192 ' Default size
            Return
        End If

        ' Seek to the chunk position
        Seek #grhandle, chunkPosition + 1 ' QB64 uses 1-based file positions

        ' Read the expanded length (first 4 bytes)
        Get #grhandle, , chunkexplen

        ' Calculate compressed length
        If chunk < NUMCHUNKS - 1 Then
            Dim nextChunkPosition As Long

            $If THREEBYTEGRSTARTS = DEFINED Then
                ' Read 3 bytes for next position
                tempBytes(0) = _MemGet(grstarts, grstarts.OFFSET + (chunk + 1) * 3, _Unsigned _Byte)
                tempBytes(1) = _MemGet(grstarts, grstarts.OFFSET + (chunk + 1) * 3 + 1, _Unsigned _Byte)
                tempBytes(2) = _MemGet(grstarts, grstarts.OFFSET + (chunk + 1) * 3 + 2, _Unsigned _Byte)

                ' Convert 3 bytes to 24-bit value (little-endian)
                nextChunkPosition = tempBytes(0) + (tempBytes(1) * 256) + (tempBytes(2) * 65536)

                ' Mask to 24 bits
                nextChunkPosition = nextChunkPosition And &HFFFFFF

                ' Check for sparse tile marker
                If nextChunkPosition = &HFFFFFF Then
                    nextChunkPosition = -1
                End If
            $Else
                    ' 4-byte file positions
                    nextChunkPosition = _MemGet(grstarts, grstarts.OFFSET + (chunk + 1) * 4, Long)
            $End If

            ' Check if next position is valid
            If nextChunkPosition < 0 Then
                Print "Error: Invalid next chunk position for chunk"; chunk; "next position:"; nextChunkPosition
                End
                'chunkcomplen = 8192  ' Default size
                ' Return
            End If

            chunkcomplen = nextChunkPosition - chunkPosition - 4

            ' Ensure chunkcomplen is positive
            If chunkcomplen <= 0 Then
                Print "Warning: Invalid chunk length for chunk"; chunk; "using default size"
                End
                ' chunkcomplen = 8192  ' Default size
            End If
        Else
            ' For the last chunk, assume a reasonable size
            End
            ' chunkcomplen = 8192  ' Default size, adjust as needed
        End If

        ' Print "Chunk"; chunk; "position:"; chunkPosition; "length:"; chunkcomplen; "expanded:"; chunkexplen
    End Sub

    Sub CAL_HuffExpand (source As _MEM, dest As _MEM, length As Long, huffTable() As huffnode, screenhack As Integer)
        ' Length is the length of the EXPANDED data
        ' Node codes 0-255 are output bytes, 256+ are node numbers + 256 (see CAL_OptimizeNodes)
        ' screenhack (decompress in four planes directly to the screen) is not needed in QB64
        Dim srcOff As _Offset, srcEnd As _Offset, dstOff As _Offset, dstEnd As _Offset
        Dim curByte As Long, bitMask As Long, nodeIdx As Long, code As Long

        If length <= 0 Then Exit Sub
        srcOff = source.OFFSET
        srcEnd = source.OFFSET + source.SIZE
        dstOff = dest.OFFSET
        dstEnd = dest.OFFSET + length

        nodeIdx = 254 ' head node is always node 254
        curByte = _MemGet(source, srcOff, _Unsigned _Byte)
        srcOff = srcOff + 1
        bitMask = 1
        Do
            If curByte And bitMask Then code = huffTable(nodeIdx).bit1 Else code = huffTable(nodeIdx).bit0
            bitMask = bitMask * 2
            If bitMask = 256 Then
                If srcOff < srcEnd Then curByte = _MemGet(source, srcOff, _Unsigned _Byte) Else curByte = 0
                srcOff = srcOff + 1
                bitMask = 1
            End If
            If code < 256 Then
                _MemPut dest, dstOff, code As _UNSIGNED _BYTE
                dstOff = dstOff + 1
                nodeIdx = 254
                If dstOff >= dstEnd Then Exit Do
            Else
                nodeIdx = code - 256
            End If
        Loop
    End Sub

    ' GRFILEPOS macro - file position of a graphics chunk, -1 for sparse tiles
    Function GRFILEPOS& (chunk As Integer)
        Dim value As Long
        $If THREEBYTEGRSTARTS = DEFINED Then
            value = _MemGet(grstarts, grstarts.OFFSET + chunk * 3, _Unsigned _Byte)
            value = value + _MemGet(grstarts, grstarts.OFFSET + chunk * 3 + 1, _Unsigned _Byte) * 256&
            value = value + _MemGet(grstarts, grstarts.OFFSET + chunk * 3 + 2, _Unsigned _Byte) * 65536
            If value = &HFFFFFF Then value = -1
        $Else
                value = _MemGet(grstarts, grstarts.OFFSET + chunk * 4, Long)
        $End If
        GRFILEPOS& = value
    End Function

    '======================
    '=
    '= CA_CacheGrChunk
    '=
    '= Makes sure a given chunk is in memory, loadiing it if needed
    '=
    '======================
    Sub CA_CacheGrChunk (chunk As Integer)
        Dim position As Long, compressed As Long, expanded As Long
        Dim nextChunk As Integer
        Dim source As _MEM
        Dim fileBytes As _Unsigned _Byte

        If grsegs(chunk) <> 0 Then
            Exit Sub ' allready in memory
        End If

        position = GRFILEPOS(chunk)
        If position < 0 Then Exit Sub ' $FFFFFFFF start is a sparse tile

        nextChunk = chunk + 1
        Do While GRFILEPOS(nextChunk) = -1 ' skip past any sparse tiles
            nextChunk = nextChunk + 1
        Loop
        compressed = GRFILEPOS(nextChunk) - position

        Seek #grhandle, position + 1 ' QB64 uses 1-based file positions

        ' CAL_ExpandGrChunk
        If chunk >= STARTTILE8 And chunk < STARTEXTERNS Then
            ' expanded sizes of tile8/16/32 are implicit (WL6 has only unmasked 8x8 tiles)
            expanded = 64 * NUMTILE8 ' BLOCK * NUMTILE8
        Else
            ' everything else has an explicit size longword
            Get #grhandle, , expanded
            compressed = compressed - 4
        End If

        source = _MemNew(compressed)
        ReDim fileBytes(0 To compressed - 1) As _Unsigned _Byte
        Get #grhandle, , fileBytes()
        _MemPut source, source.OFFSET, fileBytes()

        ' MM_GetPtr equivalent
        grsegsMem(chunk) = _MemNew(expanded)
        CAL_HuffExpand source, grsegsMem(chunk), expanded, grhuffman(), FALSE
        grsegs(chunk) = grsegsMem(chunk).OFFSET
        _MemFree source
    End Sub

    '======================
    '=
    '= CA_CacheScreen
    '=
    '= Decompresses a chunk from disk straight onto the screen
    '=
    '======================
    Sub CA_CacheScreen (chunk As Integer)
        Dim position As Long, compressed As Long, expanded As Long
        Dim nextChunk As Integer
        Dim source As _MEM, screenseg As _MEM
        Dim fileBytes As _Unsigned _Byte

        ' load the chunk into a buffer
        position = GRFILEPOS(chunk)
        nextChunk = chunk + 1
        Do While GRFILEPOS(nextChunk) = -1 ' skip past any sparse tiles
            nextChunk = nextChunk + 1
        Loop
        compressed = GRFILEPOS(nextChunk) - position

        Seek #grhandle, position + 1 ' QB64 uses 1-based file positions
        Get #grhandle, , expanded
        compressed = compressed - 4 ' skip over length

        source = _MemNew(compressed)
        ReDim fileBytes(0 To compressed - 1) As _Unsigned _Byte
        Get #grhandle, , fileBytes()
        _MemPut source, source.OFFSET, fileBytes()

        ' The original decompressed straight into the four VGA planes (screenhack),
        ' here it is expanded to a buffer and drawn as a 320x200 planar picture
        screenseg = _MemNew(expanded)
        CAL_HuffExpand source, screenseg, expanded, grhuffman(), TRUE
        VL_PlanarMemToScreen screenseg, 320, 200, 0, 0
        ' C: VW_MarkUpdateBlock (0, 0, 319, 199) (no update blocks in the port, see ID_HEADS.BI)
        _MemFree screenseg
        _MemFree source
    End Sub

    ' UNCACHEGRCHUNK macro - frees a graphics chunk
    Sub UNCACHEGRCHUNK (chunk As Integer)
        If grsegs(chunk) = 0 Then Exit Sub
        _MemFree grsegsMem(chunk)
        grsegs(chunk) = 0
    End Sub

    Sub CAL_SetupAudioFile ()
        ' Implementation of CAL_SetupAudioFile in QB64 Basic

        Dim handle As Long, length As Long, fname As String * 13
        Dim fileBytes As _Unsigned _Byte

        ' Load maphead.ext (offsets and tileinfo for map file)
        fname = aheadname + extension

        handle = FreeFile
        Open fname For Binary As #handle
        If Err Then
            CA_CannotOpen fname
        End If

        length = LOF(handle)
        ' MM_GetPtr equivalent - allocate memory for audio starts
        audiostarts = _MemNew(length)
        If audiostarts.SIZE = 0 Then
            Close #handle
            CA_CannotOpen "Memory allocation failed for audio starts"
        End If

        ' CA_FarRead equivalent - read file into byte array, then copy to audiostarts
        ReDim fileBytes(0 To length - 1) As _Unsigned _Byte
        Get #handle, , fileBytes()
        _MemPut audiostarts, audiostarts.OFFSET, fileBytes()
        Close #handle


        ' Open the data file
        fname = afilename + extension

        audiohandle = FreeFile
        Open fname For Binary As #audiohandle
        If Err Then
            CA_CannotOpen fname
        End If

    End Sub

    Sub CA_CacheAudioChunk (chunk As Integer)
        Dim position As Long, compressed As Long
        Dim fileBytes As _Unsigned _Byte

        If audiosegs(chunk) <> 0 Then
            Exit Sub ' allready in memory
        End If

        ' load the chunk into a newly allocated buffer
        position = _MemGet(audiostarts, audiostarts.OFFSET + chunk * 4, Long)
        compressed = _MemGet(audiostarts, audiostarts.OFFSET + (chunk + 1) * 4, Long) - position
        If compressed <= 0 Then Exit Sub

        ' MM_GetPtr equivalent
        audiosegMem(chunk) = _MemNew(compressed)
        If audiosegMem(chunk).SIZE = 0 Then Exit Sub

        ' CA_FarRead equivalent
        ReDim fileBytes(0 To compressed - 1) As _Unsigned _Byte
        Get #audiohandle, position + 1, fileBytes() ' QB64 uses 1-based file positions
        _MemPut audiosegMem(chunk), audiosegMem(chunk).OFFSET, fileBytes()
        audiosegs(chunk) = audiosegMem(chunk).OFFSET
    End Sub

    '======================
    '=
    '= CA_LoadAllSounds
    '=
    '= Purges all sounds, then loads all new ones (mode switch)
    '=
    '======================
    Sub CA_LoadAllSounds ()
        Static oldsoundmode As Integer ' sdm_Off
        Dim start As Integer, i As Integer

        ' Free the sounds of the previous mode (orig C marks them purgable).
        ' The same mode keeps its sounds (a playing sound must not be freed), but they
        ' are cached in again below: CopyProtection frees them (MM_FreePtr) as in C
        If oldsoundmode <> SoundMode And oldsoundmode <> sdm_Off Then
            Select Case oldsoundmode
                Case sdm_PC
                    start = STARTPCSOUNDS
                Case sdm_AdLib
                    start = STARTADLIBSOUNDS
            End Select
            For i = 0 To NUMSOUNDS - 1
                CA_FreeAudioChunk start + i
            Next i
        End If

        ' cachein:
        Select Case SoundMode
            Case sdm_Off
                oldsoundmode = SoundMode
                Exit Sub
            Case sdm_PC
                start = STARTPCSOUNDS
            Case sdm_AdLib
                start = STARTADLIBSOUNDS
        End Select

        For i = 0 To NUMSOUNDS - 1
            CA_CacheAudioChunk start + i
        Next i

        oldsoundmode = SoundMode
    End Sub

    ' MM_FreePtr equivalent for audio chunks
    Sub CA_FreeAudioChunk (chunk As Integer)
        If audiosegs(chunk) = 0 Then Exit Sub
        _MemFree audiosegMem(chunk)
        audiosegs(chunk) = 0
    End Sub

    Sub CA_Startup ()
        $If PROFILE = DEFINED Then
                ' unlink ("PROFILE.TXT"); profilehandle = open("PROFILE.TXT", O_CREAT | O_WRONLY | O_TEXT);
                profilehandle = FreeFile
                Open "PROFILE.TXT" For Output As #profilehandle
        $End If

        CAL_SetupMapFile
        CAL_SetupGrFile
        CAL_SetupAudioFile

        mapon = -1
        ca_levelbit = 1
        ca_levelnum = 0
    End Sub

    '==========================
    '=
    '= CA_WriteFile
    '=
    '= Writes a file from a memory buffer
    '=
    '==========================
    Sub CA_WriteFile (filename As String, source As _MEM, length As Long)
        Dim handle As Integer
        Dim fileBytes(0 To length - 1) As _Unsigned _Byte

        _MemGet source, source.OFFSET, fileBytes()
        If _FileExists(filename) Then Kill filename ' O_CREAT | O_TRUNC
        handle = FreeFile
        Open filename For Binary As #handle
        Put #handle, , fileBytes()
        Close #handle
    End Sub

    '==========================
    '=
    '= CA_LoadFile
    '=
    '= Allocate space for and load a file (FALSE if it is not there)
    '=
    '==========================
    Function CA_LoadFile% (filename As String, dest As _MEM)
        Dim handle As Integer, length As Long

        CA_LoadFile% = FALSE
        If Not _FileExists(filename) Then Exit Function
        handle = FreeFile
        Open filename For Binary As #handle
        length = LOF(handle)
        If length = 0 Then Close #handle: Exit Function
        Dim fileBytes(0 To length - 1) As _Unsigned _Byte
        Get #handle, , fileBytes()
        Close #handle
        dest = _MemNew(length) ' MM_GetPtr
        _MemPut dest, dest.OFFSET, fileBytes()
        CA_LoadFile% = TRUE
    End Function

    Sub CA_CannotOpen (fname As String)
        Print "Error: Cannot open file: "; fname
        End
    End Sub

    '$INCLUDE: 'ID_HEADS.BI'

$End If

