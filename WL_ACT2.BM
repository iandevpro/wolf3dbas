        '===============
        '=
        '= SpawnBJVictory
        '=
        '===============
        Sub SpawnBJVictory ()
            SpawnNewObj objlist(player).tilex, objlist(player).tiley + 1, s_bjrun1
            objlist(newobj).x = objlist(player).x
            objlist(newobj).y = objlist(player).y
            objlist(newobj).obclass = bjobj
            objlist(newobj).dir = dt_north
            objlist(newobj).temp1 = 6 ' tiles to run forward
        End Sub

        '===============
        '=
        '= T_BJRun
        '=
        '===============
        Sub T_BJRun (ob As Integer)
            Dim move As Long

            move = BJRUNSPEED * tics

            Do While move
                If move < objlist(ob).distance Then
                    MoveObj ob, move
                    Exit Do
                End If

                objlist(ob).x = objlist(ob).tilex * TILEGLOBAL + TILEGLOBAL \ 2
                objlist(ob).y = objlist(ob).tiley * TILEGLOBAL + TILEGLOBAL \ 2
                move = move - objlist(ob).distance

                SelectPathDir ob

                objlist(ob).temp1 = objlist(ob).temp1 - 1
                If objlist(ob).temp1 = 0 Then
                    NewState ob, s_bjjump1
                    Exit Sub
                End If
            Loop
        End Sub

        '===============
        '=
        '= T_BJJump
        '=
        '===============
        Sub T_BJJump (ob As Integer)
            Dim move As Long

            move = BJJUMPSPEED * tics
            MoveObj ob, move
        End Sub

