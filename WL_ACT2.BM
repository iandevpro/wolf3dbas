        ' The time a boss stands dead before the death cam: long enough for the digitized
        ' scream when there is one (SpawnSchabbs / SpawnGift / SpawnFat / SpawnHitler...)
        Sub BossDeathTime (state As Integer)
            If DigiMode <> sds_Off Then
                states(state).tictime = 140
            Else
                states(state).tictime = 5
            End If
        End Sub

        ' The common part of the boss spawn functions below
        Sub SpawnBossCommon (tilex As Integer, tiley As Integer, state As Integer, obclass As Integer, which As Integer, dir As Integer)
            SpawnNewObj tilex, tiley, state
            objlist(newobj).speed = SPDPATROL

            objlist(newobj).obclass = obclass
            objlist(newobj).hitpoints = starthitpoints(gamestate.difficulty, which)
            objlist(newobj).dir = dir
            objlist(newobj).flags = objlist(newobj).flags Or FL_SHOOTABLE Or FL_AMBUSH
            If Not loadedgame Then gamestate.killtotal = gamestate.killtotal + 1
        End Sub

