        ' T_Schabb / T_Gift / T_Fat: the same chase, with a throw (US_RndT() < (tics<<3)) and
        ' running away when the player is closer than 4 tiles
        Sub T_ThrowerChase (ob As Integer, shootstate As Integer)
            Dim move As Long
            Dim dx As Integer, dy As Integer, dist As Integer
            Dim dodge As Integer

            dodge = FALSE
            dx = Abs(objlist(ob).tilex - objlist(player).tilex)
            dy = Abs(objlist(ob).tiley - objlist(player).tiley)
            If dx > dy Then dist = dx Else dist = dy

            If CheckLine(ob) Then ' got a shot at player?
                If US_RndT < tics * 8 Then
                    '
                    ' go into attack frame
                    '
                    NewState ob, shootstate
                    Exit Sub
                End If
                dodge = TRUE
            End If

            If objlist(ob).dir = dt_nodir Then
                If dodge Then
                    SelectDodgeDir ob
                Else
                    SelectChaseDir ob
                End If
                If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
            End If

            move = objlist(ob).speed * tics

            Do While move
                If Not DoorOpenForActor(ob) Then Exit Sub

                If Not ReachedGoal(ob, move) Then Exit Do

                If dist < 4 Then
                    SelectRunDir ob
                ElseIf dodge Then
                    SelectDodgeDir ob
                Else
                    SelectChaseDir ob
                End If

                If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
            Loop
        End Sub

        '=================
        '=
        '= T_Schabb
