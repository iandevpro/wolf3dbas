        '===============
        '=
        '= A_HitlerMorph
        '=
        '===============
        Sub A_HitlerMorph (ob As Integer)
            Dim hitpoints As Integer

            Select Case gamestate.difficulty ' hitpoints[4]={500,700,800,900}
                Case 0: hitpoints = 500
                Case 1: hitpoints = 700
                Case 2: hitpoints = 800
                Case Else: hitpoints = 900
            End Select

            SpawnNewObj objlist(ob).tilex, objlist(ob).tiley, s_hitlerchase1
            objlist(newobj).speed = SPDPATROL * 5

            objlist(newobj).x = objlist(ob).x
            objlist(newobj).y = objlist(ob).y

            objlist(newobj).distance = objlist(ob).distance
            objlist(newobj).dir = objlist(ob).dir
            objlist(newobj).flags = objlist(ob).flags Or FL_SHOOTABLE

            objlist(newobj).obclass = realhitlerobj
            objlist(newobj).hitpoints = hitpoints
        End Sub

