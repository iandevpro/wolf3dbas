        ' The angle from ob to the player (T_SchabbThrow / T_GiftThrow / T_FakeFire), C float math
        Function AngleToPlayer% (ob As Integer)
            Dim deltax As Long, deltay As Long
            Dim angl As Single

            deltax = objlist(player).x - objlist(ob).x
            deltay = objlist(ob).y - objlist(player).y
            angl = _Atan2(deltay, deltax)
            If angl < 0 Then angl = _Pi * 2 + angl
            AngleToPlayer% = Fix(angl / (_Pi * 2) * ANGLES)
        End Function

        ' A new projectile at ob's position, flying toward the player
        Sub SpawnProjectile (ob As Integer, state As Integer, obclass As Integer, speed As Long, flags As Integer)
            Dim iangle As Integer

            iangle = AngleToPlayer(ob)

            GetNewActor
            objlist(newobj).state = state
            objlist(newobj).ticcount = 1

            objlist(newobj).tilex = objlist(ob).tilex
            objlist(newobj).tiley = objlist(ob).tiley
            objlist(newobj).x = objlist(ob).x
            objlist(newobj).y = objlist(ob).y
            objlist(newobj).obclass = obclass
            objlist(newobj).dir = dt_nodir
            objlist(newobj).angle = iangle
            objlist(newobj).speed = speed

            objlist(newobj).flags = flags
            objlist(newobj).active = ac_yes
        End Sub

