' WL_ACT2.C - enemies, bosses, projectiles
' Ported so far: guards, officers, SS, dogs, mutants, projectiles (step 6g). Bosses and ghosts: 6h

$If INCLUDE_WL_ACT2_BM = UNDEFINED Then
    $Let INCLUDE_WL_ACT2_BM = 1

    '=================
    '=
    '= A_Smoke
    '=
    '=================
    Sub A_Smoke (ob As Integer)
        GetNewActor
        $If SPEAR = DEFINED Then
            If objlist(ob).obclass = hrocketobj Then
                objlist(newobj).state = s_hsmoke1
            Else
                objlist(newobj).state = s_smoke1
            End If
        $Else
            objlist(newobj).state = s_smoke1
        $End If
        objlist(newobj).ticcount = 6

        objlist(newobj).tilex = objlist(ob).tilex
        objlist(newobj).tiley = objlist(ob).tiley
        objlist(newobj).x = objlist(ob).x
        objlist(newobj).y = objlist(ob).y
        objlist(newobj).obclass = inertobj
        objlist(newobj).active = ac_yes

        objlist(newobj).flags = FL_NEVERMARK
    End Sub

    '===================
    '=
    '= ProjectileTryMove
    '=
    '= returns true if move ok
    '===================
    Function ProjectileTryMove% (ob As Integer)
        Const PROJSIZE = &H2000
        Dim xl As Integer, yl As Integer, xh As Integer, yh As Integer, x As Integer, y As Integer
        Dim check As Integer

        xl = SarL(objlist(ob).x - PROJSIZE, TILESHIFT)
        yl = SarL(objlist(ob).y - PROJSIZE, TILESHIFT)

        xh = SarL(objlist(ob).x + PROJSIZE, TILESHIFT)
        yh = SarL(objlist(ob).y + PROJSIZE, TILESHIFT)

        '
        ' check for solid walls
        '
        For y = yl To yh
            For x = xl To xh
                check = actorat(x, y)
                If check <> 0 And check < OBJ_BASE Then ' check && check<objlist
                    ProjectileTryMove% = FALSE
                    Exit Function
                End If
            Next x
        Next y

        ProjectileTryMove% = TRUE
    End Function

    '=================
    '=
    '= T_Projectile
    '=
    '=================
    Sub T_Projectile (ob As Integer)
        Dim deltax As Long, deltay As Long
        Dim damage As Integer
        Dim speed As Long

        speed = objlist(ob).speed * tics

        deltax = FixedByFrac(speed, costable(objlist(ob).angle))
        deltay = -FixedByFrac(speed, sintable(objlist(ob).angle))

        If deltax > &H10000 Then deltax = &H10000
        If deltay > &H10000 Then deltay = &H10000

        objlist(ob).x = objlist(ob).x + deltax
        objlist(ob).y = objlist(ob).y + deltay

        deltax = Abs(objlist(ob).x - objlist(player).x)
        deltay = Abs(objlist(ob).y - objlist(player).y)

        If Not ProjectileTryMove(ob) Then
            If objlist(ob).obclass = rocketobj Then
                PlaySoundLocActor MISSILEHITSND, ob
                objlist(ob).state = s_boom1
            ElseIf objlist(ob).obclass = hrocketobj Then
                $If SPEAR = DEFINED Then
                    PlaySoundLocActor MISSILEHITSND, ob
                    objlist(ob).state = s_hboom1
                $Else
                    objlist(ob).state = 0 ' mark for removal
                $End If
            Else
                objlist(ob).state = 0 ' mark for removal
            End If

            Exit Sub
        End If

        If deltax < PROJECTILESIZE And deltay < PROJECTILESIZE Then
            ' hit the player
            Select Case objlist(ob).obclass
                Case needleobj
                    damage = US_RndT \ 8 + 20
                Case rocketobj, hrocketobj, sparkobj
                    damage = US_RndT \ 8 + 30
                Case fireobj
                    damage = US_RndT \ 8
            End Select

            TakeDamage damage, ob
            objlist(ob).state = 0 ' mark for removal
            Exit Sub
        End If

        objlist(ob).tilex = SarL(objlist(ob).x, TILESHIFT)
        objlist(ob).tiley = SarL(objlist(ob).y, TILESHIFT)
    End Sub

    '
    ' =============================================================================
    '                          GUARD
    ' =============================================================================
    '

    ' The state of the standing / patrolling enemies of SpawnStand / SpawnPatrol
    Function EnemyStartState% (which As Integer, patrol As Integer)
        EnemyStartState% = 0
        Select Case which
            Case en_guard
                If patrol Then EnemyStartState% = s_grdpath1 Else EnemyStartState% = s_grdstand
            Case en_officer
                If patrol Then EnemyStartState% = s_ofcpath1 Else EnemyStartState% = s_ofcstand
            Case en_mutant
                If patrol Then EnemyStartState% = s_mutpath1 Else EnemyStartState% = s_mutstand
            Case en_ss
                If patrol Then EnemyStartState% = s_sspath1 Else EnemyStartState% = s_ssstand
            Case en_dog
                If patrol Then EnemyStartState% = s_dogpath1
        End Select
    End Function

    '===============
    '=
    '= SpawnStand
    '=
    '===============
    Sub SpawnStand (which As Integer, tilex As Integer, tiley As Integer, dir As Integer)
        Dim map As Long, tile As Long, state As Integer

        state = EnemyStartState(which, FALSE)
        If state Then ' en_guard, en_officer, en_mutant, en_ss
            SpawnNewObj tilex, tiley, state
            objlist(newobj).speed = SPDPATROL
            If Not loadedgame Then gamestate.killtotal = gamestate.killtotal + 1
        End If

        map = tiley * 64 + tilex ' mapsegs[0]+farmapylookup[tiley]+tilex
        If mapsegs(0, map) = AMBUSHTILE Then
            tilemap(tilex, tiley) = 0

            If mapsegs(0, map + 1) >= AREATILE Then tile = mapsegs(0, map + 1)
            If mapsegs(0, map - mapwidth) >= AREATILE Then tile = mapsegs(0, map - mapwidth)
            If mapsegs(0, map + mapwidth) >= AREATILE Then tile = mapsegs(0, map + mapwidth)
            If mapsegs(0, map - 1) >= AREATILE Then tile = mapsegs(0, map - 1)

            mapsegs(0, map) = tile
            objlist(newobj).areanumber = tile - AREATILE

            objlist(newobj).flags = objlist(newobj).flags Or FL_AMBUSH
        End If

        objlist(newobj).obclass = guardobj + which
        objlist(newobj).hitpoints = starthitpoints(gamestate.difficulty, which)
        objlist(newobj).dir = dir * 2
        objlist(newobj).flags = objlist(newobj).flags Or FL_SHOOTABLE
    End Sub

    '===============
    '=
    '= SpawnDeadGuard
    '=
    '===============
    Sub SpawnDeadGuard (tilex As Integer, tiley As Integer)
        SpawnNewObj tilex, tiley, s_grddie4
        objlist(newobj).obclass = inertobj
    End Sub

    '===============
    '=
    '= SpawnPatrol
    '=
    '===============
    Sub SpawnPatrol (which As Integer, tilex As Integer, tiley As Integer, dir As Integer)
        Dim state As Integer

        state = EnemyStartState(which, TRUE)
        If state Then ' en_guard, en_officer, en_ss, en_mutant, en_dog
            SpawnNewObj tilex, tiley, state
            If which = en_dog Then
                objlist(newobj).speed = SPDDOG
            Else
                objlist(newobj).speed = SPDPATROL
            End If
            If Not loadedgame Then gamestate.killtotal = gamestate.killtotal + 1
        End If

        objlist(newobj).obclass = guardobj + which
        objlist(newobj).dir = dir * 2
        objlist(newobj).hitpoints = starthitpoints(gamestate.difficulty, which)
        objlist(newobj).distance = TILEGLOBAL
        objlist(newobj).flags = objlist(newobj).flags Or FL_SHOOTABLE
        objlist(newobj).active = ac_yes

        actorat(objlist(newobj).tilex, objlist(newobj).tiley) = 0 ' don't use original spot

        Select Case dir
            Case 0
                objlist(newobj).tilex = objlist(newobj).tilex + 1
            Case 1
                objlist(newobj).tiley = objlist(newobj).tiley - 1
            Case 2
                objlist(newobj).tilex = objlist(newobj).tilex - 1
            Case 3
                objlist(newobj).tiley = objlist(newobj).tiley + 1
        End Select

        actorat(objlist(newobj).tilex, objlist(newobj).tiley) = OBJ_BASE + newobj
    End Sub

    '==================
    '=
    '= A_DeathScream
    '=
    '==================
    Sub A_DeathScream (ob As Integer)
        Dim played As Integer, secretmap As Integer

        $If UPLOAD = UNDEFINED Then
            $If SPEAR = UNDEFINED Then
                secretmap = (mapon = 9)
            $Else
                secretmap = (mapon = 18 Or mapon = 19)
            $End If
            If secretmap Then
                If US_RndT = 0 Then
                    Select Case objlist(ob).obclass
                        Case mutantobj, guardobj, officerobj, ssobj, dogobj
                            PlaySoundLocActor DEATHSCREAM6SND, ob
                            Exit Sub
                    End Select
                End If
            End If
        $End If

        Select Case objlist(ob).obclass
            Case mutantobj
                PlaySoundLocActor AHHHGSND, ob

            Case guardobj
                $If UPLOAD = UNDEFINED Then
                    PlaySoundLocActor deathscreams(US_RndT Mod 8), ob
                $Else
                    PlaySoundLocActor deathscreams(US_RndT Mod 2), ob
                $End If
            Case officerobj
                PlaySoundLocActor NEINSOVASSND, ob
            Case ssobj
                PlaySoundLocActor LEBENSND, ob ' JAB
            Case dogobj
                PlaySoundLocActor DOGDEATHSND, ob ' JAB
            Case Else
                A_DeathScreamBoss ob
        End Select
    End Sub

    ' The boss cases of A_DeathScream (a $If between Case lines breaks Select Case)
    Sub A_DeathScreamBoss (ob As Integer)
        Dim played As Integer

        $If SPEAR = UNDEFINED Then
            Select Case objlist(ob).obclass
                Case bossobj
                    played = SD_PlaySound(MUTTISND) ' JAB
                Case schabbobj
                    played = SD_PlaySound(MEINGOTTSND)
                Case fakeobj
                    played = SD_PlaySound(HITLERHASND)
                Case mechahitlerobj
                    played = SD_PlaySound(SCHEISTSND)
                Case realhitlerobj
                    played = SD_PlaySound(EVASND)
                Case gretelobj
                    played = SD_PlaySound(MEINSND)
                Case giftobj
                    played = SD_PlaySound(DONNERSND)
                Case fatobj
                    played = SD_PlaySound(ROSESND)
            End Select
        $Else
            Select Case objlist(ob).obclass
                Case spectreobj
                    played = SD_PlaySound(GHOSTFADESND)
                Case angelobj
                    played = SD_PlaySound(ANGELDEATHSND)
                Case transobj
                    played = SD_PlaySound(TRANSDEATHSND)
                Case uberobj
                    played = SD_PlaySound(UBERDEATHSND)
                Case willobj
                    played = SD_PlaySound(WILHELMDEATHSND)
                Case deathobj
                    played = SD_PlaySound(KNIGHTDEATHSND)
            End Select
        $End If
    End Sub

