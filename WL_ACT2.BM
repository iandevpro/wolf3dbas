        '=================
        '=
        '= T_Fake
        '=
        '=================
        Sub T_Fake (ob As Integer)
            Dim move As Long

            If CheckLine(ob) Then ' got a shot at player?
                If US_RndT < tics * 2 Then
                    '
                    ' go into attack frame
                    '
                    NewState ob, s_fakeshoot1
                    Exit Sub
                End If
            End If

            If objlist(ob).dir = dt_nodir Then
                SelectDodgeDir ob
                If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
            End If

            move = objlist(ob).speed * tics

            Do While move
                If Not ReachedGoal(ob, move) Then Exit Do

                SelectDodgeDir ob

                If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
            Loop
        End Sub

