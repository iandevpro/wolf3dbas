        '===============
        '=
        '= CheckPosition
        '=
        '===============
        Function CheckPosition% (ob As Integer)
            Dim x As Integer, y As Integer, xl As Integer, yl As Integer, xh As Integer, yh As Integer
            Dim check As Integer

            xl = SarL(objlist(ob).x - PLAYERSIZE, TILESHIFT)
            yl = SarL(objlist(ob).y - PLAYERSIZE, TILESHIFT)

            xh = SarL(objlist(ob).x + PLAYERSIZE, TILESHIFT)
            yh = SarL(objlist(ob).y + PLAYERSIZE, TILESHIFT)

            '
            ' check for solid walls
            '
            For y = yl To yh
                For x = xl To xh
                    check = actorat(x, y)
                    If check <> 0 And check < OBJ_BASE Then ' check && check<objlist
                        CheckPosition% = FALSE
                        Exit Function
                    End If
                Next x
            Next y

            CheckPosition% = TRUE
        End Function

        '===============
        '=
        '= A_StartDeathCam
        '=
        '===============
        Sub A_StartDeathCam (ob As Integer)
            Dim dx As Long, dy As Long
            Dim fangle As Single
            Dim xmove As Long, ymove As Long
            Dim dist As Long
            Dim result As Integer

            FinishPaletteShifts

            VL_WaitVBL 100 ' VW_WaitVBL

            If gamestate.victoryflag Then
                playstate = ex_victorious ' exit castle tile
                Exit Sub
            End If

            gamestate.victoryflag = TRUE
            FizzleToBar 0, 0, 320, 200 - STATUSLINES, 127, 70

            CacheLump LEVELEND_LUMP_START, LEVELEND_LUMP_END
            WritePic 0, 7, STR_SEEAGAIN ' (Japan: CA_CacheScreen (C_LETSSEEPIC))

            VW_UpdateScreen

            result = IN_UserInput(300)

            '
            ' line angle up exactly
            '
            NewState player, s_deathcam

            objlist(player).x = gamestate.killx
            objlist(player).y = gamestate.killy

            dx = objlist(ob).x - objlist(player).x
            dy = objlist(player).y - objlist(ob).y

            fangle = _Atan2(dy, dx) ' returns -pi to pi
            If fangle < 0 Then fangle = _Pi * 2 + fangle

            objlist(player).angle = Fix(fangle / (_Pi * 2) * ANGLES)

            '
            ' try to position as close as possible without being in a wall
            '
            dist = &H14000
            Do
                xmove = FixedByFrac(dist, costable(objlist(player).angle))
                ymove = -FixedByFrac(dist, sintable(objlist(player).angle))

                objlist(player).x = objlist(ob).x - xmove
                objlist(player).y = objlist(ob).y - ymove
                dist = dist + &H1000
            Loop While Not CheckPosition(player)
            plux = SarL(objlist(player).x, UNSIGNEDSHIFT) ' scale to fit in unsigned
            pluy = SarL(objlist(player).y, UNSIGNEDSHIFT)
            objlist(player).tilex = SarL(objlist(player).x, TILESHIFT) ' scale to tile values
            objlist(player).tiley = SarL(objlist(player).y, TILESHIFT)

            '
            ' go back to the game
            '
            DrawPlayBorder ' (the original drew it into all three screen pages)

            fizzlein = TRUE
            Select Case objlist(ob).obclass
                Case schabbobj
                    NewState ob, s_schabbdeathcam
                Case realhitlerobj
                    NewState ob, s_hitlerdeathcam
                Case giftobj
                    NewState ob, s_giftdeathcam
                Case fatobj
                    NewState ob, s_fatdeathcam
            End Select
        End Sub
    $Else
        ' TODO: the Spear of Destiny actors (trans, uber, will, death knight, angel, spectre);
        ' the WL6 routines of the state dispatcher do nothing in Spear
        Sub T_Schabb (ob As Integer)
        End Sub
        Sub T_SchabbThrow (ob As Integer)
        End Sub
        Sub T_Gift (ob As Integer)
        End Sub
        Sub T_GiftThrow (ob As Integer)
        End Sub
        Sub T_Fat (ob As Integer)
        End Sub
        Sub T_Fake (ob As Integer)
        End Sub
        Sub T_FakeFire (ob As Integer)
        End Sub
        Sub A_MechaSound (ob As Integer)
        End Sub
        Sub A_HitlerMorph (ob As Integer)
        End Sub
        Sub A_Slurpie (ob As Integer)
        End Sub
        Sub A_StartDeathCam (ob As Integer)
        End Sub
        Sub T_BJRun (ob As Integer)
        End Sub
        Sub T_BJJump (ob As Integer)
        End Sub
        Sub T_BJYell (ob As Integer)
        End Sub
        Sub T_BJDone (ob As Integer)
        End Sub
    $End If

    '
    ' ============================================================================
    '                              STAND
    ' ============================================================================
    '

    '===============
    '=
    '= T_Stand
    '=
    '===============
    Sub T_Stand (ob As Integer)
        Dim seen As Integer

        seen = SightPlayer(ob)
    End Sub

    '
    ' ============================================================================
    '                              CHASE
    ' ============================================================================
    '

    ' The way an actor walks toward its goal tile in T_Chase / T_Ghosts / T_DogChase / T_Path:
    ' the end of the C while (move) loops, TRUE when the goal tile was reached
    Function ReachedGoal% (ob As Integer, move As Long)
        If move < objlist(ob).distance Then
            MoveObj ob, move
            ReachedGoal% = FALSE
            Exit Function
        End If

        '
        ' reached goal tile, so select another one
        '

        '
        ' fix position to account for round off during moving
        '
        objlist(ob).x = objlist(ob).tilex * TILEGLOBAL + TILEGLOBAL \ 2
        objlist(ob).y = objlist(ob).tiley * TILEGLOBAL + TILEGLOBAL \ 2

        move = move - objlist(ob).distance
        ReachedGoal% = TRUE
    End Function

    ' A door in the way (ob->distance < 0): FALSE while it is still opening
    Function DoorOpenForActor% (ob As Integer)
        DoorOpenForActor% = TRUE
        If objlist(ob).distance < 0 Then
            '
            ' waiting for a door to open
            '
            OpenDoor -objlist(ob).distance - 1
            If doorobjlist(-objlist(ob).distance - 1).action <> dr_open Then
                DoorOpenForActor% = FALSE
                Exit Function
            End If
            objlist(ob).distance = TILEGLOBAL ' go ahead, the door is now opoen
        End If
    End Function

    '=================
    '=
    '= T_Chase
    '=
    '=================
    Sub T_Chase (ob As Integer)
        Dim move As Long
        Dim dx As Integer, dy As Integer, dist As Integer, chance As Integer
        Dim dodge As Integer

        If gamestate.victoryflag Then Exit Sub

        dodge = FALSE
        If CheckLine(ob) Then ' got a shot at player?
            dx = Abs(objlist(ob).tilex - objlist(player).tilex)
            dy = Abs(objlist(ob).tiley - objlist(player).tiley)
            If dx > dy Then dist = dx Else dist = dy
            chance = 0
            If dist = 0 Then
                chance = 300
            ElseIf dist = 1 And objlist(ob).distance < &H4000 Then
                chance = 300
            Else
                chance = (tics * 16) \ dist
            End If

            If US_RndT < chance Then
                '
                ' go into attack frame
                '
                Select Case objlist(ob).obclass
                    Case guardobj
                        NewState ob, s_grdshoot1
                    Case officerobj
                        NewState ob, s_ofcshoot1
                    Case mutantobj
                        NewState ob, s_mutshoot1
                    Case ssobj
                        NewState ob, s_ssshoot1
                    Case Else
                        T_ChaseBossShoot ob
                End Select
                Exit Sub
            End If
            dodge = TRUE
        End If

        If objlist(ob).dir = dt_nodir Then
            If dodge Then
                SelectDodgeDir ob
            Else
                SelectChaseDir ob
            End If
            If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
        End If

        move = objlist(ob).speed * tics

        Do While move
            If Not DoorOpenForActor(ob) Then Exit Sub

            If Not ReachedGoal(ob, move) Then Exit Do

            If dodge Then
                SelectDodgeDir ob
            Else
                SelectChaseDir ob
            End If

            If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
        Loop
    End Sub

    ' The boss cases of T_Chase's attack (a $If between Case lines breaks Select Case)
    Sub T_ChaseBossShoot (ob As Integer)
        $If SPEAR = UNDEFINED Then
            Select Case objlist(ob).obclass
                Case bossobj
                    NewState ob, s_bossshoot1
                Case gretelobj
                    NewState ob, s_gretelshoot1
                Case mechahitlerobj
                    NewState ob, s_mechashoot1
                Case realhitlerobj
                    NewState ob, s_hitlershoot1
            End Select
        $Else
            Select Case objlist(ob).obclass
                Case angelobj
                    NewState ob, s_angelshoot1
                Case transobj
                    NewState ob, s_transshoot1
                Case uberobj
                    NewState ob, s_ubershoot1
                Case willobj
                    NewState ob, s_willshoot1
                Case deathobj
                    NewState ob, s_deathshoot1
            End Select
        $End If
    End Sub

    '=================
    '=
    '= T_Ghosts
    '=
    '=================
    Sub T_Ghosts (ob As Integer)
        Dim move As Long

        If objlist(ob).dir = dt_nodir Then
            SelectChaseDir ob
            If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
        End If

        move = objlist(ob).speed * tics

        Do While move
            If Not ReachedGoal(ob, move) Then Exit Do

            SelectChaseDir ob

            If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
        Loop
    End Sub

    '=================
    '=
    '= T_DogChase
    '=
    '=================
    Sub T_DogChase (ob As Integer)
        Dim move As Long
        Dim dx As Long, dy As Long

        If objlist(ob).dir = dt_nodir Then
            SelectDodgeDir ob
            If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
        End If

        move = objlist(ob).speed * tics

        Do While move
            '
            ' check for byte range
            '
            dx = objlist(player).x - objlist(ob).x
            If dx < 0 Then dx = -dx
            dx = dx - move
            If dx <= MINACTORDIST Then
                dy = objlist(player).y - objlist(ob).y
                If dy < 0 Then dy = -dy
                dy = dy - move
                If dy <= MINACTORDIST Then
                    NewState ob, s_dogjump1
                    Exit Sub
                End If
            End If

            If Not ReachedGoal(ob, move) Then Exit Do

            SelectDodgeDir ob

            If objlist(ob).dir = dt_nodir Then Exit Sub ' object is blocked in
        Loop
    End Sub

    '
    ' ============================================================================
    '                              PATH
    ' ============================================================================
    '

    '===============
    '=
    '= SelectPathDir
    '=
    '===============
    Sub SelectPathDir (ob As Integer)
        Dim spot As Long

        spot = (mapsegs(1, objlist(ob).tiley * 64 + objlist(ob).tilex) - ICONARROWS) And &HFFFF& ' unsigned

        If spot < 8 Then
            ' new direction
            objlist(ob).dir = spot
        End If

        objlist(ob).distance = TILEGLOBAL

        If Not TryWalk(ob) Then objlist(ob).dir = dt_nodir
    End Sub

    '===============
    '=
    '= T_Path
    '=
    '===============
    Sub T_Path (ob As Integer)
        Dim move As Long

        If SightPlayer(ob) Then Exit Sub

        If objlist(ob).dir = dt_nodir Then
            SelectPathDir ob
            If objlist(ob).dir = dt_nodir Then Exit Sub ' all movement is blocked
        End If

        move = objlist(ob).speed * tics

        Do While move
            If Not DoorOpenForActor(ob) Then Exit Sub

            If move < objlist(ob).distance Then
                MoveObj ob, move
                Exit Do
            End If

            If objlist(ob).tilex > MAPSIZE Or objlist(ob).tiley > MAPSIZE Then
                Quit "T_Path hit a wall at" + Str$(objlist(ob).tilex) + "," + Str$(objlist(ob).tiley) + ", dir" + Str$(objlist(ob).dir)
            End If

            objlist(ob).x = objlist(ob).tilex * TILEGLOBAL + TILEGLOBAL \ 2
            objlist(ob).y = objlist(ob).tiley * TILEGLOBAL + TILEGLOBAL \ 2
            move = move - objlist(ob).distance

            SelectPathDir ob

            If objlist(ob).dir = dt_nodir Then Exit Sub ' all movement is blocked
        Loop
    End Sub

    '
    ' =============================================================================
    '                              FIGHT
    ' =============================================================================
    '

    '===============
    '=
    '= T_Shoot
    '=
    '= Try to damage the player, based on skill level and player's speed
    '=
    '===============
    Sub T_Shoot (ob As Integer)
        Dim dx As Integer, dy As Integer, dist As Integer
        Dim hitchance As Integer, damage As Integer

        hitchance = 128

        If Not areabyplayer(objlist(ob).areanumber) Then Exit Sub

        If Not CheckLine(ob) Then Exit Sub ' player is behind a wall

        dx = Abs(objlist(ob).tilex - objlist(player).tilex)
        dy = Abs(objlist(ob).tiley - objlist(player).tiley)
        If dx > dy Then dist = dx Else dist = dy

        If objlist(ob).obclass = ssobj Or objlist(ob).obclass = bossobj Then dist = dist * 2 \ 3 ' ss are better shots

        If thrustspeed >= RUNSPEED Then
            If objlist(ob).flags And FL_VISABLE Then
                hitchance = 160 - dist * 16 ' player can see to dodge
            Else
                hitchance = 160 - dist * 8
            End If
        Else
            If objlist(ob).flags And FL_VISABLE Then
                hitchance = 256 - dist * 16 ' player can see to dodge
            Else
                hitchance = 256 - dist * 8
            End If
        End If

        ' see if the shot was a hit

        If US_RndT < hitchance Then
            If dist < 2 Then
                damage = US_RndT \ 4
            ElseIf dist < 4 Then
                damage = US_RndT \ 8
            Else
                damage = US_RndT \ 16
            End If

            TakeDamage damage, ob
        End If

        Select Case objlist(ob).obclass
            Case ssobj
                PlaySoundLocActor SSFIRESND, ob
            Case giftobj, fatobj, mechahitlerobj, realhitlerobj, bossobj, schabbobj, fakeobj
                T_ShootBossSound ob
            Case Else
                PlaySoundLocActor NAZIFIRESND, ob
        End Select
    End Sub

    ' The boss sounds of T_Shoot (#ifndef SPEAR; in Spear these classes use the default)
    Sub T_ShootBossSound (ob As Integer)
        $If SPEAR = UNDEFINED Then
            Select Case objlist(ob).obclass
                Case giftobj, fatobj
                    PlaySoundLocActor MISSILEFIRESND, ob
                Case mechahitlerobj, realhitlerobj, bossobj
                    PlaySoundLocActor BOSSFIRESND, ob
                Case schabbobj
                    PlaySoundLocActor SCHABBSTHROWSND, ob
                Case fakeobj
                    PlaySoundLocActor FLAMETHROWERSND, ob
            End Select
        $Else
            PlaySoundLocActor NAZIFIRESND, ob
        $End If
    End Sub

    '===============
    '=
    '= T_Bite
    '=
    '===============
    Sub T_Bite (ob As Integer)
        Dim dx As Long, dy As Long

        PlaySoundLocActor DOGATTACKSND, ob ' JAB

        dx = objlist(player).x - objlist(ob).x
        If dx < 0 Then dx = -dx
        dx = dx - TILEGLOBAL
        If dx <= MINACTORDIST Then
            dy = objlist(player).y - objlist(ob).y
            If dy < 0 Then dy = -dy
            dy = dy - TILEGLOBAL
            If dy <= MINACTORDIST Then
                If US_RndT < 180 Then
                    TakeDamage US_RndT \ 16, ob
                    Exit Sub
                End If
            End If
        End If
    End Sub

