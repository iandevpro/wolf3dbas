' ID_IN.C - Input Manager
' The original read the keyboard, mouse and joystick from its own interrupt handlers.
' Here INL_KeyService runs from ON TIMER (it fires between statements, so busy-wait loops
' like "while (Keyboard[sc_Y]);" keep working) and turns QB64 _KeyHit codes into scan codes.
' The joysticks are QB64 game controllers (_DEVICES), see INL_JoyService.

$If INCLUDE_ID_IN_BM = UNDEFINED Then
    $Let INCLUDE_ID_IN_BM = 1

    '$INCLUDE: 'ID_IN.BI'

    ' Maps a QB64 _KeyHit code (press or release, sign removed) to a PC scan code, 0 = unknown
    Function INL_KeyHitToScan% (code As Long)
        Dim c As Long, digit As Long

        c = Abs(code)
        Select Case c
            Case 8: INL_KeyHitToScan% = sc_BackSpace
            Case 9: INL_KeyHitToScan% = sc_Tab
            Case 13: INL_KeyHitToScan% = sc_Return
            Case 27: INL_KeyHitToScan% = sc_Escape
            Case 32: INL_KeyHitToScan% = sc_Space
            Case 33 To 126
                ' US layout, shifted and unshifted characters share the scan code
                digit = InStr("1!2@3#4$5%6^7&8*9(0)-_=+", Chr$(c))
                If digit Then
                    INL_KeyHitToScan% = (digit + 1) \ 2 + 1 ' sc_1 = 2 ... sc_0 = &H0B, - = &H0C, = = &H0D
                    Exit Function
                End If
                Select Case UCase$(Chr$(c))
                    Case "Q": INL_KeyHitToScan% = sc_Q
                    Case "W": INL_KeyHitToScan% = sc_W
                    Case "E": INL_KeyHitToScan% = sc_E
                    Case "R": INL_KeyHitToScan% = sc_R
                    Case "T": INL_KeyHitToScan% = sc_T
                    Case "Y": INL_KeyHitToScan% = sc_Y
                    Case "U": INL_KeyHitToScan% = sc_U
                    Case "I": INL_KeyHitToScan% = sc_I
                    Case "O": INL_KeyHitToScan% = sc_O
                    Case "P": INL_KeyHitToScan% = sc_P
                    Case "[", "{": INL_KeyHitToScan% = &H1A
                    Case "]", "}": INL_KeyHitToScan% = &H1B
                    Case "A": INL_KeyHitToScan% = sc_A
                    Case "S": INL_KeyHitToScan% = sc_S
                    Case "D": INL_KeyHitToScan% = sc_D
                    Case "F": INL_KeyHitToScan% = sc_F
                    Case "G": INL_KeyHitToScan% = sc_G
                    Case "H": INL_KeyHitToScan% = sc_H
                    Case "J": INL_KeyHitToScan% = sc_J
                    Case "K": INL_KeyHitToScan% = sc_K
                    Case "L": INL_KeyHitToScan% = sc_L
                    Case ";", ":": INL_KeyHitToScan% = &H27
                    Case "'", Chr$(34): INL_KeyHitToScan% = &H28
                    Case "`", "~": INL_KeyHitToScan% = &H29
                    Case "\", "|": INL_KeyHitToScan% = &H2B
                    Case "Z": INL_KeyHitToScan% = sc_Z
                    Case "X": INL_KeyHitToScan% = sc_X
                    Case "C": INL_KeyHitToScan% = sc_C
                    Case "V": INL_KeyHitToScan% = sc_V
                    Case "B": INL_KeyHitToScan% = sc_B
                    Case "N": INL_KeyHitToScan% = sc_N
                    Case "M": INL_KeyHitToScan% = sc_M
                    Case ",", "<": INL_KeyHitToScan% = &H33
                    Case ".", ">": INL_KeyHitToScan% = &H34
                    Case "/", "?": INL_KeyHitToScan% = &H35
                End Select
            Case 15104 To 21248 ' F1-F10, Home, arrows, PgUp/PgDn, End, Ins, Del: scan code * 256
                INL_KeyHitToScan% = c \ 256
            Case 34048: INL_KeyHitToScan% = sc_F11
            Case 34304: INL_KeyHitToScan% = sc_F12
            Case 100303: INL_KeyHitToScan% = sc_RShift
            Case 100304: INL_KeyHitToScan% = sc_LShift
            Case 100305, 100306: INL_KeyHitToScan% = sc_Control
            Case 100307, 100308: INL_KeyHitToScan% = sc_Alt
            Case 100301: INL_KeyHitToScan% = sc_CapsLock
            Case 100300: INL_KeyHitToScan% = &H45 ' NumLock
            Case 100302: INL_KeyHitToScan% = &H46 ' ScrollLock
        End Select
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  INL_KeyService() - Handles a keyboard interrupt (key up/down)
    '//
    '///////////////////////////////////////////////////////////////////////////
    ' A release that arrives in the same call as its press is held back until the key was
    ' down for INL_MINHOLD seconds, so even a very short tap is seen by code polling Keyboard()
    Sub INL_KeyService ()
        Const INL_MINHOLD = 0.05
        Dim k As Long
        Dim scan As Integer
        Dim pressed(0 To 127) As Integer
        Dim now As Double

        now = Timer(.001)
        For scan = 0 To 127
            If inDeferredRelease(scan) Then
                If now - inPressTime(scan) >= INL_MINHOLD Or now < inPressTime(scan) Then
                    Keyboard(scan) = FALSE
                    inDeferredRelease(scan) = FALSE
                End If
            End If
        Next scan

        Do
            k = _KeyHit
            If k = 0 Then Exit Do
            scan = INL_KeyHitToScan%(k)
            If scan <> 0 Then
                If k > 0 Then
                    Keyboard(scan) = TRUE
                    pressed(scan) = TRUE
                    inPressTime(scan) = now
                    inDeferredRelease(scan) = FALSE
                    LastScan = scan
                    If k = 8 Or k = 9 Or k = 13 Or k = 27 Or (k >= 32 And k <= 126) Then LastASCII = k
                    ' queue the press, a full queue drops it
                    If (inQueueTail + 1) Mod IN_KEYQUEUESIZE <> inQueueHead Then
                        inQueueScan(inQueueTail) = scan
                        If k = 8 Or k = 9 Or k = 13 Or k = 27 Or (k >= 32 And k <= 126) Then inQueueASCII(inQueueTail) = k Else inQueueASCII(inQueueTail) = 0
                        inQueueTail = (inQueueTail + 1) Mod IN_KEYQUEUESIZE
                    End If
                ElseIf pressed(scan) Then
                    inDeferredRelease(scan) = TRUE
                Else
                    Keyboard(scan) = FALSE
                End If
            End If
        Loop
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  The joysticks. The original read the game port (0x201): the stick
    '//  position as timing counts, and the buttons in the high bits. Here a
    '//  joystick is a QB64 game controller (_DEVICES): its first two axes are the
    '//  stick, its buttons 1-4 the buttons.
    '//
    '///////////////////////////////////////////////////////////////////////////

    ' Reads the waiting input of the joystick's controller into inJoyAxisX/Y and
    ' inJoyButton (the axes and buttons of a controller are read after _DeviceInput)
    Sub INL_JoyService (joy As Integer)
        Dim dev As Integer, b As Integer

        dev = inJoyDevice(joy)
        If dev = 0 Then Exit Sub
        Do While _DeviceInput(dev)
            If _LastAxis(dev) >= 2 Then
                inJoyAxisX(joy) = _Axis(1)
                inJoyAxisY(joy) = _Axis(2)
            End If
            For b = 1 To 4
                If b <= _LastButton(dev) Then inJoyButton(joy, b) = _Button(b)
            Next b
        Loop
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_GetJoyAbs() - Reads the absolute position of the specified joystick
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub IN_GetJoyAbs (joy As Integer, xp As Long, yp As Long)
        INL_JoyService joy
        If inJoyDevice(joy) = 0 Then xp = 0: yp = 0: Exit Sub ' (nothing on the port)
        xp = CLng((inJoyAxisX(joy) + 1) * JOYCOUNTS / 2)
        yp = CLng((inJoyAxisY(joy) + 1) * JOYCOUNTS / 2)
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  INL_GetJoyDelta() - Returns the relative movement of the specified
    '//      joystick (from +/-127)
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub INL_GetJoyDelta (joy As Integer, dx As Integer, dy As Integer)
        Dim x As Long, y As Long

        IN_GetJoyAbs joy, x, y

        If x < JoyDefs(joy).threshMinX Then
            If x < JoyDefs(joy).joyMinX Then x = JoyDefs(joy).joyMinX

            x = -(x - JoyDefs(joy).threshMinX)
            x = x * JoyDefs(joy).joyMultXL
            x = x \ (2 ^ JoyScaleShift)
            If x > 127 Then dx = -127 Else dx = -x
        ElseIf x > JoyDefs(joy).threshMaxX Then
            If x > JoyDefs(joy).joyMaxX Then x = JoyDefs(joy).joyMaxX

            x = x - JoyDefs(joy).threshMaxX
            x = x * JoyDefs(joy).joyMultXH
            x = x \ (2 ^ JoyScaleShift)
            If x > 127 Then dx = 127 Else dx = x
        Else
            dx = 0
        End If

        If y < JoyDefs(joy).threshMinY Then
            If y < JoyDefs(joy).joyMinY Then y = JoyDefs(joy).joyMinY

            y = -(y - JoyDefs(joy).threshMinY)
            y = y * JoyDefs(joy).joyMultYL
            y = y \ (2 ^ JoyScaleShift)
            If y > 127 Then dy = -127 Else dy = -y
        ElseIf y > JoyDefs(joy).threshMaxY Then
            If y > JoyDefs(joy).joyMaxY Then y = JoyDefs(joy).joyMaxY

            y = y - JoyDefs(joy).threshMaxY
            y = y * JoyDefs(joy).joyMultYH
            y = y \ (2 ^ JoyScaleShift)
            If y > 127 Then dy = 127 Else dy = y
        Else
            dy = 0
        End If
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  INL_GetJoyButtons() - Returns the button status of the specified
    '//      joystick (bits 0-1)
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function INL_GetJoyButtons% (joy As Integer)
        Dim result As Integer

        INL_JoyService joy
        If inJoyButton(joy, 1) Then result = result Or 1
        If inJoyButton(joy, 2) Then result = result Or 2
        INL_GetJoyButtons% = result
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_GetJoyButtonsDB() - Returns the de-bounced button status of the
    '//      specified joystick
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function IN_GetJoyButtonsDB% (joy As Integer)
        Dim lasttime As Long, result1 As Integer, result2 As Integer

        Do
            result1 = INL_GetJoyButtons(joy)
            lasttime = TimeCount
            Do While TimeCount = lasttime
                _Limit 1000
            Loop
            result2 = INL_GetJoyButtons(joy)
        Loop While result1 <> result2
        IN_GetJoyButtonsDB% = result1
    End Function

    '===================
    '=
    '= IN_JoyButtons
    '=
    '= The four button lines of the game port, 1 = pressed: bits 0-1 the buttons
    '= of joystick 1, bits 2-3 those of joystick 2. The Gravis GamePad used all
    '= four lines, so buttons 3-4 of the first controller are bits 2-3 too
    '=
    '===================
    Function IN_JoyButtons% ()
        Dim joybits As Integer

        INL_JoyService 0
        INL_JoyService 1
        If inJoyButton(0, 1) Then joybits = joybits Or 1
        If inJoyButton(0, 2) Then joybits = joybits Or 2
        If inJoyButton(1, 1) Or inJoyButton(0, 3) Then joybits = joybits Or 4
        If inJoyButton(1, 2) Or inJoyButton(0, 4) Then joybits = joybits Or 8
        IN_JoyButtons% = joybits
    End Function

    ' INL_SetJoyScale() - Sets up scaling values for the specified joystick
    Sub INL_SetJoyScale (joy As Integer)
        JoyDefs(joy).joyMultXL = JoyScaleMax \ (JoyDefs(joy).threshMinX - JoyDefs(joy).joyMinX)
        JoyDefs(joy).joyMultXH = JoyScaleMax \ (JoyDefs(joy).joyMaxX - JoyDefs(joy).threshMaxX)
        JoyDefs(joy).joyMultYL = JoyScaleMax \ (JoyDefs(joy).threshMinY - JoyDefs(joy).joyMinY)
        JoyDefs(joy).joyMultYH = JoyScaleMax \ (JoyDefs(joy).joyMaxY - JoyDefs(joy).threshMaxY)
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_SetupJoy() - Sets up thresholding values and calls INL_SetJoyScale()
    '//      to set up scaling values
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub IN_SetupJoy (joy As Integer, minx As Long, maxx As Long, miny As Long, maxy As Long)
        Dim d As Long, r As Long

        JoyDefs(joy).joyMinX = minx
        JoyDefs(joy).joyMaxX = maxx
        r = maxx - minx
        d = r \ 3
        JoyDefs(joy).threshMinX = ((r \ 2) - d) + minx
        JoyDefs(joy).threshMaxX = ((r \ 2) + d) + minx

        JoyDefs(joy).joyMinY = miny
        JoyDefs(joy).joyMaxY = maxy
        r = maxy - miny
        d = r \ 3
        JoyDefs(joy).threshMinY = ((r \ 2) - d) + miny
        JoyDefs(joy).threshMaxY = ((r \ 2) + d) + miny

        INL_SetJoyScale joy
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  INL_StartJoy() - Detects & auto-configures the specified joystick
    '//      The auto-config assumes the joystick is centered
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function INL_StartJoy% (joy As Integer)
        Dim x As Long, y As Long, i As Integer, n As Integer

        ' the joy-th game controller
        inJoyDevice(joy) = 0
        For i = 1 To _Devices
            If InStr(_Device$(i), "[CONTROLLER]") Then
                If n = joy Then inJoyDevice(joy) = i: Exit For
                n = n + 1
            End If
        Next i

        IN_GetJoyAbs joy, x, y

        If x = 0 Or x > MaxJoyValue - 10 Or y = 0 Or y > MaxJoyValue - 10 Then
            INL_StartJoy% = FALSE
        Else
            IN_SetupJoy joy, 0, x * 2, 0, y * 2
            INL_StartJoy% = TRUE
        End If
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_Startup() - Starts up the Input Mgr
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub IN_Startup ()
        Dim i As Integer
        If inTimer <> 0 Then Exit Sub

        ' KbdDefs = {0x1d,0x38,0x47,0x48,0x49,0x4b,0x4d,0x4f,0x50,0x51}
        KbdDefs.button0 = sc_Control
        KbdDefs.button1 = sc_Alt
        KbdDefs.upleft = sc_Home
        KbdDefs.up = sc_UpArrow
        KbdDefs.upright = sc_PgUp
        KbdDefs.left = sc_LeftArrow
        KbdDefs.right = sc_RightArrow
        KbdDefs.downleft = sc_End
        KbdDefs.down = sc_DownArrow
        KbdDefs.downright = sc_PgDn

        MousePresent = TRUE
        mouseenabled = 1 ' 0/1 like the C boolean, CP_Control toggles it with Xor 1 (ReadConfig sets it)
        joystickenabled = 0

        ' (C: the "nojoys" parameter skips the joysticks)
        For i = 0 To MaxJoys - 1
            If MS_CheckParm("nojoys") Then JoysPresent(i) = FALSE Else JoysPresent(i) = INL_StartJoy(i)
        Next i
        ' Mouse(MReset): the cursor goes to the middle, hidden (the game draws no mouse pointer)
        inMouseX = 320: inMouseY = 200
        _MouseHide

        IN_ClearKeysDown
        inTimer = _FreeTimer
        On Timer(inTimer, 0.01) INL_KeyService
        Timer(inTimer) On
    End Sub

    Sub IN_Shutdown ()
        If inTimer = 0 Then Exit Sub
        Timer(inTimer) Free
        inTimer = 0
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_ClearKeysDown() - Clears the keyboard array
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub IN_ClearKeysDown ()
        Dim i As Integer

        Do While _KeyHit
        Loop
        Do While InKey$ <> ""
        Loop
        INL_MouseService
        LastScan = sc_None
        LastASCII = 0
        For i = 0 To 127
            Keyboard(i) = FALSE
            inDeferredRelease(i) = FALSE
        Next i
        inQueueHead = inQueueTail
    End Sub

    ' Takes the oldest queued key press, returns FALSE when there is none
    Function IN_GetKeyPress% (scan As Integer, ascii As Integer)
        INL_KeyService
        If inQueueHead = inQueueTail Then
            IN_GetKeyPress% = FALSE
            Exit Function
        End If
        scan = inQueueScan(inQueueHead)
        ascii = inQueueASCII(inQueueHead)
        inQueueHead = (inQueueHead + 1) Mod IN_KEYQUEUESIZE
        IN_GetKeyPress% = TRUE
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_MouseButtons() - Gets the status of the mouse buttons (bit 0 left, bit 1 right)
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function IN_MouseButtons% ()
        Dim buttons As Integer

        INL_MouseService
        If _MouseButton(1) Then buttons = buttons Or 1
        If _MouseButton(2) Then buttons = buttons Or 2
        If _MouseButton(3) Then buttons = buttons Or 4
        IN_MouseButtons% = buttons
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  INL_MouseService() - Reads the waiting mouse messages: their motion goes
    '//      to the counters of the DOS mouse driver (see ID_IN.BI). Everything that
    '//      reads _MouseInput goes through here, so no motion is lost
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub INL_MouseService ()
        Dim dx As Long, dy As Long

        Do While _MouseInput
            dx = _MouseMovementX
            dy = _MouseMovementY
            inMouseDX = inMouseDX + dx
            inMouseDY = inMouseDY + dy
            inMouseX = inMouseX + dx
            inMouseY = inMouseY + dy
        Loop
        If inMouseX < 0 Then inMouseX = 0
        If inMouseX > 639 Then inMouseX = 639
        If inMouseY < 0 Then inMouseY = 0
        If inMouseY > 399 Then inMouseY = 399
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  INL_GetMouseDelta() - Gets the amount that the mouse has moved from the
    '//      mouse driver (Mouse(MDelta): the motion since the last call)
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub INL_GetMouseDelta (x As Long, y As Long)
        INL_MouseService
        x = inMouseDX
        y = inMouseDY
        inMouseDX = 0
        inMouseDY = 0
        ' The DOS game had the mouse to itself. Here the pointer is kept in the middle
        ' of the window while the game reads the motion, so a click can't land outside
        ' and take the focus away (the motion counts don't change with _MouseMove)
        If _WindowHasFocus Then _MouseMove 160, 100
    End Sub

    ' Mouse(MDelta) with the result thrown away: "Clear accumulated mouse movement"
    Sub IN_ClearMouseDelta ()
        Dim x As Long, y As Long

        INL_GetMouseDelta x, y
    End Sub

    ' Mouse(3): the position of the virtual cursor (_CX, _DX)
    Sub IN_GetMousePos (x As Integer, y As Integer)
        INL_MouseService
        x = inMouseX
        y = inMouseY \ 2
    End Sub

    ' Mouse(4): moves the virtual cursor (_CX = x, _DX = y)
    Sub IN_SetMousePos (x As Integer, y As Integer)
        inMouseX = x
        inMouseY = y * 2
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_ReadControl() - Reads the device associated with the specified
    '//      player and fills in the control info struct
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub IN_ReadControl (player As Integer, info As ControlInfo)
        Dim buttons As Integer
        Dim mx As Integer, my As Integer

        INL_KeyService
        mx = motion_None
        my = motion_None

        ' TODO: demo playback / recording, joystick and mouse control types
        If Keyboard(KbdDefs.upleft) Then
            mx = motion_Left: my = motion_Up
        ElseIf Keyboard(KbdDefs.upright) Then
            mx = motion_Right: my = motion_Up
        ElseIf Keyboard(KbdDefs.downleft) Then
            mx = motion_Left: my = motion_Down
        ElseIf Keyboard(KbdDefs.downright) Then
            mx = motion_Right: my = motion_Down
        End If

        If Keyboard(KbdDefs.up) Then
            my = motion_Up
        ElseIf Keyboard(KbdDefs.down) Then
            my = motion_Down
        End If

        If Keyboard(KbdDefs.left) Then
            mx = motion_Left
        ElseIf Keyboard(KbdDefs.right) Then
            mx = motion_Right
        End If

        If Keyboard(KbdDefs.button0) Then buttons = buttons + 1
        If Keyboard(KbdDefs.button1) Then buttons = buttons + 2

        info.x = mx * 127
        info.xaxis = mx
        info.y = my * 127
        info.yaxis = my
        info.button0 = (buttons And 1) <> 0
        info.button1 = (buttons And 2) <> 0
        info.button2 = (buttons And 4) <> 0
        info.button3 = (buttons And 8) <> 0
        ' DirTable[((my + 1) * 3) + (mx + 1)]
        Select Case (my + 1) * 3 + (mx + 1)
            Case 0: info.dir = dir_NorthWest
            Case 1: info.dir = dir_North
            Case 2: info.dir = dir_NorthEast
            Case 3: info.dir = dir_West
            Case 4: info.dir = dir_None
            Case 5: info.dir = dir_East
            Case 6: info.dir = dir_SouthWest
            Case 7: info.dir = dir_South
            Case 8: info.dir = dir_SouthEast
        End Select
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_StartAck() - Clears the keys, remembers the buttons held down
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub IN_StartAck ()
        IN_ClearKeysDown
        inAckButtons = IN_MouseButtons%
        inAckJoyButtons = IN_JoyButtons%
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  IN_CheckAck() - true when a key or a mouse button (not held at IN_StartAck) was pressed
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function IN_CheckAck% ()
        Dim buttons As Integer

        INL_KeyService
        IN_CheckAck% = FALSE
        If LastScan Then IN_CheckAck% = TRUE: Exit Function

        buttons = IN_MouseButtons%
        If buttons And Not inAckButtons Then IN_CheckAck% = TRUE: Exit Function
        inAckButtons = inAckButtons And buttons ' released buttons count again

        buttons = IN_JoyButtons%
        If buttons And Not inAckJoyButtons Then IN_CheckAck% = TRUE: Exit Function
        inAckJoyButtons = inAckJoyButtons And buttons
    End Function

    ' IN_Ack - waits for a key or mouse button press
    Sub IN_Ack ()
        IN_StartAck
        Do
            _Limit TickBase
        Loop Until IN_CheckAck%
    End Sub

    '===================
    '=
    '= IN_UserInput
    '=
    '= Waits for the specified delay time (in ticks, TickBase per second)
    '= or the user pressing a key or a mouse button
    '=
    '===================
    Function IN_UserInput% (delay As Long)
        Dim lasttime As Double, elapsed As Double

        IN_UserInput% = FALSE
        lasttime = Timer(.001)
        IN_StartAck
        Do
            _Limit TickBase
            If IN_CheckAck% Then IN_UserInput% = TRUE: Exit Function
            elapsed = Timer(.001) - lasttime
            If elapsed < 0 Then elapsed = elapsed + 86400 ' Timer wraps at midnight
        Loop While elapsed * TickBase < delay
    End Function

$End If
