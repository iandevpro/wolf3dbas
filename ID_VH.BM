' ID_VH.H - #define VW_FadeOut()    VL_FadeOut(0,255,0,0,0,30);
$If INCLUDE_ID_VH_BM = UNDEFINED Then
    $Let INCLUDE_ID_VH_BM = 1

    Sub VW_FadeOut
        VL_FadeOut 0, 255, 0, 0, 0, 30
    End Sub

    ' Function to fill a rectangle with specified dimensions and color
