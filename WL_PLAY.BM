' WL_PLAY.C - play loop, object list, music

$If INCLUDE_WL_PLAY_BM = UNDEFINED Then
    $Let INCLUDE_WL_PLAY_BM = 1

    '$INCLUDE: 'WL_PLAY.BI'

    '=========================
    '=
    '= InitActorList
    '=
    '= Call to clear out the actor object lists returning them all to the free
    '= list.  Allocates a special spot for the player.
    '=
    '=========================
    Sub InitActorList ()
        Dim i As Integer

        '
        ' init the actor lists
        '
        For i = 0 To MAXACTORS - 1
            objlist(i).prevobj = i + 1
            objlist(i).nextobj = -1
        Next i

        objlist(MAXACTORS - 1).prevobj = -1

        objfreelist = 0
        lastobj = -1

        objcount = 0

        '
        ' give the player the first free spots
        '
        GetNewActor
        player = newobj
    End Sub

    '=========================
    '=
    '= GetNewActor
    '=
    '= Sets the global variable new to point to a free spot in objlist.
    '= The free spot is inserted at the end of the liked list
    '=
    '= When the object list is full, the caller can either have it bomb out ot
    '= return a dummy object pointer that will never get used
    '=
    '=========================
    Sub GetNewActor ()
        Dim empty As objtype

        If objfreelist = -1 Then Quit "GetNewActor: No free spots in objlist!"

        newobj = objfreelist
        objfreelist = objlist(newobj).prevobj
        objlist(newobj) = empty ' memset (new,0,sizeof(*new))
        objlist(newobj).nextobj = -1
        objlist(newobj).state = 0 ' NULL

        If lastobj <> -1 Then objlist(lastobj).nextobj = newobj
        objlist(newobj).prevobj = lastobj ' new->next is allready NULL from memset

        objlist(newobj).active = ac_no
        lastobj = newobj

        objcount = objcount + 1
    End Sub

    '=========================
    '=
    '= RemoveObj
    '=
    '= Add the given object back into the free list, and unlink it from it's
    '= neighbors
    '=
    '=========================
    Sub RemoveObj (gone As Integer)
        If gone = player Then Quit "RemoveObj: Tried to remove the player!"

        objlist(gone).state = 0 ' NULL

        '
        ' fix the next object's back link
        '
        If gone = lastobj Then
            lastobj = objlist(gone).prevobj
        Else
            objlist(objlist(gone).nextobj).prevobj = objlist(gone).prevobj
        End If

        '
        ' fix the previous object's forward link
        '
        objlist(objlist(gone).prevobj).nextobj = objlist(gone).nextobj

        '
        ' add it back in to the free list
        '
        objlist(gone).prevobj = objfreelist
        objfreelist = gone

        objcount = objcount - 1
    End Sub

    '
    ' =============================================================================
    '                        MUSIC STUFF
    ' =============================================================================
    '

    '=================
    '=
    '= StopMusic
    '=
    '=================
    Sub StopMusic ()
        SD_MusicOff
        ' the music chunks stay cached (the original made them purgable)
    End Sub

    '=================
    '=
    '= StartMusic
    '=
    '=================
    ' StartMusic in WL_PLAY.C, renamed: QB64 names are case insensitive and the STARTMUSIC
    ' audio chunk constant exists
    Sub StartLevelMusic ()
        Dim chunk As Integer

        SD_MusicOff
        chunk = songs(gamestate.mapon + gamestate.episode * 10)

        ' if ((chunk == -1) || (MusicMode != smm_AdLib))
        ' DEBUG control panel return;

        CA_CacheAudioChunk STARTMUSIC + chunk
        If audiosegs(STARTMUSIC + chunk) <> 0 Then SD_StartMusic audiosegMem(STARTMUSIC + chunk)
    End Sub

    '
    ' =============================================================================
    '                          USER CONTROL
    ' =============================================================================
    '

    '===================
    '=
    '= PollKeyboardButtons
    '=
    '===================
    Sub PollKeyboardButtons ()
        Dim i As Integer

        For i = 0 To NUMBUTTONS - 1
            If Keyboard(buttonscan(i)) Then buttonstate(i) = TRUE
        Next i
    End Sub

    '===================
    '=
    '= PollMouseButtons
    '=
    '===================
    Sub PollMouseButtons ()
        Dim buttons As Integer

        buttons = IN_MouseButtons

        If buttons And 1 Then If buttonmouse(0) <> bt_nobutton Then buttonstate(buttonmouse(0)) = TRUE
        If buttons And 2 Then If buttonmouse(1) <> bt_nobutton Then buttonstate(buttonmouse(1)) = TRUE
        If buttons And 4 Then If buttonmouse(2) <> bt_nobutton Then buttonstate(buttonmouse(2)) = TRUE
    End Sub

    '===================
    '=
    '= PollKeyboardMove
    '=
    '===================
    Sub PollKeyboardMove ()
        If buttonstate(bt_run) Then
            If Keyboard(dirscan(di_north)) Then controly = controly - RUNMOVE * tics
            If Keyboard(dirscan(di_south)) Then controly = controly + RUNMOVE * tics
            If Keyboard(dirscan(di_west)) Then controlx = controlx - RUNMOVE * tics
            If Keyboard(dirscan(di_east)) Then controlx = controlx + RUNMOVE * tics
        Else
            If Keyboard(dirscan(di_north)) Then controly = controly - BASEMOVE * tics
            If Keyboard(dirscan(di_south)) Then controly = controly + BASEMOVE * tics
            If Keyboard(dirscan(di_west)) Then controlx = controlx - BASEMOVE * tics
            If Keyboard(dirscan(di_east)) Then controlx = controlx + BASEMOVE * tics
        End If
    End Sub

    '===================
    '=
    '= PollControls
    '=
    '= Gets user or demo input, call once each frame
    '=
    '= controlx      set between -100 and 100 per tic
    '= controly
    '= buttonheld[]  the state of the buttons LAST frame
    '= buttonstate[] the state of the buttons THIS frame
    '=
    '===================
    Sub PollControls ()
        Dim maxv As Integer, minv As Integer, i As Integer

        '
        ' get timing info for last frame
        '
        ' TODO 6j: demo playback / recording (DEMOTICS per frame)
        CalcTics

        controlx = 0
        controly = 0
        For i = 0 To NUMBUTTONS - 1
            buttonheld(i) = buttonstate(i) ' memcpy (buttonheld,buttonstate,sizeof(buttonstate))
            buttonstate(i) = FALSE ' memset (buttonstate,0,sizeof(buttonstate))
        Next i

        ' TODO 6j: read commands from demo buffer

        '
        ' get button states
        '
        INL_KeyService
        PollKeyboardButtons

        If mouseenabled Then PollMouseButtons

        ' TODO: joystick (PollJoystickButtons)

        '
        ' get movements
        '
        PollKeyboardMove

        ' TODO: mouse motion (PollMouseMove, Mouse(MDelta) mickeys), joystick (PollJoystickMove)

        '
        ' bound movement to a maximum
        '
        maxv = 100 * tics
        minv = -maxv
        If controlx > maxv Then
            controlx = maxv
        ElseIf controlx < minv Then
            controlx = minv
        End If

        If controly > maxv Then
            controly = maxv
        ElseIf controly < minv Then
            controly = minv
        End If

        ' TODO 6j: save info out to demo buffer (demorecord)
    End Sub

    '=====================
    '=
    '= CheckKeys
    '=
    '=====================
    Sub CheckKeys ()
        Dim scan As Integer

        If screenfaded Or demoplayback Then Exit Sub ' don't do anything with a faded screen

        scan = LastScan

        '
        ' SECRET CHEAT CODE: 'MLI'
        '
        If Keyboard(sc_M) And Keyboard(sc_L) And Keyboard(sc_I) Then
            gamestate.health = 100
            gamestate.ammo = 99
            gamestate.keys = 3
            gamestate.score = 0
            gamestate.TimeCount = gamestate.TimeCount + 42000
            GiveWeapon wp_chaingun

            DrawWeapon
            DrawHealth
            DrawKeys
            DrawAmmo
            DrawScore

            ClearMemory
            CA_CacheGrChunk STARTFONT + 1
            ClearSplitVWB
            ' VW_ScreenToScreen (displayofs,bufferofs,80,160) - one page here

            Message STR_CHEATER1 + Chr$(10) + STR_CHEATER2 + Chr$(10) + Chr$(10) + STR_CHEATER3 + Chr$(10) + STR_CHEATER4 + Chr$(10) + STR_CHEATER5

            UNCACHEGRCHUNK STARTFONT + 1
            IN_ClearKeysDown
            IN_Ack

            DrawAllPlayBorder
        End If

        '
        ' OPEN UP DEBUG KEYS
        '
        ' TODO: Backspace + LShift + Alt with the "goobers" parameter (DebugOk, WL_DEBUG.C)

        '
        ' TRYING THE KEEN CHEAT CODE!
        '
        If Keyboard(sc_B) And Keyboard(sc_A) And Keyboard(sc_T) Then
            ClearMemory
            CA_CacheGrChunk STARTFONT + 1
            ClearSplitVWB

            Message "Commander Keen is also" + Chr$(10) + "available from Apogee, but" + Chr$(10) + "then, you already know" + Chr$(10) + "that - right, Cheatmeister?!"

            UNCACHEGRCHUNK STARTFONT + 1
            IN_ClearKeysDown
            IN_Ack

            DrawAllPlayBorder
        End If

        '
        ' pause key weirdness can't be checked as a scan code
        '
        If Paused Then
            LatchDrawPic 20 - 4, 80 - 2 * 8, PAUSEDPIC
            VW_UpdateScreen
            SD_MusicOff
            IN_Ack
            IN_ClearKeysDown
            If MusicMode = smm_AdLib Then sqActive = 1 ' SD_MusicOn
            Paused = FALSE
            ' TODO: clear accumulated mouse movement
            Exit Sub
        End If

        '
        ' F1-F7/ESC to enter control panel
        '
        If scan = sc_F10 Or scan = sc_F9 Or scan = sc_F7 Or scan = sc_F8 Then ' pop up quit dialog
            ClearMemory
            ClearSplitVWB
            US_ControlPanel scan

            DrawAllPlayBorderSides

            If scan = sc_F9 Then StartLevelMusic

            SETFONTCOLOR 0, 15
            IN_ClearKeysDown
            Exit Sub
        End If

        If (scan >= sc_F1 And scan <= sc_F9) Or scan = sc_Escape Then
            StopMusic
            ClearMemory
            VW_FadeOut

            US_ControlPanel scan

            SETFONTCOLOR 0, 15
            IN_ClearKeysDown
            DrawPlayScreen
            If Not startgame And Not loadedgame Then
                VW_FadeIn
                StartLevelMusic
            End If
            If loadedgame Then playstate = ex_abort
            lasttimecount = TimeCount
            ' TODO: clear accumulated mouse movement
            Exit Sub
        End If

        '
        ' TAB-? debug keys
        '
        ' TODO: DebugKeys (WL_DEBUG.C)
    End Sub

    '
    ' =============================================================================
    '                          PALETTE SHIFTING STUFF
    ' =============================================================================
    '

    '=====================
    '=
    '= InitRedShifts
    '=
    '= The shifts are computed on the 6-bit VGA values like the original and stored
    '= scaled to 8-bit like gamepal()
    '=
    '=====================
    Sub InitRedShifts ()
        Dim i As Integer, j As Integer
        Dim r As Integer, g As Integer, b As Integer

        '
        ' fade through intermediate frames
        '
        For i = 1 To NUMREDSHIFTS
            For j = 0 To 255
                GamePal6 j, r, g, b
                redshifts(i - 1, j) = Pal8(r + (64 - r) * i \ REDSTEPS, g + (-g) * i \ REDSTEPS, b + (-b) * i \ REDSTEPS)
            Next j
        Next i

        For i = 1 To NUMWHITESHIFTS
            For j = 0 To 255
                GamePal6 j, r, g, b
                whiteshifts(i - 1, j) = Pal8(r + (64 - r) * i \ WHITESTEPS, g + (62 - g) * i \ WHITESTEPS, b + (0 - b) * i \ WHITESTEPS)
            Next j
        Next i
    End Sub

    ' The 6-bit VGA values of gamepal(j) (LoadGamePalette scaled them by 255 \ 63)
    Sub GamePal6 (j As Integer, r As Integer, g As Integer, b As Integer)
        r = (_Red32(gamepal(j)) * 63 + 127) \ 255
        g = (_Green32(gamepal(j)) * 63 + 127) \ 255
        b = (_Blue32(gamepal(j)) * 63 + 127) \ 255
    End Sub

    ' A 6-bit VGA color as an 8-bit palette value (the DAC uses the low 6 bits)
    Function Pal8~& (r As Integer, g As Integer, b As Integer)
        Pal8~& = _RGB32(((r And 63) * 255) \ 63, ((g And 63) * 255) \ 63, ((b And 63) * 255) \ 63)
    End Function

    '=====================
    '=
    '= ClearPaletteShifts
    '=
    '=====================
    Sub ClearPaletteShifts ()
        bonuscount = 0
        damagecount = 0
    End Sub

    '=====================
    '=
    '= StartBonusFlash
    '=
    '=====================
    Sub StartBonusFlash ()
        bonuscount = NUMWHITESHIFTS * WHITETICS ' white shift palette
    End Sub

    '=====================
    '=
    '= StartDamageFlash
    '=
    '=====================
    Sub StartDamageFlash (damage As Integer)
        damagecount = damagecount + damage
    End Sub

    '=====================
    '=
    '= UpdatePaletteShifts
    '=
    '= (VW_WaitVBL (1) before each change is left out: the change shows with the next
    '= frame's _Display anyway)
    '=
    '=====================
    Sub UpdatePaletteShifts ()
        Dim red As Integer, white As Integer, i As Integer

        If bonuscount Then
            white = bonuscount \ WHITETICS + 1
            If white > NUMWHITESHIFTS Then white = NUMWHITESHIFTS
            bonuscount = bonuscount - tics
            If bonuscount < 0 Then bonuscount = 0
        Else
            white = 0
        End If

        If damagecount Then
            red = damagecount \ 10 + 1
            If red > NUMREDSHIFTS Then red = NUMREDSHIFTS

            damagecount = damagecount - tics
            If damagecount < 0 Then damagecount = 0
        Else
            red = 0
        End If

        If red Then
            For i = 0 To 255 ' VL_SetPalette (redshifts[red-1])
                _PaletteColor i, redshifts(red - 1, i)
            Next i
            palshifted = TRUE
        ElseIf white Then
            For i = 0 To 255 ' VL_SetPalette (whiteshifts[white-1])
                _PaletteColor i, whiteshifts(white - 1, i)
            Next i
            palshifted = TRUE
        ElseIf palshifted Then
            For i = 0 To 255 ' VL_SetPalette (&gamepal) - back to normal
                _PaletteColor i, gamepal(i)
            Next i
            palshifted = FALSE
        End If
    End Sub

    '=====================
    '=
    '= FinishPaletteShifts
    '=
    '= Resets palette to normal if needed
    '=
    '=====================
    Sub FinishPaletteShifts ()
        If palshifted Then
            palshifted = 0
            VL_WaitVBL 1
            VL_SetPalette gamepal()
        End If
    End Sub

    '=========================
    '=
    '= DoActor
    '=
    '=========================
    Sub DoActor (ob As Integer)
        Dim think As Integer

        ' C && short-circuits: areabyplayer is only read for inactive actors (the player's area
        ' number is out of range inside a wall with noclip)
        If objlist(ob).active = ac_no Then If Not areabyplayer(objlist(ob).areanumber) Then Exit Sub

        If (objlist(ob).flags And (FL_NONMARK Or FL_NEVERMARK)) = 0 Then actorat(objlist(ob).tilex, objlist(ob).tiley) = 0

        '
        ' non transitional object
        '
        If objlist(ob).ticcount = 0 Then
            think = states(objlist(ob).state).think
            If think Then
                CallStateRoutine think, ob
                If objlist(ob).state = 0 Then
                    RemoveObj ob
                    Exit Sub
                End If
            End If

            If objlist(ob).flags And FL_NEVERMARK Then Exit Sub

            If (objlist(ob).flags And FL_NONMARK) <> 0 And actorat(objlist(ob).tilex, objlist(ob).tiley) <> 0 Then Exit Sub

            actorat(objlist(ob).tilex, objlist(ob).tiley) = OBJ_BASE + ob
            Exit Sub
        End If

        '
        ' transitional object
        '
        objlist(ob).ticcount = objlist(ob).ticcount - tics
        Do While objlist(ob).ticcount <= 0
            think = states(objlist(ob).state).action ' end of state action
            If think Then
                CallStateRoutine think, ob
                If objlist(ob).state = 0 Then
                    RemoveObj ob
                    Exit Sub
                End If
            End If

            objlist(ob).state = states(objlist(ob).state).nextstate

            If objlist(ob).state = 0 Then
                RemoveObj ob
                Exit Sub
            End If

            If states(objlist(ob).state).tictime = 0 Then
                objlist(ob).ticcount = 0
                Exit Do ' goto think
            End If

            objlist(ob).ticcount = objlist(ob).ticcount + states(objlist(ob).state).tictime
        Loop

        ' think:
        '
        ' think
        '
        think = states(objlist(ob).state).think
        If think Then
            CallStateRoutine think, ob
            If objlist(ob).state = 0 Then
                RemoveObj ob
                Exit Sub
            End If
        End If

        If objlist(ob).flags And FL_NEVERMARK Then Exit Sub

        If (objlist(ob).flags And FL_NONMARK) <> 0 And actorat(objlist(ob).tilex, objlist(ob).tiley) <> 0 Then Exit Sub

        actorat(objlist(ob).tilex, objlist(ob).tiley) = OBJ_BASE + ob
    End Sub

    '===================
    '=
    '= PlayLoop
    '=
    '===================
    Sub PlayLoop ()
        Dim i As Integer

        playstate = 0
        TimeCount = 0
        lasttimecount = 0
        frameon = 0
        running = FALSE
        anglefrac = 0
        facecount = 0
        funnyticount = 0
        For i = 0 To NUMBUTTONS - 1 ' memset (buttonstate,0,sizeof(buttonstate))
            buttonstate(i) = FALSE
        Next i
        ClearPaletteShifts
        ' TODO: clear accumulated mouse movement

        If demoplayback Then IN_StartAck

        Do
            PollControls

            '
            ' actor thinking
            '
            madenoise = FALSE

            ' TODO 6f: MoveDoors, MovePWalls

            obj = player
            Do While obj <> -1
                DoActor obj
                obj = objlist(obj).nextobj
            Loop

            UpdatePaletteShifts

            ThreeDRefresh

            gamestate.TimeCount = gamestate.TimeCount + tics

            ' SD_Poll - the audio pump runs on its own timer
            ' TODO 6i: UpdateSoundLoc

            If screenfaded Then VW_FadeIn

            CheckKeys

            ' TODO: debug aids (singlestep, extravbls)

            If demoplayback Then
                If IN_CheckAck Then
                    IN_ClearKeysDown
                    playstate = ex_abort
                End If
            End If
        Loop While playstate = 0 And Not startgame

        If playstate <> ex_died Then FinishPaletteShifts
    End Sub

$EndIf
