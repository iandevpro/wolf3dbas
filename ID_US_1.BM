' ID_US_1.C - User Manager - General routines
' Window/Printing routines.
' The original measured and drew through the function pointers USL_MeasureString and
' USL_DrawString (US_SetPrintRoutines). QB64 has no function pointers, and Wolf3D only uses
' VW_MeasurePropString / VWB_DrawPropString, so those are called directly.
' "\n" in the C strings is Chr$(10) here.

$If INCLUDE_ID_US_1_BM = UNDEFINED Then
    $Let INCLUDE_ID_US_1_BM = 1

    '$INCLUDE: 'ID_US.BI'

    ' US_InitRndT / US_RndT - the original used a 256 entry random table (ID_US_A.ASM).
    ' TODO: port rndtable for demo playback, which needs the exact sequence
    Sub US_InitRndT (doRandomize As Integer)
        If doRandomize Then Randomize Timer
    End Sub

    Function US_RndT% ()
        US_RndT% = Int(Rnd * 256)
    End Function

    ' Returns a C string kept in a fixed length String (e.g. HighScore.name) up to its zero terminator
    Function US_CString$ (s As String)
        Dim z As Long
        z = InStr(s, Chr$(0))
        If z Then US_CString$ = Left$(s, z - 1) Else US_CString$ = RTrim$(s)
    End Function

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  US_Print() - Prints a string in the current window. Newlines are
    '//      supported.
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub US_Print (s As String)
        Dim lineStart As Long, lineEnd As Long
        Dim w As Integer, h As Integer
        Dim part As String

        lineStart = 1
        Do While lineStart <= Len(s)
            lineEnd = InStr(lineStart, s, Chr$(10))
            If lineEnd = 0 Then
                part = Mid$(s, lineStart)
            Else
                part = Mid$(s, lineStart, lineEnd - lineStart)
            End If

            VW_MeasurePropString part, w, h
            px = PrintX
            py = PrintY
            VWB_DrawPropString part

            If lineEnd Then
                lineStart = lineEnd + 1
                PrintX = WindowX
                PrintY = PrintY + h
            Else
                lineStart = Len(s) + 1
                PrintX = PrintX + w
            End If
        Loop
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  US_PrintUnsigned() - Prints an unsigned long
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub US_PrintUnsigned (n As Long)
        US_Print LTrim$(Str$(n))
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  US_PrintSigned() - Prints a signed long
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub US_PrintSigned (n As Long)
        US_Print LTrim$(Str$(n))
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  USL_PrintInCenter() - Prints a string in the center of the given rect
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub USL_PrintInCenter (s As String, ulx As Integer, uly As Integer, lrx As Integer, lry As Integer)
        Dim w As Integer, h As Integer

        VW_MeasurePropString s, w, h
        px = ulx + ((lrx - ulx - w) \ 2)
        py = uly + ((lry - uly - h) \ 2)
        VWB_DrawPropString s
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  US_PrintCentered() - Prints a string centered in the current window.
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub US_PrintCentered (s As String)
        USL_PrintInCenter s, WindowX, WindowY, WindowX + WindowW, WindowY + WindowH
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  US_CPrintLine() - Prints a string centered on the current line and
    '//      advances to the next line. Newlines are not supported.
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub US_CPrintLine (s As String)
        Dim w As Integer, h As Integer

        VW_MeasurePropString s, w, h
        If w > WindowW Then
            Print "US_CPrintLine() - String exceeds width"
            End
        End If
        px = WindowX + ((WindowW - w) \ 2)
        py = PrintY
        VWB_DrawPropString s
        PrintY = PrintY + h
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  US_CPrint() - Prints a string in the current window. Newlines are
    '//      supported.
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub US_CPrint (s As String)
        Dim lineStart As Long, lineEnd As Long

        lineStart = 1
        Do While lineStart <= Len(s)
            lineEnd = InStr(lineStart, s, Chr$(10))
            If lineEnd = 0 Then
                US_CPrintLine Mid$(s, lineStart)
                lineStart = Len(s) + 1
            Else
                US_CPrintLine Mid$(s, lineStart, lineEnd - lineStart)
                lineStart = lineEnd + 1
            End If
        Loop
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  USL_XORICursor() - XORs the I-bar text cursor. Used by US_LineInput()
    '//
    '///////////////////////////////////////////////////////////////////////////
    Sub USL_XORICursor (x As Integer, y As Integer, s As String, cursor As Integer)
        Static status As Integer ' VGA doesn't XOR...
        Dim w As Integer, h As Integer, temp As Integer

        VW_MeasurePropString Left$(s, cursor), w, h

        px = x + w - 1
        py = y
        status = status Xor 1
        If status Then
            VWB_DrawPropString Chr$(&H80)
        Else
            temp = fontcolor
            fontcolor = backcolor
            VWB_DrawPropString Chr$(&H80)
            fontcolor = temp
        End If
    End Sub

    '///////////////////////////////////////////////////////////////////////////
    '//
    '//  US_LineInput() - Gets a line of user input at (x,y), the string defaults
    '//      to whatever is pointed at by def. Input is restricted to maxchars
    '//      chars or maxwidth pixels wide. If the user hits escape (and escok is
    '//      true), nothing is copied into buf, and false is returned. If the
    '//      user hits return, the current string is copied into buf, and true is
    '//      returned
    '//
    '///////////////////////////////////////////////////////////////////////////
    Function US_LineInput% (x As Integer, y As Integer, buf As String, defaultstr As String, escok As Integer, maxchars As Integer, maxwidth As Integer)
        Const MaxString = 128 ' Maximum input string size
        Dim redraw As Integer, cursorvis As Integer, cursormoved As Integer
        Dim done As Integer, result As Integer
        Dim sc As Integer, c As Integer
        Dim s As String, olds As String
        Dim cursor As Integer, w As Integer, h As Integer, lenS As Integer, temp As Integer
        Dim lasttime As Long

        s = defaultstr
        olds = ""
        cursor = Len(s)
        cursormoved = TRUE
        redraw = TRUE
        cursorvis = FALSE
        done = FALSE
        lasttime = TimeCount
        LastASCII = 0 ' key_None
        LastScan = sc_None
        inQueueHead = inQueueTail ' drop older key presses

        Do While Not done
            _Limit TickBase * 2 ' the original was a busy loop

            If cursorvis Then USL_XORICursor x, y, s, cursor

            ' The original read and cleared LastScan / LastASCII (with interrupts off).
            ' The key queue is used instead, so fast typing does not lose characters
            If IN_GetKeyPress(sc, c) = FALSE Then
                sc = sc_None
                c = 0
            End If
            LastScan = sc_None
            LastASCII = 0

            Select Case sc
                Case sc_LeftArrow
                    If cursor Then cursor = cursor - 1
                    c = 0
                    cursormoved = TRUE
                Case sc_RightArrow
                    If cursor < Len(s) Then cursor = cursor + 1
                    c = 0
                    cursormoved = TRUE
                Case sc_Home
                    cursor = 0
                    c = 0
                    cursormoved = TRUE
                Case sc_End
                    cursor = Len(s)
                    c = 0
                    cursormoved = TRUE

                Case sc_Return
                    buf = s
                    done = TRUE
                    result = TRUE
                    c = 0
                Case sc_Escape
                    If escok Then
                        done = TRUE
                        result = FALSE
                    End If
                    c = 0

                Case sc_BackSpace
                    If cursor Then
                        s = Left$(s, cursor - 1) + Mid$(s, cursor + 1)
                        cursor = cursor - 1
                        redraw = TRUE
                    End If
                    c = 0
                    cursormoved = TRUE
                Case sc_Delete
                    If cursor < Len(s) Then
                        s = Left$(s, cursor) + Mid$(s, cursor + 2)
                        redraw = TRUE
                    End If
                    c = 0
                    cursormoved = TRUE

                Case &H4C, sc_UpArrow, sc_DownArrow, sc_PgUp, sc_PgDn, sc_Insert ' &H4C = Keypad 5
                    c = 0
            End Select

            If c Then
                lenS = Len(s)
                VW_MeasurePropString s, w, h

                ' isprint(c)
                If c >= 32 And c <= 126 Then
                    If lenS < MaxString - 1 And (maxchars = 0 Or lenS < maxchars) And (maxwidth = 0 Or w < maxwidth) Then
                        s = Left$(s, cursor) + Chr$(c) + Mid$(s, cursor + 1)
                        cursor = cursor + 1
                        redraw = TRUE
                    End If
                End If
            End If

            If redraw Then
                px = x
                py = y
                temp = fontcolor
                fontcolor = backcolor
                VWB_DrawPropString olds
                fontcolor = temp
                olds = s

                px = x
                py = y
                VWB_DrawPropString s

                redraw = FALSE
            End If

            If cursormoved Then
                cursorvis = FALSE
                lasttime = TimeCount - TickBase

                cursormoved = FALSE
            End If
            If TimeCount - lasttime > TickBase \ 2 Then
                lasttime = TimeCount

                cursorvis = Not cursorvis
            End If
            If cursorvis Then USL_XORICursor x, y, s, cursor

            VW_UpdateScreen
        Loop

        If cursorvis Then USL_XORICursor x, y, s, cursor
        If Not result Then
            px = x
            py = y
            VWB_DrawPropString olds
        End If
        VW_UpdateScreen

        IN_ClearKeysDown
        US_LineInput% = result
    End Function

$EndIf
