' WL_SPR.BI - sprite numbers (enum in WL_DEF.H, sprite constants), Wolf3D build (SPEAR not defined)
' Generated from origsrc/WL_DEF.H
$If INCLUDE_WL_SPR_BI = UNDEFINED Then
    $Let INCLUDE_WL_SPR_BI = 1

    ' The v1.0 shareware data (VSWAP.WL1) has the sprites of this list in the same order,
    ' but without SPR_DEATHCAM, and without the 47 sprites before SPR_BJ_W1 (Giftmacher,
    ' rockets, Gretel, Fat Face: its empty slots for the bosses end one sprite after
    ' SPR_HITLER_DIE7). The sprites of the other episodes are empty pages in that file.
    ' So in v1.0 the sprites from SPR_STAT_0 on are one lower, those from SPR_BJ_W1 on
    ' 48 lower; SPR_DEATHCAM is not there (the death cam came with v1.1)
    $If APOGEE_1_0 = DEFINED Then
            Const SPRV10SHIFT1 = 1
            Const SPRV10SHIFT2 = 48
    $Else
        Const SPRV10SHIFT1 = 0
        Const SPRV10SHIFT2 = 0
    $End If

    Const SPR_DEMO = 0
    Const SPR_DEATHCAM = 1
    Const SPR_STAT_0 = 2 - SPRV10SHIFT1
